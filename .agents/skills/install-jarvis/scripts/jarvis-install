#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"
CONFIG_PATH="${REPO_ROOT}/conf/config.yaml"
SERVER_LABEL="com.bytedance.jarvis.server"
QDRANT_LABEL="com.bytedance.jarvis.qdrant"
SERVER_URL="http://127.0.0.1:18800"
QDRANT_URL="http://127.0.0.1:6333"

usage() {
  cat >&2 <<'EOF'
Usage: jarvis-install <doctor|install-qdrant|install-server|validate> [--config PATH]

doctor          Report machine, configuration, service, and data facts as JSON.
install-qdrant  Install the pinned macOS arm64 Qdrant service for this checkout.
install-server  Build and register Jarvis after configuration and Qdrant are ready.
validate        Verify configuration permissions and end-to-end service readiness.

The tool performs machine-owned checks and atomic actions only. The calling
Agent decides how to install missing dependencies, which Feishu app/profile to
use, and whether an existing Jarvis installation may be changed.
EOF
}

fail() {
  printf 'jarvis-install: %s\n' "$*" >&2
  exit 1
}

parse_common_flags() {
  while (( $# > 0 )); do
    case "$1" in
      --config)
        (( $# >= 2 )) || fail "--config requires a path"
        CONFIG_PATH="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        fail "unknown argument: $1"
        ;;
    esac
  done
  if [[ "$CONFIG_PATH" != /* ]]; then
    CONFIG_PATH="${REPO_ROOT}/${CONFIG_PATH}"
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

bool_json() {
  if "$@"; then
    printf 'true'
  else
    printf 'false'
  fi
}

semver_at_least() {
  local actual="$1"
  local required="$2"
  awk -v actual="$actual" -v required="$required" 'BEGIN {
    sub(/^[^0-9]*/, "", actual)
    sub(/^[^0-9]*/, "", required)
    split(actual, a, ".")
    split(required, r, ".")
    for (i = 1; i <= 3; i++) {
      av = (a[i] == "" ? 0 : a[i] + 0)
      rv = (r[i] == "" ? 0 : r[i] + 0)
      if (av > rv) exit 0
      if (av < rv) exit 1
    }
    exit 0
  }'
}

node_version_supported() {
  local actual="$1"
  local major minor
  actual="${actual#v}"
  major="${actual%%.*}"
  minor="${actual#*.}"
  minor="${minor%%.*}"
  case "$major" in
    20) (( minor >= 19 )) ;;
    21) return 1 ;;
    22) (( minor >= 12 )) ;;
    *) (( major >= 23 )) ;;
  esac
}

service_loaded() {
  launchctl print "gui/${UID}/$1" >/dev/null 2>&1
}

service_program() {
  local label="$1"
  local agent_plist="${HOME}/Library/LaunchAgents/${label}.plist"
  [[ -f "$agent_plist" ]] || return 1
  plutil -extract ProgramArguments.0 raw -o - "$agent_plist" 2>/dev/null
}

lark_skill_pack_path() {
  local candidate
  if [[ -n "${CODEX_HOME:-}" ]]; then
    candidate="${CODEX_HOME}/skills/lark-shared/SKILL.md"
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  for candidate in \
    "${HOME}/.agents/skills/lark-shared/SKILL.md" \
    "${HOME}/.codex/skills/lark-shared/SKILL.md"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

initialization_status() {
  (
    cd "$REPO_ROOT"
    go run ./cmd/jarvis-config initialization-status --config "$CONFIG_PATH"
  )
}

doctor() {
  require_command jq

  local missing=()
  local required_command
  for required_command in bash zsh curl git go node npm jq codesign security openssl plutil launchctl shasum tar install xcode-select; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
      missing+=("$required_command")
    fi
  done

  local required_path
  for required_path in \
    go.mod \
    web/package-lock.json \
    conf/config.yaml \
    scripts/install-qdrant.sh \
    scripts/install-launchd.sh \
    scripts/rebuild-server.sh \
    .agents/skills/install-jarvis/SKILL.md \
    .agents/skills/initialize-jarvis/SKILL.md; do
    if [[ ! -e "${REPO_ROOT}/${required_path}" ]]; then
      missing+=("$required_path")
    fi
  done

  local platform arch platform_supported
  platform="$(uname -s)"
  arch="$(uname -m)"
  platform_supported=false
  if [[ "$platform" == "Darwin" && "$arch" == "arm64" ]]; then
    platform_supported=true
  fi

  local required_go actual_go go_supported
  required_go="$(awk '$1 == "go" { print $2; exit }' "${REPO_ROOT}/go.mod")"
  actual_go=""
  go_supported=false
  if command -v go >/dev/null 2>&1; then
    actual_go="$(go env GOVERSION 2>/dev/null || true)"
    if [[ -n "$actual_go" ]] && semver_at_least "$actual_go" "$required_go"; then
      go_supported=true
    fi
  fi

  local actual_node node_supported
  actual_node=""
  node_supported=false
  if command -v node >/dev/null 2>&1; then
    actual_node="$(node --version 2>/dev/null || true)"
    if [[ -n "$actual_node" ]] && node_version_supported "$actual_node"; then
      node_supported=true
    fi
  fi

  local cgo_ready xcode_tools_ready c_compiler c_compiler_ready
  cgo_ready=false
  xcode_tools_ready=false
  c_compiler=""
  c_compiler_ready=false
  if command -v go >/dev/null 2>&1 && [[ "$(go env CGO_ENABLED 2>/dev/null || true)" == "1" ]]; then
    cgo_ready=true
  fi
  if command -v go >/dev/null 2>&1; then
    c_compiler="$(go env CC 2>/dev/null || true)"
    if [[ -n "$c_compiler" ]] && command -v "$c_compiler" >/dev/null 2>&1; then
      c_compiler_ready=true
    fi
  fi
  if command -v xcode-select >/dev/null 2>&1 && xcode-select -p >/dev/null 2>&1; then
    xcode_tools_ready=true
  fi

  local lark_skill_path lark_skill_pack_ready
  lark_skill_path=""
  lark_skill_pack_ready=false
  if lark_skill_path="$(lark_skill_pack_path)"; then
    lark_skill_pack_ready=true
  fi

  local config_status config_inspection_ok config_error
  config_status='null'
  config_inspection_ok=false
  config_error=""
  if command -v go >/dev/null 2>&1 && [[ -f "$CONFIG_PATH" ]]; then
    if config_status="$(initialization_status 2>&1)"; then
      config_inspection_ok=true
    else
      config_error="$config_status"
      config_status='null'
    fi
  else
    config_error="go or config file is missing"
  fi
  if [[ "$config_inspection_ok" == "true" ]]; then
    local runtime_binary
    while IFS= read -r runtime_binary; do
      if [[ -n "$runtime_binary" ]] && ! command -v "$runtime_binary" >/dev/null 2>&1; then
        missing+=("configured runtime binary: ${runtime_binary}")
      fi
    done < <(jq -r '.runtime_binaries[]?' <<<"$config_status")
  fi

  local qdrant_healthy server_healthy readiness_json
  qdrant_healthy="$(bool_json curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null)"
  server_healthy="$(bool_json curl -fsS --max-time 2 "${SERVER_URL}/healthz" -o /dev/null)"
  readiness_json='null'
  if [[ "$server_healthy" == "true" ]]; then
    readiness_json="$(curl -fsS --max-time 4 "${SERVER_URL}/readyz" 2>/dev/null || printf 'null')"
    if ! jq -e . >/dev/null 2>&1 <<<"$readiness_json"; then
      readiness_json='null'
    fi
  fi

  local server_loaded qdrant_loaded server_program_path qdrant_program_path server_belongs_to_checkout qdrant_belongs_to_checkout
  server_loaded="$(bool_json service_loaded "$SERVER_LABEL")"
  qdrant_loaded="$(bool_json service_loaded "$QDRANT_LABEL")"
  server_program_path="$(service_program "$SERVER_LABEL" 2>/dev/null || true)"
  qdrant_program_path="$(service_program "$QDRANT_LABEL" 2>/dev/null || true)"
  server_belongs_to_checkout=false
  qdrant_belongs_to_checkout=false
  case "$server_program_path" in
    "${REPO_ROOT}"/*) server_belongs_to_checkout=true ;;
  esac
  case "$qdrant_program_path" in
    "${REPO_ROOT}"/*) qdrant_belongs_to_checkout=true ;;
  esac

  local runtime_ignored git_dirty_count database_exists
  runtime_ignored=false
  git_dirty_count=0
  if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$REPO_ROOT" check-ignore -q conf/config.runtime.yaml; then
      runtime_ignored=true
    fi
    git_dirty_count="$(git -C "$REPO_ROOT" status --porcelain | wc -l | tr -d ' ')"
  fi
  database_exists="$(bool_json test -f "${REPO_ROOT}/var/jarvis.db")"

  local missing_json warnings_json machine_ready
  missing_json="$(printf '%s\n' "${missing[@]-}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
  warnings_json="$(jq -nc \
    --argjson tracked_key "$(jq -r '.tracked_model_api_key_present // false' <<<"$config_status")" \
    --arg base_mode "$(jq -r '.base_config_mode // ""' <<<"$config_status")" \
    '[if $tracked_key then "tracked conf/config.yaml contains a shared plaintext model API key" else empty end,
      if ($base_mode != "" and $base_mode != "0600") then "base config permissions are broader than 0600; install-server will restrict them" else empty end]')"

  machine_ready=true
  if (( ${#missing[@]} > 0 )) || [[ "$platform_supported" != "true" ]] || \
    [[ "$go_supported" != "true" ]] || [[ "$node_supported" != "true" ]] || \
    [[ "$cgo_ready" != "true" ]] || [[ "$c_compiler_ready" != "true" ]] || [[ "$xcode_tools_ready" != "true" ]] || \
    [[ "$config_inspection_ok" != "true" ]] || \
    [[ "$runtime_ignored" != "true" ]]; then
    machine_ready=false
  fi

  jq -nc \
    --arg repo_root "$REPO_ROOT" \
    --arg config_path "$CONFIG_PATH" \
    --arg platform "$platform" \
    --arg arch "$arch" \
    --arg required_go "$required_go" \
    --arg actual_go "$actual_go" \
    --arg actual_node "$actual_node" \
    --arg c_compiler "$c_compiler" \
    --arg lark_skill_path "$lark_skill_path" \
    --arg config_error "$config_error" \
    --arg server_program "$server_program_path" \
    --arg qdrant_program "$qdrant_program_path" \
    --argjson machine_ready "$machine_ready" \
    --argjson missing "$missing_json" \
    --argjson warnings "$warnings_json" \
    --argjson platform_supported "$platform_supported" \
    --argjson go_supported "$go_supported" \
    --argjson node_supported "$node_supported" \
    --argjson cgo_ready "$cgo_ready" \
    --argjson c_compiler_ready "$c_compiler_ready" \
    --argjson xcode_tools_ready "$xcode_tools_ready" \
    --argjson lark_skill_pack_ready "$lark_skill_pack_ready" \
    --argjson config_inspection_ok "$config_inspection_ok" \
    --argjson config "$config_status" \
    --argjson runtime_ignored "$runtime_ignored" \
    --argjson git_dirty_count "$git_dirty_count" \
    --argjson database_exists "$database_exists" \
    --argjson server_loaded "$server_loaded" \
    --argjson qdrant_loaded "$qdrant_loaded" \
    --argjson server_belongs_to_checkout "$server_belongs_to_checkout" \
    --argjson qdrant_belongs_to_checkout "$qdrant_belongs_to_checkout" \
    --argjson server_healthy "$server_healthy" \
    --argjson qdrant_healthy "$qdrant_healthy" \
    --argjson readiness "$readiness_json" \
    '{machine_ready:$machine_ready,
      repo:{root:$repo_root,git_dirty_file_count:$git_dirty_count,database_exists:$database_exists},
      platform:{os:$platform,arch:$arch,supported:$platform_supported},
      toolchain:{missing:$missing,go:{required:$required_go,actual:$actual_go,supported:$go_supported},node:{required:"^20.19.0 or >=22.12.0",actual:$actual_node,supported:$node_supported},cgo_ready:$cgo_ready,c_compiler:{command:(if $c_compiler == "" then null else $c_compiler end),ready:$c_compiler_ready},xcode_tools_ready:$xcode_tools_ready},
      agent_capabilities:{lark_skill_pack_ready:$lark_skill_pack_ready,lark_skill_pack_path:(if $lark_skill_path == "" then null else $lark_skill_path end)},
      configuration:{path:$config_path,inspection_ok:$config_inspection_ok,error:(if $config_error == "" then null else $config_error end),status:$config,runtime_override_ignored:$runtime_ignored},
      services:{server:{launchd_loaded:$server_loaded,program:(if $server_program == "" then null else $server_program end),belongs_to_checkout:$server_belongs_to_checkout,healthy:$server_healthy,readiness:$readiness},qdrant:{launchd_loaded:$qdrant_loaded,program:(if $qdrant_program == "" then null else $qdrant_program end),belongs_to_checkout:$qdrant_belongs_to_checkout,healthy:$qdrant_healthy}},
      warnings:$warnings}'

  [[ "$machine_ready" == "true" ]]
}

install_qdrant() {
  require_command jq
  require_command curl
  require_command launchctl
  require_command plutil
  [[ "$(uname -s)" == "Darwin" && "$(uname -m)" == "arm64" ]] || \
    fail "the bundled Qdrant installer supports macOS arm64 only"

  if curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null; then
    jq -nc --arg url "${QDRANT_URL}/healthz" '{ok:true,changed:false,detail:"an existing Qdrant endpoint is already healthy",health_url:$url}'
    return 0
  fi

  if service_loaded "$QDRANT_LABEL"; then
    local current_program
    current_program="$(service_program "$QDRANT_LABEL" 2>/dev/null || true)"
    if [[ "$current_program" != "${REPO_ROOT}/bin/qdrant" ]]; then
      fail "launchd label ${QDRANT_LABEL} belongs to another installation (${current_program:-unknown}); the Agent must obtain user approval before replacing it"
    fi
  fi

  "${REPO_ROOT}/scripts/install-qdrant.sh" >&2
  curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null || fail "Qdrant did not pass its health check"
  jq -nc --arg url "${QDRANT_URL}/healthz" '{ok:true,changed:true,health_url:$url}'
}

install_server() {
  require_command jq
  require_command curl
  require_command go
  require_command launchctl
  require_command npm
  require_command plutil

  if service_loaded "$SERVER_LABEL"; then
    local current_program
    current_program="$(service_program "$SERVER_LABEL" 2>/dev/null || true)"
    fail "Jarvis launchd service is already loaded (${current_program:-unknown}); use scripts/rebuild-server.sh for this checkout or ask before replacing another installation"
  fi

  local status
  status="$(initialization_status)"
  jq -e '.machine_configuration_ready == true' >/dev/null <<<"$status" || \
    fail "machine configuration is incomplete; finish initialize-jarvis before installing the service"
  local runtime_binary
  while IFS= read -r runtime_binary; do
    [[ -n "$runtime_binary" ]] || continue
    require_command "$runtime_binary"
  done < <(jq -r '.runtime_binaries[]?' <<<"$status")
  curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null || \
    fail "Qdrant is not healthy; install or select the vector service first"

  chmod 0600 "$CONFIG_PATH"
  local runtime_path
  runtime_path="$(jq -r '.runtime_config_path' <<<"$status")"
  [[ -f "$runtime_path" ]] || fail "runtime configuration was reported ready but is missing: $runtime_path"
  chmod 0600 "$runtime_path"

  "${REPO_ROOT}/scripts/install-launchd.sh" >&2
  local validation
  if ! validation="$(validate_installation)"; then
    printf '%s\n' "$validation" >&2
    fail "Jarvis was installed but did not pass end-to-end validation; inspect the reported dependency before continuing"
  fi
  jq -c '. + {changed:true}' <<<"$validation"
}

validate_installation() {
  require_command jq
  require_command curl
  require_command go

  local status qdrant_healthy server_healthy readiness readiness_ok permissions_ok ok
  status="$(initialization_status)"
  qdrant_healthy="$(bool_json curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null)"
  server_healthy="$(bool_json curl -fsS --max-time 2 "${SERVER_URL}/healthz" -o /dev/null)"
  readiness='null'
  readiness_ok=false
  if [[ "$server_healthy" == "true" ]]; then
    readiness="$(curl -fsS --max-time 4 "${SERVER_URL}/readyz" 2>/dev/null || printf 'null')"
    if jq -e '.status == "ok" and ([.dependencies[].status] | all(. == "ok" or . == "disabled"))' >/dev/null 2>&1 <<<"$readiness"; then
      readiness_ok=true
    fi
  fi

  permissions_ok=false
  if jq -e '.base_config_mode == "0600" and .runtime_config_mode == "0600"' >/dev/null <<<"$status"; then
    permissions_ok=true
  fi
  ok=false
  if jq -e '.machine_configuration_ready == true' >/dev/null <<<"$status" && \
    [[ "$qdrant_healthy" == "true" && "$server_healthy" == "true" && "$readiness_ok" == "true" && "$permissions_ok" == "true" ]]; then
    ok=true
  fi

  jq -nc \
    --argjson ok "$ok" \
    --argjson configuration "$status" \
    --argjson permissions_ok "$permissions_ok" \
    --argjson qdrant_healthy "$qdrant_healthy" \
    --argjson server_healthy "$server_healthy" \
    --argjson readiness_ok "$readiness_ok" \
    --argjson readiness "$readiness" \
    '{ok:$ok,configuration:$configuration,permissions_ok:$permissions_ok,services:{qdrant_healthy:$qdrant_healthy,server_healthy:$server_healthy,readiness_ok:$readiness_ok,readiness:$readiness}}'
  [[ "$ok" == "true" ]]
}

if (( $# == 0 )); then
  usage
  exit 2
fi

subcommand="$1"
shift
parse_common_flags "$@"

case "$subcommand" in
  doctor) doctor ;;
  install-qdrant) install_qdrant ;;
  install-server) install_server ;;
  validate) validate_installation ;;
  help|--help|-h) usage ;;
  *)
    usage
    fail "unknown subcommand: $subcommand"
    ;;
esac
