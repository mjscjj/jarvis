[Unit]
Description=Jarvis Server
After=network-online.target com.bytedance.jarvis.qdrant.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__JARVIS_ROOT__
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GOMAXPROCS=2
Environment=GOFLAGS=-p=2
ExecStart=__JARVIS_ROOT__/bin/jarvis-server -config __JARVIS_ROOT__/conf/config.yaml
# always, not on-failure: an external SIGTERM exits cleanly, which on-failure
# treats as a finished service. That once left Jarvis down for 9.5 hours while
# CC Connect rejected every incoming message. Stop it with systemctl, not kill.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
