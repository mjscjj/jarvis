#!/usr/bin/env python3
import http.client
import json
import socket
import sys

class Connection(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(70)
        self.sock.connect('/run/emily-egress/access.sock')

try:
    connection = Connection('localhost', timeout=70)
    body = json.dumps({'args': sys.argv[1:], 'stdin': ''})
    connection.request('POST', '/lark', body, {'Content-Type': 'application/json'})
    response = connection.getresponse()
    if response.status != 200:
        sys.stderr.write('Development CLI gateway denied or failed this operation (%s)\n' % response.status)
        sys.exit(1)
    result = json.loads(response.read())
    sys.stdout.write(result['stdout'])
    sys.stderr.write(result['stderr'])
    sys.exit(result['exit_code'])
except (OSError, ValueError) as exc:
    sys.stderr.write('Development CLI gateway unavailable: %s\n' % exc)
    sys.exit(1)
