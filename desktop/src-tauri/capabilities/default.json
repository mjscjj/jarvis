{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Jarvis main window",
  "remote": {
    "urls": ["http://127.0.0.1:18800/*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
