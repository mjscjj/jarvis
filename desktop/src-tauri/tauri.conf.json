{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.78",
  "identifier": "com.bytedance.jarvis",
  "build": {
    "beforeBuildCommand": "cd .. && ./packaging/macos/prepare-runtime.sh desktop/src-tauri/generated/runtime",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jarvis",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "resources": {
      "generated/runtime/": "runtime/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://jarvisx.bytedance.net/jarvis-updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4RUNCNTYwODlBNjA0NjQKUldSa0JLYUpZTFhzeU1ReC85bE8zTzNlWFNPRkxpNFdCQXZUUWxwTFV5YnRsMnBndG9YcnZ6amcK"
    }
  }
}
