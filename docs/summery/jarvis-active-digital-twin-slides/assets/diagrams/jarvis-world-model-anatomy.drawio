<mxfile host="app.diagrams.net">
  <diagram name="Jarvis 世界模型解剖图" id="jarvis-world-model-anatomy">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="950" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_main" value="世界模型保存的是当前工作世界，而不是一池历史片段" style="text;html=1;fontSize=18;fontColor=#2D3748;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="12" width="1520" height="30" as="geometry"/></mxCell>

        <mxCell id="group_entities" value="实体世界 · 我是谁、与谁协作、在推进什么" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5FB;strokeColor=#CBD5E0;strokeWidth=1;dashed=1;fontSize=10;fontColor=#68778D;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="40" y="65" width="1520" height="385" as="geometry"/></mxCell>
        <mxCell id="group_records" value="同一实体页附着三类认知记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD5E0;strokeWidth=1;dashed=1;fontSize=10;fontColor=#68778D;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="170" y="485" width="1260" height="205" as="geometry"/></mxCell>
        <mxCell id="group_actions" value="行动状态 · 发现变化、承接目标、记录真实行动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FA;strokeColor=#CBD5E0;strokeWidth=1;dashed=1;fontSize=10;fontColor=#68778D;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="250" y="735" width="1100" height="145" as="geometry"/></mxCell>

        <mxCell id="node_principal" value="&lt;b&gt;Principal / 我&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;所有认知都在这个坐标系下组织&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="650" y="100" width="300" height="78" as="geometry"/></mxCell>

        <mxCell id="node_person" value="&lt;b&gt;Person&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;角色 · 承诺 · 协作关系&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F9;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="175" y="245" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="node_project" value="&lt;b&gt;Project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;目标 · 进展 · 风险 · 仓库&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F5EC;strokeColor=#5BA87C;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="425" y="245" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="node_matter" value="&lt;b&gt;KeyMatter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;长期推进、尚未闭环的事项&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F9;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="675" y="245" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="node_group" value="&lt;b&gt;Group&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;协作发生的稳定语境&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F9;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="925" y="245" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="node_resource" value="&lt;b&gt;Resource&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;文档 · 仓库 · 系统入口&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F9;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="1175" y="245" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="label_relations" value="&lt;b&gt;关系不是另一张表&lt;/b&gt;　[文字](type:id) 可验证引用　→　从 Summary 派生 Backlinks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#95A5B9;strokeWidth=1.2;arcSize=10;fontSize=12;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="300" y="370" width="1000" height="50" as="geometry"/></mxCell>

        <mxCell id="node_summary" value="&lt;b&gt;Summary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;现在怎样&lt;br&gt;可被新证据持续修正&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F5EC;strokeColor=#5BA87C;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="230" y="540" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="node_fact" value="&lt;b&gt;Fact&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;发生过什么&lt;br&gt;带时间与来源追加保存&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC9C2F;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="650" y="540" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="node_revision" value="&lt;b&gt;PageRevision&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;以前怎么看&lt;br&gt;保存 Jarvis 的认知审计&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE8F5;strokeColor=#8B7EC4;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="1070" y="540" width="300" height="105" as="geometry"/></mxCell>

        <mxCell id="node_todo" value="&lt;b&gt;Todo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;发现变化&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC9C2F;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="330" y="780" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="node_task" value="&lt;b&gt;Task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;承接真实目标&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE8F5;strokeColor=#8B7EC4;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="690" y="780" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="node_run" value="&lt;b&gt;ExecutionRun&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#68778D&quot;&gt;记录行动、验证与 Effects&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F5EC;strokeColor=#5BA87C;strokeWidth=1.2;arcSize=10;fontSize=13;fontColor=#2D3748;" parent="1" vertex="1"><mxGeometry x="1050" y="780" width="220" height="65" as="geometry"/></mxCell>

        <mxCell id="ray_principal_person" style="endArrow=none;strokeColor=#8496AE;strokeWidth=0.8;dashed=1;" parent="1" source="node_principal" target="node_person" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ray_principal_project" style="endArrow=none;strokeColor=#8496AE;strokeWidth=0.8;dashed=1;" parent="1" source="node_principal" target="node_project" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ray_principal_matter" style="endArrow=none;strokeColor=#8496AE;strokeWidth=0.8;dashed=1;" parent="1" source="node_principal" target="node_matter" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ray_principal_group" style="endArrow=none;strokeColor=#8496AE;strokeWidth=0.8;dashed=1;" parent="1" source="node_principal" target="node_group" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ray_principal_resource" style="endArrow=none;strokeColor=#8496AE;strokeWidth=0.8;dashed=1;" parent="1" source="node_principal" target="node_resource" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr_todo_task" value="&lt;span style=&quot;font-size:9px;color:#3F72D9&quot;&gt;固化&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#8496AE;strokeWidth=0.8;endSize=5;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="node_todo" target="node_task" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
