<mxfile host="app.diagrams.net">
  <diagram name="Jarvis 工具能力脑图" id="jarvis_prompt_tools_001">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1050" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title_main" value="Jarvis 如何用提示词组合工具完成任务" style="text;html=1;fontSize=18;fontColor=#2D3748;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1320" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="提示词负责理解目标与边界；代码只提供可组合能力与机器硬约束" style="text;html=1;fontSize=11;fontColor=#68778D;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="100" y="55" width="1200" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="node_center" value="&lt;b&gt;Jarvis Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#68778D&quot;&gt;根据上下文选择、组合并验证工具&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#5B8DEF;strokeWidth=2;arcSize=10;fontSize=16;fontColor=#2D3748;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="570" y="470" width="260" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="node_jarvis" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F9;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="450" y="105" width="500" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="node_jarvis_title" value="&lt;b&gt;jarvis-tools｜Jarvis 自身状态与行动&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#2D3748;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="470" y="120" width="460" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="node_jarvis_body" value="&amp;bull; 世界模型：Principal / Project / KeyMatter / Group / Person / Resource / Context&lt;br&gt;&amp;bull; 证据认知：Message / CapturedResource / SharedMemory / Skill / Page / Fact / Backlink&lt;br&gt;&amp;bull; 线索行动：Clue / Todo / Task&lt;br&gt;&amp;bull; 定时恢复：ScheduledTask / yield-until&lt;br&gt;&amp;bull; 读取路径：list / query → get → 按需写入" style="text;html=1;fontSize=10;fontColor=#68778D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="475" y="158" width="450" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="node_lark" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F9;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="1010" y="385" width="350" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="node_lark_title" value="&lt;b&gt;lark-cli｜飞书协作&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#2D3748;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1030" y="400" width="310" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="node_lark_body" value="&amp;bull; 能力发现：skills list / skills read / schema&lt;br&gt;&amp;bull; IM 与群聊&lt;br&gt;&amp;bull; 文档 / Wiki / 云盘&lt;br&gt;&amp;bull; 日历 / 会议 / 妙记&lt;br&gt;&amp;bull; 任务 / 审批&lt;br&gt;&amp;bull; 表格 / Base / 幻灯片&lt;br&gt;&amp;bull; 通讯录 / 邮件 / OKR" style="text;html=1;fontSize=10;fontColor=#68778D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="1035" y="438" width="300" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="node_byted" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F9;strokeColor=#5B8DEF;strokeWidth=1.2;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="450" y="715" width="500" height="245" as="geometry"/>
        </mxCell>
        <mxCell id="node_byted_title" value="&lt;b&gt;bytedcli｜内部研发与平台信息&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#2D3748;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="470" y="730" width="460" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="node_byted_body" value="&amp;bull; 能力发现：--all-help / 子命令 --help&lt;br&gt;&amp;bull; 代码搜索&lt;br&gt;&amp;bull; Commit / MR / Issue&lt;br&gt;&amp;bull; 服务、数据与内部研发平台&lt;br&gt;&amp;bull; 根据任务动态选择具体命令，不把平台 API 写死进提示词" style="text;html=1;fontSize=10;fontColor=#68778D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="475" y="768" width="450" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="node_git" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#95A5B9;strokeWidth=1.2;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="385" width="350" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="node_git_title" value="&lt;b&gt;git｜本地工程仓库&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#2D3748;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="60" y="400" width="310" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="node_git_body" value="&amp;bull; 读取：status / log / show / blame&lt;br&gt;&amp;bull; 分析：diff / branch / worktree&lt;br&gt;&amp;bull; 交付：add / commit / push&lt;br&gt;&amp;bull; 具体修改、测试和验证仍由 Agent 根据任务决定" style="text;html=1;fontSize=10;fontColor=#68778D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="65" y="438" width="300" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="ray_jarvis" style="endArrow=none;strokeColor=#8496AE;strokeWidth=1.2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="node_center" target="node_jarvis" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ray_lark" style="endArrow=none;strokeColor=#8496AE;strokeWidth=1.2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="node_center" target="node_lark" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ray_byted" style="endArrow=none;strokeColor=#8496AE;strokeWidth=1.2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="node_center" target="node_byted" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ray_git" style="endArrow=none;strokeColor=#8496AE;strokeWidth=1.2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="node_center" target="node_git" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
