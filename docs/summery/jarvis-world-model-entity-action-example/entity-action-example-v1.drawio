        <mxCell id="arr_project_resource" value="沉淀于" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#6A9F91;strokeWidth=1.1;endSize=5;html=1;fontSize=10;fontColor=#238377;labelBackgroundColor=#F2FBF8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="node_project" target="node_resource" edge="1">
