        <mxCell id="arr_keymatter_project" value="推进" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#6A9F91;strokeWidth=1.1;endSize=5;html=1;fontSize=10;fontColor=#238377;labelBackgroundColor=#F2FBF8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.78;entryDx=0;entryDy=0;" parent="1" source="node_keymatter" target="node_project" edge="1">
          <mxGeometry relative="1" as="geometry"/>
