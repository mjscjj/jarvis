        <mxCell id="arr_trigger_todo" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#E3921F;strokeWidth=1.5;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="node_trigger" target="node_todo" edge="1">
