        <mxCell id="node_todo" value="&lt;b&gt;Todo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A7A7A&quot;&gt;值得处理：会前补图&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E3921F;strokeWidth=1.2;arcSize=14;fontSize=16;fontColor=#1A3A3A;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="620" y="680" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="node_task" value="&lt;b&gt;Task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5A7A7A&quot;&gt;补齐实例图&lt;br&gt;更新方案并通知评审人&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E3921F;strokeWidth=1.6;arcSize=14;fontSize=16;fontColor=#1A3A3A;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
