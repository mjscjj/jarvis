        <mxCell id="arr_group_project" value="讨论" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#6A9F91;strokeWidth=1.1;endSize=5;html=1;fontSize=10;fontColor=#238377;labelBackgroundColor=#F2FBF8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" parent="1" source="node_group" target="node_project" edge="1">
