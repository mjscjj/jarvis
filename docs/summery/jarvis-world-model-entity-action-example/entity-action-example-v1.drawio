        <mxCell id="note_completion" value="&lt;b&gt;完成后：&lt;/b&gt;ExecutionRun 的结果可以成为 Fact，并更新相关实体的 Summary；实体继续存在，行动进入历史。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF3;strokeColor=#4AAE5C;strokeWidth=1;arcSize=12;fontSize=12;fontColor=#368545;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
