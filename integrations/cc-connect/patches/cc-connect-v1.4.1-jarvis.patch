+type jarvisApprovalRelayRequest struct {
+	EventID     string         `json:"event_id"`
+	OperatorID  string         `json:"operator_id"`
+	MessageID   string         `json:"message_id"`
+	ChatID      string         `json:"chat_id"`
+	ActionTag   string         `json:"action_tag"`
+	ActionValue map[string]any `json:"action_value"`
+}
+
+type jarvisApprovalRelayResponse struct {
+	Code int            `json:"code"`
+	Msg  string         `json:"msg"`
+	Card map[string]any `json:"card"`
+}
+
+func (p *Platform) fetchRawCard(ctx context.Context, messageID string) (map[string]any, error) {
+	messageID = strings.TrimSpace(messageID)
+	if messageID == "" {
+		return nil, fmt.Errorf("Jarvis approval message_id is empty")
+	}
+	query := larkcore.QueryParams{}
+	query.Set("card_msg_content_type", "raw_card_content")
+	path := larkcore.PathParams{}
+	path.Set("message_id", messageID)
+	apiResp, err := p.client.Do(ctx, &larkcore.ApiReq{
+		HttpMethod:                http.MethodGet,
+		ApiPath:                   "/open-apis/im/v1/messages/:message_id",
+		PathParams:                path,
+		QueryParams:               query,
+		SupportedAccessTokenTypes: []larkcore.AccessTokenType{larkcore.AccessTokenTypeTenant},
+	})
+	if err != nil {
+		return nil, fmt.Errorf("get Jarvis approval card message_id=%s: %w", messageID, err)
+	}
+	var resp struct {
+		larkcore.CodeError
+		Data *larkim.GetMessageRespData `json:"data"`
+	}
+	if err := json.Unmarshal(apiResp.RawBody, &resp); err != nil {
+		return nil, fmt.Errorf("decode Jarvis approval card response message_id=%s: %w", messageID, err)
+	}
+	if resp.Code != 0 {
+		return nil, fmt.Errorf("get Jarvis approval card message_id=%s: code=%d msg=%s", messageID, resp.Code, resp.Msg)
+	}
+	itemCount := 0
+	if resp.Data != nil {
+		itemCount = len(resp.Data.Items)
+	}
+	if itemCount != 1 {
+		return nil, fmt.Errorf("get Jarvis approval card message_id=%s: items=%d, want 1", messageID, itemCount)
+	}
+	message := resp.Data.Items[0]
+	if message == nil || message.MsgType == nil || *message.MsgType != "interactive" || message.Body == nil || message.Body.Content == nil {
+		return nil, fmt.Errorf("get Jarvis approval card message_id=%s: message is not an interactive card", messageID)
+	}
+	card, err := decodeRawCardContent(*message.Body.Content)
+	if err != nil {
+		return nil, fmt.Errorf("decode Jarvis approval card message_id=%s: %w", messageID, err)
+	}
+	return card, nil
+}
+
+func decodeRawCardContent(content string) (map[string]any, error) {
+	cardJSON := content
+	var wrapper struct {
+		JSONCard string `json:"json_card"`
+	}
+	if json.Unmarshal([]byte(cardJSON), &wrapper) == nil && wrapper.JSONCard != "" {
+		cardJSON = wrapper.JSONCard
+	}
+	var card map[string]any
+	if err := json.Unmarshal([]byte(cardJSON), &card); err != nil {
+		return nil, err
+	}
+	if len(card) == 0 {
+		return nil, fmt.Errorf("card is empty")
+	}
+	return card, nil
+}
+
+// mergeJarvisApprovalCard keeps the card the principal reviewed, removes only
+// the resolved approve/reject controls, and adds Jarvis's outcome notice. The
+// original message is the display source of truth; rebuilding it from Task
+// fields would lose wording that the principal actually saw.
+func mergeJarvisApprovalCard(original, notice map[string]any) (map[string]any, error) {
+	raw, err := json.Marshal(original)
+	if err != nil {
+		return nil, fmt.Errorf("copy original Jarvis approval card: %w", err)
+	}
+	var merged map[string]any
+	if err := json.Unmarshal(raw, &merged); err != nil {
+		return nil, fmt.Errorf("copy original Jarvis approval card: %w", err)
+	}
+	body, key, elements, err := jarvisApprovalCardBodyElements(merged)
+	if err != nil {
+		return nil, err
+	}
+	noticeText, err := jarvisApprovalNoticeText(notice)
+	if err != nil {
+		return nil, err
+	}
+	kept := filterResolvedJarvisApprovalControls(elements)
+	body[key] = append([]any{map[string]any{"tag": "markdown", "content": noticeText}}, kept...)
+	return merged, nil
+}
+
+func jarvisApprovalNoticeText(card map[string]any) (string, error) {
+	_, _, elements, err := jarvisApprovalCardBodyElements(card)
+	if err != nil {
+		return "", fmt.Errorf("Jarvis approval result card: %w", err)
+	}
+	for _, element := range elements {
+		item, ok := element.(map[string]any)
+		if !ok || item["tag"] != "markdown" {
+			continue
+		}
+		content, _ := item["content"].(string)
+		if strings.TrimSpace(content) != "" {
+			return content, nil
+		}
+	}
+	return "", fmt.Errorf("Jarvis approval result card has no markdown notice")
+}
+
+func jarvisApprovalCardBodyElements(card map[string]any) (map[string]any, string, []any, error) {
+	body, ok := card["body"].(map[string]any)
+	if !ok {
+		return nil, "", nil, fmt.Errorf("Jarvis approval card has no body")
+	}
+	if elements, ok := body["elements"].([]any); ok {
+		return body, "elements", elements, nil
+	}
+	property, ok := body["property"].(map[string]any)
+	if !ok {
+		return nil, "", nil, fmt.Errorf("Jarvis approval card body has no elements")
+	}
+	elements, ok := property["elements"].([]any)
+	if !ok {
+		return nil, "", nil, fmt.Errorf("Jarvis approval card body has no elements")
+	}
+	return property, "elements", elements, nil
+}
+
+func filterResolvedJarvisApprovalControls(items []any) []any {
+	filtered := make([]any, 0, len(items))
+	for _, item := range items {
+		kept, ok := filterResolvedJarvisApprovalControl(item)
+		if ok {
+			filtered = append(filtered, kept)
+		}
+	}
+	return filtered
+}
+
+func filterResolvedJarvisApprovalControl(value any) (any, bool) {
+	item, ok := value.(map[string]any)
+	if !ok {
+		return value, true
+	}
+	if item["tag"] == "button" && isJarvisApprovalDecisionButton(item) {
+		return nil, false
+	}
+	for _, key := range []string{"elements", "columns"} {
+		children, ok := item[key].([]any)
+		if !ok {
+			continue
+		}
+		item[key] = filterResolvedJarvisApprovalControls(children)
+	}
+	if item["tag"] == "column" {
+		if children, ok := item["elements"].([]any); ok && len(children) == 0 {
+			return nil, false
+		}
+	}
+	if item["tag"] == "column_set" {
+		if children, ok := item["columns"].([]any); ok && len(children) == 0 {
+			return nil, false
+		}
+	}
+	return item, true
+}
+
+func isJarvisApprovalDecisionButton(button map[string]any) bool {
+	behaviors, _ := button["behaviors"].([]any)
+	for _, rawBehavior := range behaviors {
+		behavior, ok := rawBehavior.(map[string]any)
+		if !ok || behavior["type"] != "callback" {
+			continue
+		}
+		value, ok := behavior["value"].(map[string]any)
+		if !ok || value["action"] != "jarvis_approval" {
+			continue
+		}
+		decision, _ := value["decision"].(string)
+		if decision == "approve" || decision == "reject" {
+			return true
+		}
+	}
+	return false
+}
+
+func (p *Platform) forwardJarvisApproval(event *callback.CardActionTriggerEvent) (*callback.CardActionTriggerResponse, error) {
+	userID := ""
+	if event.Event.Operator != nil {
+		userID = event.Event.Operator.OpenID
+	}
+	messageID, chatID := "", ""
+	if event.Event.Context != nil {
+		messageID = event.Event.Context.OpenMessageID
+		chatID = event.Event.Context.OpenChatID
+	}
+	eventID := ""
+	if event.EventV2Base != nil && event.EventV2Base.Header != nil {
+		eventID = event.EventV2Base.Header.EventID
+	}
+	payload, err := json.Marshal(jarvisApprovalRelayRequest{
+		EventID: eventID, OperatorID: userID, MessageID: messageID, ChatID: chatID,
+		ActionTag: event.Event.Action.Tag, ActionValue: event.Event.Action.Value,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("encode Jarvis approval callback: %w", err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), p.jarvisApprovalTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, p.jarvisApprovalURL, bytes.NewReader(payload))
+	if err != nil {
+		return nil, fmt.Errorf("build Jarvis approval callback: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-Jarvis-Relay-Secret", p.jarvisApprovalSecret)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		slog.Error(p.tag()+": Jarvis approval relay failed", "err", err)
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "error", Content: "审批处理失败，请稍后重试"},
+		}, nil
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return nil, fmt.Errorf("read Jarvis approval response: %w", err)
+	}
+	var result jarvisApprovalRelayResponse
+	if err := json.Unmarshal(body, &result); err != nil {
+		slog.Error(p.tag()+": Jarvis approval relay returned invalid JSON", "status", resp.StatusCode, "err", err)
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "error", Content: "审批服务返回异常，请稍后重试"},
+		}, nil
+	}
+	if resp.StatusCode != http.StatusOK || result.Code != 0 {
+		slog.Warn(p.tag()+": Jarvis approval relay rejected callback", "status", resp.StatusCode, "code", result.Code, "msg", result.Msg)
+		content := "审批未生效，请刷新任务状态后重试"
+		if resp.StatusCode == http.StatusConflict {
+			content = "这条审批可能已经处理过了"
+		}
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "warning", Content: content},
+		}, nil
+	}
+	if len(result.Card) == 0 {
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "success", Content: "审批已处理"},
+		}, nil
+	}
+	if p.jarvisApprovalCardFetch == nil {
+		return nil, fmt.Errorf("Jarvis approval card fetcher is nil")
+	}
+	original, err := p.jarvisApprovalCardFetch(ctx, messageID)
+	if err != nil {
+		slog.Error(p.tag()+": preserve Jarvis approval card failed", "message_id", messageID, "err", err)
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "success", Content: "审批已处理"},
+		}, nil
+	}
+	merged, err := mergeJarvisApprovalCard(original, result.Card)
+	if err != nil {
+		slog.Error(p.tag()+": merge Jarvis approval card failed", "message_id", messageID, "err", err)
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "success", Content: "审批已处理"},
+		}, nil
