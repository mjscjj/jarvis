+func TestCardActionForwardsJarvisApproval(t *testing.T) {
+	var (
+		gotSecret string
+		gotBody   map[string]any
+	)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotSecret = r.Header.Get("X-Jarvis-Relay-Secret")
+		if err := json.NewDecoder(r.Body).Decode(&gotBody); err != nil {
+			t.Fatalf("decode relay request: %v", err)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"code":0,"card":{"schema":"2.0","body":{"elements":[{"tag":"markdown","content":"✅ 已同意，正在处理。"}]}}}`)
+	}))
+	defer server.Close()
+
+	platformAny, err := New(map[string]any{
+		"app_id": "cli_xxx", "app_secret": "secret", "enable_feishu_card": true,
+		"jarvis_approval_url": server.URL, "jarvis_approval_secret": "relay-secret",
+	})
+	if err != nil {
+		t.Fatalf("New() error = %v", err)
+	}
+	ip := platformAny.(*interactivePlatform)
+	ip.jarvisApprovalCardFetch = func(_ context.Context, messageID string) (map[string]any, error) {
+		if messageID != "om_card" {
+			t.Fatalf("fetch message_id = %q, want om_card", messageID)
+		}
+		return map[string]any{
+			"schema": "2.0",
+			"header": map[string]any{"title": map[string]any{"tag": "plain_text", "content": "需要你拍板：保留原文"}},
+			"body": map[string]any{"elements": []any{
+				map[string]any{"tag": "markdown", "content": "**要做的事**\n发送原定消息\n\n**会产生的影响**\n对外回复"},
+				map[string]any{"tag": "column_set", "columns": []any{
+					jarvisApprovalTestColumn("确认", map[string]any{"type": "callback", "value": map[string]any{"action": "jarvis_approval", "decision": "approve", "task_id": float64(7)}}),
+					jarvisApprovalTestColumn("拒绝", map[string]any{"type": "callback", "value": map[string]any{"action": "jarvis_approval", "decision": "reject", "task_id": float64(7)}}),
+					jarvisApprovalTestColumn("查看详情", map[string]any{"type": "open_url", "default_url": "http://127.0.0.1:18800/#/work/task/7"}),
+				}},
+			}},
+		}, nil
+	}
+	openID, chatID, messageID := "ou_principal", "oc_chat", "om_card"
+	resp, err := ip.onCardAction(&callback.CardActionTriggerEvent{
+		EventV2Base: &larkevent.EventV2Base{Header: &larkevent.EventHeader{EventID: "evt_1"}},
+		Event: &callback.CardActionTriggerRequest{
+			Operator: &callback.Operator{OpenID: openID},
+			Action: &callback.CallBackAction{
+				Tag:   "button",
+				Value: map[string]any{"action": "jarvis_approval", "decision": "approve", "task_id": float64(7)},
+			},
+			Context: &callback.Context{OpenChatID: chatID, OpenMessageID: messageID},
+		},
+	})
+	if err != nil {
+		t.Fatalf("onCardAction() error = %v", err)
+	}
+	if resp == nil || resp.Card == nil || resp.Card.Type != "raw" {
+		t.Fatalf("response = %#v, want raw replacement card", resp)
+	}
+	merged, err := json.Marshal(resp.Card.Data)
+	if err != nil {
+		t.Fatalf("marshal replacement card: %v", err)
+	}
+	for _, want := range []string{"需要你拍板：保留原文", "**要做的事**", "发送原定消息", "**会产生的影响**", "对外回复", "✅ 已同意，正在处理。", "查看详情"} {
+		if !strings.Contains(string(merged), want) {
+			t.Fatalf("replacement card lost %q: %s", want, merged)
+		}
+	}
+	for _, removed := range []string{`"decision":"approve"`, `"decision":"reject"`} {
+		if strings.Contains(string(merged), removed) {
+			t.Fatalf("replacement card kept resolved control %q: %s", removed, merged)
+		}
+	}
+	if gotSecret != "relay-secret" {
+		t.Fatalf("relay secret = %q", gotSecret)
+	}
+	if gotBody["operator_id"] != openID || gotBody["message_id"] != messageID {
+		t.Fatalf("relay body = %#v", gotBody)
+	}
+	action, _ := gotBody["action_value"].(map[string]any)
+	if action["action"] != "jarvis_approval" || action["decision"] != "approve" {
+		t.Fatalf("relay action = %#v", action)
+	}
+}
