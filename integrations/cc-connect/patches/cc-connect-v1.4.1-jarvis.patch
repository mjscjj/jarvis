+func TestDecodeRawCardContentUnwrapsFeishuMessageBody(t *testing.T) {
+	rawCard := `{"schema":"2.0","body":{"tag":"body","property":{"elements":[{"tag":"markdown","content":"原审批正文"}]}}}`
+	wrapper, err := json.Marshal(map[string]any{"json_card": rawCard})
+	if err != nil {
+		t.Fatalf("marshal raw card wrapper: %v", err)
+	}
+	card, err := decodeRawCardContent(string(wrapper))
+	if err != nil {
+		t.Fatalf("decodeRawCardContent() error = %v", err)
+	}
+	notice := map[string]any{"body": map[string]any{"elements": []any{map[string]any{"tag": "markdown", "content": "已驳回，不会执行。"}}}}
+	merged, err := mergeJarvisApprovalCard(card, notice)
+	if err != nil {
+		t.Fatalf("mergeJarvisApprovalCard() error = %v", err)
+	}
+	encoded, err := json.Marshal(merged)
+	if err != nil {
+		t.Fatalf("marshal merged card: %v", err)
+	}
+	for _, want := range []string{"原审批正文", "已驳回，不会执行。"} {
+		if !strings.Contains(string(encoded), want) {
+			t.Fatalf("merged card lost %q: %s", want, encoded)
+		}
+	}
+}
