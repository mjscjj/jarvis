#!/usr/bin/env bash
# Instance settings always come from the selected configuration, not a parent
# Agent's API override. Used by service management and the API resolver.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONFIG_PATH="${1:-${JARVIS_CONFIG:-${REPO_ROOT}/conf/config.yaml}}"
[[ $# -le 1 ]] || { echo 'usage: jarvis-instance [CONFIG_PATH]' >&2; exit 2; }
if [[ -f "$CONFIG_PATH" ]]; then
  CONFIG_PATH="$(cd "$(dirname "$CONFIG_PATH")" && pwd)/$(basename "$CONFIG_PATH")"
elif [[ "$CONFIG_PATH" != /* ]]; then
  CONFIG_PATH="${REPO_ROOT}/${CONFIG_PATH}"
fi
cd "$REPO_ROOT"
exec go run ./cmd/jarvis-config instance --config "$CONFIG_PATH"
