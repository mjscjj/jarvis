# get-task merges task detail, recent runs, the event timeline and task-scoped
# facts into one JSON object — the pieces a summary line omits.
cmd_get_task() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "get-task requires positive --id"
  require_limit "get-task --run-limit" "$RUN_LIMIT" 20
  require_limit "get-task --event-limit" "$EVENT_LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local task runs events facts
  task="$(api_get "/api/tasks/${ID}" | jq -c '.data')"
  runs="$(api_get "/api/tasks/${ID}/runs" | jq -c --argjson limit "$RUN_LIMIT" --argjson include_output "$INCLUDE_RUN_OUTPUT" --argjson include_prompt "$INCLUDE_PROMPT" '
    [.data.items[:$limit][]
      | {id,task_id,action_type,stage,sandbox,status,summary,effects,error_detail,repo_path,started_at,finished_at,duration_ms}
      + (if $include_output then {output:.output} else {} end)
      + (if $include_prompt then {prompt:.prompt} else {} end)
    ]')"
  events="$(api_get "/api/tasks/${ID}/events" | jq -c --argjson limit "$EVENT_LIMIT" '.data.items[:$limit]')"
  facts="$(api_get "/api/facts?subject_type=task&subject_id=${ID}&limit=20" | jq -c '.data.items')"
  emit "$(jq -cn --argjson task "$task" --argjson runs "$runs" --argjson events "$events" --argjson facts "$facts" \
    '{task:$task,runs:$runs,events:$events,facts:$facts}')"
}

