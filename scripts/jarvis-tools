#!/usr/bin/env bash
# jarvis-tools: canonical Jarvis query/controlled-write CLI for agents.
# All data access goes through jarvis-server HTTP API (curl + jq).
#
# Output contract: data commands → compact JSON on stdout only; help → text on
# stdout; errors → stderr + exit 1.
set -euo pipefail

fail() {
  echo "jarvis-tools error: $*" >&2
  exit 1
}

command -v curl >/dev/null 2>&1 || fail "curl is required but not found in PATH"
command -v jq >/dev/null 2>&1 || fail "jq is required but not found in PATH"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

print_usage() {
  cat <<'EOF'
usage: jarvis-tools <subcommand> [flags]

subcommands:
  list-projects          List projects
  get-project            Get one project and its recent context
  get-group              Get one Feishu group by chat_id
  get-principal          Get the assistant owner's profile
  list-persons           List important people, optionally by role
  get-person             Get one person by Feishu open_id
  query-resources        Query managed docs, links, repos and notes
  get-shared-memory      Read shared memory
  get-skill              Read one locally managed Skill
  append-shared-memory   Append one entry to shared memory
  append-clue            Hand M2 one observed fact as evidence for M3
  list-scheduled-tasks   List time-triggered tasks
  create-scheduled-task  Create a time trigger for a new task
  yield-until            Pause the current task until a future time
  delete-scheduled-task  Delete a standalone time trigger

Run "jarvis-tools <subcommand> --help" for command-specific flags.
EOF
}

usage_error() {
  print_usage >&2
  exit 1
}

print_subcommand_help() {
  case "$1" in
    list-projects) cat <<'EOF'
usage: jarvis-tools list-projects [--config PATH]
List all projects and their current background.
EOF
      ;;
    get-project) cat <<'EOF'
usage: jarvis-tools get-project (--id ID | --code CODE) [--config PATH]
Get one project together with recent progress events and relation facts.
EOF
      ;;
    get-group) cat <<'EOF'
usage: jarvis-tools get-group --chat-id CHAT_ID [--config PATH]
Get the Jarvis group binding and background for an exact Feishu chat_id.
EOF
      ;;
    get-principal) cat <<'EOF'
usage: jarvis-tools get-principal [--config PATH]
Get the profile of the person Jarvis assists.
EOF
      ;;
    list-persons) cat <<'EOF'
usage: jarvis-tools list-persons [--role leader|key|colleague|other] [--config PATH]
List important people known to Jarvis, optionally filtered by role.
EOF
      ;;
    get-person) cat <<'EOF'
usage: jarvis-tools get-person --open-id OPEN_ID [--config PATH]
Get one person and relation facts by exact Feishu open_id.
EOF
      ;;
    query-resources) cat <<'EOF'
usage: jarvis-tools query-resources [--project-id ID] [--person-open-id OPEN_ID] [--principal-only] [--keyword TEXT] [--limit N] [--config PATH]
Query active managed resources such as project repos, documents, links and notes.
EOF
      ;;
    get-shared-memory) cat <<'EOF'
usage: jarvis-tools get-shared-memory [--config PATH]
Read the complete shared memory Markdown.
EOF
      ;;
    get-skill) cat <<'EOF'
usage: jarvis-tools get-skill --name NAME [--config PATH]
Read the complete content of one locally managed Skill.
EOF
      ;;
    append-shared-memory) cat <<'EOF'
usage: jarvis-tools append-shared-memory [--note TEXT|-] [--config PATH]
Atomically append one non-empty entry. Use --note - or omit it to read stdin.
EOF
      ;;
    append-clue) cat <<'EOF'
usage: jarvis-tools append-clue --source SOURCE --external-id ID --title TEXT
                               [--content TEXT|-] [--occurred-at RFC3339] [--config PATH]

Deliver one observed fact into the evidence stream so M3 can judge it. Report
only what you actually saw; do not classify it, rate it, or chase follow-up
material — working out what the fact means is M3's job.

  --source       lowercase snake_case producer id, e.g. feishu_meeting. Picks
                 the clue channel; a new source creates its channel on first use.
  --external-id  producer-side id used for idempotency. Redelivering the same
                 (source, external-id) returns inserted=false and changes nothing.
  --title        one line stating the fact, e.g. "会议结束：公会基建Agent 日会".
  --content      the raw detail. Use --content - or omit it to read stdin.
  --occurred-at  when the fact happened (defaults to now).

example:
  jarvis-tools append-clue --source feishu_meeting --external-id 7667030332496007223 \
    --title '会议结束：公会基建Agent 日会' --occurred-at 2026-07-27T14:01:00+08:00 --content - <<'TXT'
  会议 ID：7667030332496007223
  时间：2026-07-27 11:45 ~ 14:01
  参会人：...
  TXT
EOF
      ;;
    list-scheduled-tasks) cat <<'EOF'
usage: jarvis-tools list-scheduled-tasks [--status binding|active|running|completed] [--limit N] [--config PATH]
List current time triggers. binding entries are owned by waiting Tasks.
EOF
      ;;
    create-scheduled-task) cat <<'EOF'
usage: jarvis-tools create-scheduled-task [--payload JSON|-] [--config PATH]
Create a trigger for an independent new task. The payload must contain title,
instruction, context_snapshot, schedule_type and its matching schedule field.

once example:
  {"title":"明早检查进展","instruction":"查询项目最新进展","context_snapshot":{},"schedule_type":"once","run_at":"2026-07-25T09:00:00+08:00"}
daily example:
  {"title":"每日汇总","instruction":"汇总今日进展","context_snapshot":{},"schedule_type":"daily","daily_time":"18:00"}
interval example:
  {"title":"轮询状态","instruction":"检查任务是否完成","context_snapshot":{},"schedule_type":"interval","interval_minutes":60}
EOF
      ;;
    yield-until) cat <<'EOF'
usage: jarvis-tools yield-until --at RFC3339 [--reason TEXT|-] [--config PATH]
Pause the current executing Task and arrange its continuation. JARVIS_TASK_ID
must be provided by the Task runner.
EOF
      ;;
    delete-scheduled-task) cat <<'EOF'
usage: jarvis-tools delete-scheduled-task --id ID [--config PATH]
Delete a standalone trigger. A continuation owned by a waiting Task cannot be deleted.
EOF
      ;;
    *) return 1 ;;
  esac
}

# resolve_api_base CONFIG_PATH
# Prefer JARVIS_API_BASE; otherwise require and read server.addr from config.
resolve_api_base() {
  local config_path="$1"
  if [[ -n "${JARVIS_API_BASE:-}" ]]; then
    echo "${JARVIS_API_BASE%/}"
    return
  fi
  local resolved=""
  if [[ -f "$config_path" ]]; then
    resolved="$config_path"
  elif [[ "$config_path" != /* && -f "${REPO_ROOT}/${config_path}" ]]; then
    resolved="${REPO_ROOT}/${config_path}"
  fi
  if [[ -z "$resolved" ]]; then
    fail "config file not found: ${config_path}"
  fi
  local addr
  addr="$(grep -E '^\s*addr:\s*' "$resolved" | head -n1 | sed -E 's/^[[:space:]]*addr:[[:space:]]*"?([^"#]+)"?.*/\1/' | tr -d '[:space:]')"
  if [[ -z "$addr" ]]; then
    fail "could not parse server.addr from ${resolved}"
  fi
  echo "http://${addr}"
}

# api_get PATH_AND_QUERY → prints response body to stdout; fails on HTTP/API error.
api_get() {
  local path_and_query="$1"
  local url="${API_BASE}${path_and_query}"
  local body http_code
  body="$(curl -sS -w '\n%{http_code}' --max-time 30 "$url")" || fail "curl failed for ${url}"
  http_code="$(printf '%s\n' "$body" | tail -n1)"
  body="$(printf '%s\n' "$body" | sed '$d')"
  local code=""
  if printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    code="$(printf '%s' "$body" | jq -r '.code // empty')"
  fi
  # Align with Go jarvis-tools mapNotFound → "not found".
  if [[ "$http_code" == "404" || "$code" == "40420" ]]; then
    fail "not found"
  fi
  if [[ "$http_code" != "200" ]]; then
    fail "HTTP ${http_code} from ${url}: ${body}"
  fi
  if [[ -z "$code" ]]; then
    fail "invalid JSON from ${url}"
  fi
  if [[ "$code" != "0" ]]; then
    fail "API code=${code} from ${url}: ${body}"
  fi
  printf '%s' "$body"
}

# api_write METHOD PATH JSON_BODY → prints response body to stdout.
api_write() {
  local method="$1"
  local path="$2"
  local json_body="$3"
  local url="${API_BASE}${path}"
  local body http_code
  body="$(curl -sS -w '\n%{http_code}' --max-time 30 -X "$method" \
    -H 'Content-Type: application/json' --data "$json_body" "$url")" || fail "curl failed for ${url}"
  http_code="$(printf '%s\n' "$body" | tail -n1)"
  body="$(printf '%s\n' "$body" | sed '$d')"
  local code=""
  if printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    code="$(printf '%s' "$body" | jq -r '.code // empty')"
  fi
  if [[ "$http_code" == "404" ]]; then
    fail "not found"
  fi
  if [[ "$http_code" != "200" ]]; then
    fail "HTTP ${http_code} from ${url}: ${body}"
  fi
  if [[ -z "$code" || "$code" != "0" ]]; then
    fail "invalid API response from ${url}: ${body}"
  fi
  printf '%s' "$body"
}

# read_note_arg → resolves NOTE: "-" means read from stdin, else literal value.
# Trims a single trailing newline (mirrors Go readContentArg TrimRight "\n").
read_note_arg() {
  local text
  if [[ "$NOTE" == "-" ]]; then
    text="$(cat)"
  else
    text="$NOTE"
  fi
  # strip trailing newlines
  printf '%s' "${text%$'\n'}"
}

# emit compact JSON (+ newline) to stdout — the ONLY successful stdout write.
emit() {
  printf '%s\n' "$1" | jq -c .
}

# fetch_all_items PATH_PREFIX → prints a JSON array of all items across pages.
# PATH_PREFIX is like /api/projects or /api/persons (no query string).
fetch_all_items() {
  local path_prefix="$1"
  local page=1
  local page_size=100
  local all='[]'
  while true; do
    local body items total n
    body="$(api_get "${path_prefix}?page=${page}&page_size=${page_size}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -er '.data.total')"
    n="$(printf '%s' "$items" | jq -er 'length')"
    all="$(jq -nc --argjson a "$all" --argjson b "$items" '$a + $b')"
    if (( page * page_size >= total )) || (( n == 0 )); then
      break
    fi
    page=$((page + 1))
  done
  printf '%s' "$all"
}

# --- flag helpers -----------------------------------------------------------

CONFIG_DEFAULT="conf/config.yaml"
CONFIG_PATH="$CONFIG_DEFAULT"
ID=""
CODE=""
CHAT_ID=""
OPEN_ID=""
ROLE=""
PROJECT_ID=""
PERSON_OPEN_ID=""
PRINCIPAL_ONLY="false"
KEYWORD=""
NOTE="-"
NAME=""
STATUS=""
LIMIT="200"
PAYLOAD="-"
AT=""
REASON="-"
SOURCE=""
EXTERNAL_ID=""
TITLE=""
CONTENT="-"
OCCURRED_AT=""

reset_flags() {
  CONFIG_PATH="$CONFIG_DEFAULT"
  ID=""
  CODE=""
  CHAT_ID=""
  OPEN_ID=""
  ROLE=""
  PROJECT_ID=""
  PERSON_OPEN_ID=""
  PRINCIPAL_ONLY="false"
  KEYWORD=""
  NOTE="-"
  NAME=""
  STATUS=""
  LIMIT="200"
  PAYLOAD="-"
  AT=""
  REASON="-"
  SOURCE=""
  EXTERNAL_ID=""
  TITLE=""
  CONTENT="-"
  OCCURRED_AT=""
}

# parse_kv_flag NAME VALUE — supports --name value and --name=value via caller.
consume_flags() {
  # remaining args in "$@"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CONFIG_PATH="$2"
        shift 2
        ;;
      --config=*)
        CONFIG_PATH="${1#--config=}"
        shift
        ;;
      --id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ID="$2"
        shift 2
        ;;
      --id=*)
        ID="${1#--id=}"
        shift
        ;;
      --code)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CODE="$2"
        shift 2
        ;;
      --code=*)
        CODE="${1#--code=}"
        shift
        ;;
      --chat-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CHAT_ID="$2"
        shift 2
        ;;
      --chat-id=*)
        CHAT_ID="${1#--chat-id=}"
        shift
        ;;
      --open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        OPEN_ID="$2"
        shift 2
        ;;
      --open-id=*)
        OPEN_ID="${1#--open-id=}"
        shift
        ;;
      --role)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ROLE="$2"
        shift 2
        ;;
      --role=*)
        ROLE="${1#--role=}"
        shift
        ;;
      --project-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PROJECT_ID="$2"
        shift 2
        ;;
      --project-id=*)
        PROJECT_ID="${1#--project-id=}"
        shift
        ;;
      --person-open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PERSON_OPEN_ID="$2"
        shift 2
        ;;
      --person-open-id=*)
        PERSON_OPEN_ID="${1#--person-open-id=}"
        shift
        ;;
      --principal-only)
        PRINCIPAL_ONLY="true"
        shift
        ;;
      --keyword)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        KEYWORD="$2"
        shift 2
        ;;
      --keyword=*)
        KEYWORD="${1#--keyword=}"
        shift
        ;;
      --note)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        NOTE="$2"
        shift 2
        ;;
      --note=*)
        NOTE="${1#--note=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        NAME="$2"
        shift 2
        ;;
      --name=*)
        NAME="${1#--name=}"
        shift
        ;;
      --status)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        STATUS="$2"
        shift 2
        ;;
      --status=*)
        STATUS="${1#--status=}"
        shift
        ;;
      --limit)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        LIMIT="$2"
        shift 2
        ;;
      --limit=*)
        LIMIT="${1#--limit=}"
        shift
        ;;
      --payload)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PAYLOAD="$2"
        shift 2
        ;;
      --payload=*)
        PAYLOAD="${1#--payload=}"
        shift
        ;;
      --at)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        AT="$2"
        shift 2
        ;;
      --at=*)
        AT="${1#--at=}"
        shift
        ;;
      --reason)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        REASON="$2"
        shift 2
        ;;
      --reason=*)
        REASON="${1#--reason=}"
        shift
        ;;
      --source)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SOURCE="$2"
        shift 2
        ;;
      --source=*)
        SOURCE="${1#--source=}"
        shift
        ;;
      --external-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        EXTERNAL_ID="$2"
        shift 2
        ;;
      --external-id=*)
        EXTERNAL_ID="${1#--external-id=}"
        shift
        ;;
      --title)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        TITLE="$2"
        shift 2
        ;;
      --title=*)
        TITLE="${1#--title=}"
        shift
        ;;
      --content)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CONTENT="$2"
        shift 2
        ;;
      --content=*)
        CONTENT="${1#--content=}"
        shift
        ;;
      --occurred-at)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        OCCURRED_AT="$2"
        shift 2
        ;;
      --occurred-at=*)
        OCCURRED_AT="${1#--occurred-at=}"
        shift
        ;;
      -*)
        fail "unknown flag: $1"
        ;;
      *)
        fail "unexpected argument: $1"
        ;;
    esac
  done
}

# --- subcommands ------------------------------------------------------------

cmd_list_projects() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local items
  items="$(fetch_all_items /api/projects)"
  emit "$(jq -cn --argjson projects "$items" '{projects:$projects}')"
}

cmd_get_project() {
  reset_flags
  consume_flags "$@"
  local has_id=0 has_code=0
  [[ -n "$ID" ]] && has_id=1
  [[ -n "$CODE" ]] && has_code=1
  if (( has_id + has_code != 1 )); then
    fail "get-project requires exactly one of --id or --code"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  if (( has_id )); then
    [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "get-project --id must be a positive integer"
    local body project events relations
    body="$(api_get "/api/projects/${ID}")"
    project="$(printf '%s' "$body" | jq -c '.data')"
    events="$(api_get "/api/projects/${ID}/events" | jq -c '.data.items[:50]')"
    relations="$(api_get "/api/relation-facts?entity_type=project&entity_id=${ID}&page=1&page_size=100" | jq -c '.data.items')"
    emit "$(jq -cn --argjson project "$project" --argjson events "$events" --argjson relations "$relations" '{project:$project,project_events:$events,relation_facts:$relations}')"
    return
  fi
  local items matched
  items="$(fetch_all_items /api/projects)"
  matched="$(printf '%s' "$items" | jq -c --arg code "$CODE" '[.[] | select(.code == $code)]')"
  local n
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple projects matched code=${CODE}"
  fi
  local project project_id events relations
  project="$(printf '%s' "$matched" | jq -c '.[0]')"
  project_id="$(printf '%s' "$project" | jq -er '.id')"
  events="$(api_get "/api/projects/${project_id}/events" | jq -c '.data.items[:50]')"
  relations="$(api_get "/api/relation-facts?entity_type=project&entity_id=${project_id}&page=1&page_size=100" | jq -c '.data.items')"
  emit "$(jq -cn --argjson project "$project" --argjson events "$events" --argjson relations "$relations" '{project:$project,project_events:$events,relation_facts:$relations}')"
}

cmd_get_group() {
  reset_flags
  consume_flags "$@"
  if [[ -z "$CHAT_ID" ]]; then
    fail "get-group requires --chat-id"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  # /api/groups has no by-chat-id GET; keyword searches chat_id (and name/...).
  # Use keyword to narrow, then exact-match on chat_id (fail-fast if missing).
  local enc body matched n
  enc="$(jq -rn --arg s "$CHAT_ID" '$s|@uri')"
  body="$(api_get "/api/groups?keyword=${enc}&page=1&page_size=100")"
  matched="$(printf '%s' "$body" | jq -c --arg cid "$CHAT_ID" '[.data.items[] | select(.chat_id == $cid)]')"
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple groups matched chat_id=${CHAT_ID}"
  fi
  emit "$(printf '%s' "$matched" | jq -c '.[0]')"
}

cmd_get_principal() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_get /api/profile)"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_list_persons() {
  reset_flags
  consume_flags "$@"
  if [[ -n "$ROLE" && ! "$ROLE" =~ ^(leader|key|colleague|other)$ ]]; then
    fail "list-persons --role must be leader, key, colleague or other"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local items
  items="$(fetch_all_items /api/persons)"
  if [[ -n "$ROLE" ]]; then
    items="$(printf '%s' "$items" | jq -c --arg role "$ROLE" '[.[] | select(.role == $role)]')"
  fi
  emit "$(jq -cn --argjson persons "$items" '{persons:$persons}')"
}

cmd_get_person() {
  reset_flags
  consume_flags "$@"
  if [[ -z "$OPEN_ID" ]]; then
    fail "get-person requires --open-id"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  # GET /api/persons/:id is DB id, not open_id — list + filter.
  local items matched n
  items="$(fetch_all_items /api/persons)"
  matched="$(printf '%s' "$items" | jq -c --arg oid "$OPEN_ID" '[.[] | select(.open_id == $oid)]')"
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple persons matched open_id=${OPEN_ID}"
  fi
  local person person_id relations
  person="$(printf '%s' "$matched" | jq -c '.[0]')"
  person_id="$(printf '%s' "$person" | jq -er '.id')"
  relations="$(api_get "/api/relation-facts?entity_type=person&entity_id=${person_id}&page=1&page_size=100" | jq -c '.data.items')"
  emit "$(jq -cn --argjson person "$person" --argjson relations "$relations" '{person:$person,relation_facts:$relations}')"
}

cmd_query_resources() {
  reset_flags
  consume_flags "$@"
  [[ "$LIMIT" =~ ^[1-9][0-9]*$ ]] || fail "query-resources --limit must be a positive integer"
  if [[ -n "$PROJECT_ID" && ! "$PROJECT_ID" =~ ^[1-9][0-9]*$ ]]; then
    fail "query-resources --project-id must be a positive integer"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"

  local person_id=""
  if [[ -n "$PERSON_OPEN_ID" ]]; then
    local persons matched n
    persons="$(fetch_all_items /api/persons)"
    matched="$(printf '%s' "$persons" | jq -c --arg oid "$PERSON_OPEN_ID" '[.[] | select(.open_id == $oid)]')"
    n="$(printf '%s' "$matched" | jq -er 'length')"
    (( n == 1 )) || fail "query-resources expected exactly one person for open_id=${PERSON_OPEN_ID}, got ${n}"
    person_id="$(printf '%s' "$matched" | jq -er '.[0].id')"
  fi

  local items filtered
  items="$(fetch_all_items /api/resources)"
  filtered="$(printf '%s' "$items" | jq -c \
    --arg project_id "$PROJECT_ID" \
    --arg person_id "$person_id" \
    --arg principal_only "$PRINCIPAL_ONLY" \
    --arg keyword "$KEYWORD" \
    --argjson limit "$LIMIT" '
      [.[]
       | select(.is_active == true)
       | select($project_id == "" or (.project_id | tostring) == $project_id)
       | select($person_id == "" or (.person_id | tostring) == $person_id)
       | select($principal_only != "true" or .link_principal == true)
       | select(
           $keyword == ""
           or (([
             .title, .resource_type, .url, .description, .person_name, .project_name
           ] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase))
         )
      ][: $limit]')"
  emit "$(jq -cn --argjson resources "$filtered" '{count:($resources|length),resources:$resources}')"
}

cmd_get_shared_memory() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_get /api/shared-memory)"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_get_skill() {
  reset_flags
  consume_flags "$@"
  [[ -n "$NAME" ]] || fail "get-skill requires --name"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local enc body
  enc="$(jq -rn --arg s "$NAME" '$s|@uri')"
  body="$(api_get "/api/skills/${enc}/content")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# append-shared-memory uses one server-side append operation so concurrent agents
# cannot overwrite each other's entries.
cmd_append_shared_memory() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local note
  note="$(read_note_arg)"
  if [[ -z "${note//[[:space:]]/}" ]]; then
    fail "append-shared-memory note is empty"
  fi
  local payload body
  payload="$(jq -cn --arg note "$note" '{note:$note}')"
  body="$(api_write POST /api/shared-memory/append "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# append-clue hands M2 a raw observed fact. The server owns idempotency, so a
# producer can safely redeliver the same (source, external-id) on every run.
cmd_append_clue() {
  reset_flags
  consume_flags "$@"
  [[ -n "$SOURCE" ]] || fail "append-clue requires --source"
  [[ -n "$EXTERNAL_ID" ]] || fail "append-clue requires --external-id"
  [[ -n "$TITLE" ]] || fail "append-clue requires --title"
  local content
  if [[ "$CONTENT" == "-" ]]; then
    content="$(cat)"
  else
    content="$CONTENT"
  fi
  content="${content%$'\n'}"
  local occurred_at="$OCCURRED_AT"
  if [[ -z "$occurred_at" ]]; then
    occurred_at="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --arg source "$SOURCE" --arg external_id "$EXTERNAL_ID" \
    --arg title "$TITLE" --arg content "$content" --arg occurred_at "$occurred_at" \
    '{source:$source,external_id:$external_id,title:$title,content:$content,occurred_at:$occurred_at}')"
  body="$(api_write POST /api/clues "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_list_scheduled_tasks() {
  reset_flags
  consume_flags "$@"
  [[ "$LIMIT" =~ ^[1-9][0-9]*$ ]] || fail "list-scheduled-tasks --limit must be a positive integer"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local query="?limit=${LIMIT}"
  if [[ -n "$STATUS" ]]; then
    local enc
    enc="$(jq -rn --arg s "$STATUS" '$s|@uri')"
    query="${query}&status=${enc}"
  fi
  local body
  body="$(api_get "/api/scheduled-tasks${query}")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_create_scheduled_task() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 || fail "create-scheduled-task payload must be a JSON object"
  body="$(api_write POST /api/scheduled-tasks "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_yield_until() {
  reset_flags
  consume_flags "$@"
  [[ "${JARVIS_TASK_ID:-}" =~ ^[1-9][0-9]*$ ]] || fail "yield-until requires JARVIS_TASK_ID from the Task runner"
  [[ -n "$AT" ]] || fail "yield-until requires --at"
  local reason
  if [[ "$REASON" == "-" ]]; then
    reason="$(cat)"
  else
    reason="$REASON"
  fi
  [[ -n "${reason//[[:space:]]/}" ]] || fail "yield-until reason is empty"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --argjson task_id "$JARVIS_TASK_ID" --arg run_at "$AT" --arg reason "$reason" \
    '{task_id:$task_id,run_at:$run_at,reason:$reason}')"
  body="$(api_write POST /api/scheduled-tasks/yield "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_delete_scheduled_task() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "delete-scheduled-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write DELETE "/api/scheduled-tasks/${ID}" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# --- main -------------------------------------------------------------------

[[ $# -ge 1 ]] || usage_error
SUBCOMMAND="$1"
shift

if [[ "$SUBCOMMAND" == "--help" || "$SUBCOMMAND" == "-h" ]]; then
  print_usage
  exit 0
fi
if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  if ! print_subcommand_help "$SUBCOMMAND"; then
    fail "unknown subcommand \"${SUBCOMMAND}\""
  fi
  exit 0
fi

case "$SUBCOMMAND" in
  list-projects)  cmd_list_projects "$@" ;;
  get-project)    cmd_get_project "$@" ;;
  get-group)      cmd_get_group "$@" ;;
  get-principal)  cmd_get_principal "$@" ;;
  list-persons)   cmd_list_persons "$@" ;;
  get-person)     cmd_get_person "$@" ;;
  query-resources)      cmd_query_resources "$@" ;;
  get-shared-memory)    cmd_get_shared_memory "$@" ;;
  get-skill)            cmd_get_skill "$@" ;;
  append-shared-memory) cmd_append_shared_memory "$@" ;;
  append-clue)          cmd_append_clue "$@" ;;
  list-scheduled-tasks) cmd_list_scheduled_tasks "$@" ;;
  create-scheduled-task) cmd_create_scheduled_task "$@" ;;
  yield-until)          cmd_yield_until "$@" ;;
  delete-scheduled-task) cmd_delete_scheduled_task "$@" ;;
  *)
    fail "unknown subcommand \"${SUBCOMMAND}\"; run jarvis-tools --help"
    ;;
esac
