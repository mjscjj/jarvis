  local command_name="$1" description="$2"
  printf 'usage: jarvis-tools %s --id ID [--config PATH]\n%s\n' "$command_name" "$description"
}

# resolve_config_path CONFIG_PATH → prints the existing config path.
resolve_config_path() {
  local config_path="$1"
  local resolved=""
  if [[ -f "$config_path" ]]; then
    resolved="$config_path"
  elif [[ "$config_path" != /* && -f "${REPO_ROOT}/${config_path}" ]]; then
    resolved="${REPO_ROOT}/${config_path}"
  fi
  if [[ -z "$resolved" ]]; then
    fail "config file not found: ${config_path}"
  fi
  printf '%s' "$resolved"
}

# resolve_api_base CONFIG_PATH
# Prefer JARVIS_API_BASE; otherwise require and read server.addr from config.
resolve_api_base() {
  local config_path="$1"
  if [[ -n "${JARVIS_API_BASE:-}" ]]; then
    echo "${JARVIS_API_BASE%/}"
    return
  fi
  local resolved
  resolved="$(resolve_config_path "$config_path")" || return 1
  local addr
  addr="$(grep -E '^\s*addr:\s*' "$resolved" | head -n1 | sed -E 's/^[[:space:]]*addr:[[:space:]]*"?([^"#]+)"?.*/\1/' | tr -d '[:space:]')"
  if [[ -z "$addr" ]]; then
    fail "could not parse server.addr from ${resolved}"
  fi
  # 0.0.0.0 is a bind address, not a stable client destination. Local tools
  # should connect through loopback even when the server listens on all IPv4
  # interfaces.
  if [[ "$addr" == 0.0.0.0:* ]]; then
    addr="127.0.0.1:${addr#*:}"
  fi
  echo "http://${addr}"
}

# resolve_timezone CONFIG_PATH → prints the configured business timezone.
resolve_timezone() {
  if [[ -n "${JARVIS_TIMEZONE:-}" ]]; then
    printf '%s' "$JARVIS_TIMEZONE"
    return
  fi
  local resolved timezone
  resolved="$(resolve_config_path "$1")" || return 1
  timezone="$(awk '
    /^[^[:space:]#][^:]*:/ {
      section = $0
      sub(/:.*/, "", section)
    }
    section == "capture" && /^[[:space:]]+timezone:[[:space:]]*/ {
      value = $0
      sub(/^[[:space:]]*timezone:[[:space:]]*/, "", value)
      sub(/[[:space:]]+#.*/, "", value)
      gsub(/^["'\'']|["'\'']$/, "", value)
      print value
      exit
    }
  ' "$resolved")"
  [[ -n "$timezone" ]] || fail "could not parse capture.timezone from ${resolved}"
  printf '%s' "$timezone"
}

# api_get PATH_AND_QUERY → prints response body to stdout; fails on HTTP/API error.
api_get() {
  local path_and_query="$1"
  local url="${API_BASE}${path_and_query}"
  local body http_code
  body="$(curl -sS -w '\n%{http_code}' --max-time 30 "$url")" || fail "curl failed for ${url}"
  http_code="$(printf '%s\n' "$body" | tail -n1)"
  body="$(printf '%s\n' "$body" | sed '$d')"
  local code=""
  if printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    code="$(printf '%s' "$body" | jq -r '.code // empty')"
  fi
  # Align with Go jarvis-tools mapNotFound → "not found".
  if [[ "$http_code" == "404" || "$code" == "40420" ]]; then
    fail "not found"
  fi
  if [[ "$http_code" != "200" ]]; then
    fail "HTTP ${http_code} from ${url}: ${body}"
  fi
  if [[ -z "$code" ]]; then
    fail "invalid JSON from ${url}"
  fi
  if [[ "$code" != "0" ]]; then
    fail "API code=${code} from ${url}: ${body}"
  fi
  printf '%s' "$body"
}

# api_write METHOD PATH JSON_BODY → prints response body to stdout.
api_write() {
  local method="$1"
  local path="$2"
  local json_body="$3"
  local timeout="${4:-30}"
  local url="${API_BASE}${path}"
  local body http_code
  body="$(printf '%s' "$json_body" | curl -sS -w '\n%{http_code}' --max-time "$timeout" -X "$method" \
    -H 'Content-Type: application/json' --data-binary @- "$url")" || fail "curl failed for ${url}"
  http_code="$(printf '%s\n' "$body" | tail -n1)"
  body="$(printf '%s\n' "$body" | sed '$d')"
  local code=""
  if printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    code="$(printf '%s' "$body" | jq -r '.code // empty')"
  fi
  if [[ "$http_code" == "404" ]]; then
    fail "not found"
  fi
  if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    fail "HTTP ${http_code} from ${url}: ${body}"
  fi
  if [[ -z "$body" && "$http_code" == "204" ]]; then
    body='{"code":0,"data":null}'
    code="0"
  fi
  if [[ -z "$code" || "$code" != "0" ]]; then
    fail "invalid API response from ${url}: ${body}"
  fi
  printf '%s' "$body"
}

# read_note_arg → resolves NOTE: "-" means read from stdin, else literal value.
# Trims a single trailing newline (mirrors Go readContentArg TrimRight "\n").
read_note_arg() {
  local text
  if [[ "$NOTE" == "-" ]]; then
    text="$(cat)"
  else
    text="$NOTE"
  fi
  # strip trailing newlines
  printf '%s' "${text%$'\n'}"
}

# read_payload_object resolves PAYLOAD and validates the one shared contract used
# by world-model writes. The server remains the owner of each payload's fields.
read_payload_object() {
  local command_name="$1" payload
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 ||
    fail "${command_name} payload must be a JSON object"
  printf '%s' "$payload"
}

# Entity control-field updates do not write long-term facts. summary belongs to
# update-page; reject it here rather than let it silently travel to the server.
forbid_summary_payload() {
  local command_name="$1" payload="$2"
  if printf '%s' "$payload" | jq -e 'has("summary")' >/dev/null 2>&1; then
    fail "${command_name} does not accept summary; use update-page for long-term facts"
  fi
}

# Emit compact projected JSON (+ newline) to stdout.
emit() {
  printf '%s\n' "$1" | jq -c .
}

# Frozen evidence and run results must bypass jq's floating-point conversion.
emit_api_data() {
  command -v node >/dev/null 2>&1 || fail "node is required for exact JSON evidence reads"
  local body
  body="$(api_get "$1")" || return
  printf '%s' "$body" | node "${SCRIPT_DIR}/json-api-data.mjs"
}

# fetch_all_items PATH_PREFIX [QUERY] → prints all items across pages. QUERY is
# passed to every page, without the leading question mark.
fetch_all_items() {
  local path_prefix="$1"
  local query="${2:-}"
  local page=1
  local page_size=100
  local all='[]'
  while true; do
    local body items total n
    local page_query="page=${page}&page_size=${page_size}"
    if [[ -n "$query" ]]; then
      page_query="${query}&${page_query}"
    fi
    body="$(api_get "${path_prefix}?${page_query}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -er '.data.total')"
    n="$(printf '%s' "$items" | jq -er 'length')"
    all="$(jq -nc --argjson a "$all" --argjson b "$items" '$a + $b')"
    if (( page * page_size >= total )) || (( n == 0 )); then
      break
    fi
    page=$((page + 1))
  done
  printf '%s' "$all"
}

