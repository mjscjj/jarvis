# append-shared-memory uses one server-side append operation so concurrent agents
# cannot overwrite each other's entries.
cmd_append_shared_memory() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local note
  note="$(read_note_arg)"
  if [[ -z "${note//[[:space:]]/}" ]]; then
    fail "append-shared-memory note is empty"
  fi
  local payload body
  payload="$(jq -cn --arg note "$note" '{note:$note}')"
  body="$(api_write POST /api/shared-memory/append "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# append-clue hands M2 a raw observed fact. The server owns idempotency, so a
# producer can safely redeliver the same (source, external-id) on every run.
cmd_append_clue() {
  reset_flags
  consume_flags "$@"
  [[ -n "$SOURCE" ]] || fail "append-clue requires --source"
  [[ -n "$EXTERNAL_ID" ]] || fail "append-clue requires --external-id"
  [[ -n "$TITLE" ]] || fail "append-clue requires --title"
  local content
  if [[ "$CONTENT" == "-" ]]; then
    content="$(cat)"
  else
    content="$CONTENT"
  fi
  content="${content%$'\n'}"
  local occurred_at="$OCCURRED_AT"
  if [[ -z "$occurred_at" ]]; then
    occurred_at="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(printf '%s' "$content" | jq -Rsc --arg source "$SOURCE" --arg external_id "$EXTERNAL_ID" \
    --arg title "$TITLE" --arg occurred_at "$occurred_at" \
    '{source:$source,external_id:$external_id,title:$title,content:.,occurred_at:$occurred_at}')"
  body="$(api_write POST /api/clues "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# append-fact records one thing that happened about a subject.
cmd_append_fact() {
  reset_flags
  consume_flags "$@"
  [[ -n "$SUBJECT_TYPE" ]] || fail "append-fact requires --subject-type"
  [[ "$SUBJECT_ID" =~ ^[1-9][0-9]*$ ]] || fail "append-fact requires a positive --subject-id"
  local description
  if [[ "$DESCRIPTION" == "-" ]]; then
    description="$(cat)"
  else
    description="$DESCRIPTION"
  fi
  description="${description%$'\n'}"
  [[ -n "${description//[[:space:]]/}" ]] || fail "append-fact description is empty"
  local occurred_at="$OCCURRED_AT"
  if [[ -z "$occurred_at" ]]; then
    occurred_at="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  fi
  local source_kind="$SOURCE"
  local source_id="null"
  [[ -n "$source_kind" ]] || fail "append-fact requires --source"
  if [[ -n "$SOURCE_ID" ]]; then
    [[ "$SOURCE_ID" =~ ^[1-9][0-9]*$ ]] || fail "append-fact --source-id must be a positive integer"
    source_id="$SOURCE_ID"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --arg subject_type "$SUBJECT_TYPE" --argjson subject_id "$SUBJECT_ID" \
    --arg description "$description" --arg occurred_at "$occurred_at" \
    --arg source_kind "$source_kind" --argjson source_id "$source_id" \
    '{subject_type:$subject_type,subject_id:$subject_id,description:$description,occurred_at:$occurred_at,
      source_kind:(if $source_kind=="" then null else $source_kind end),source_id:$source_id}')"
  body="$(api_write POST /api/facts "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_append_facts_batch() {
  reset_flags
  consume_flags "$@"
  local payload occurred_at normalized
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  occurred_at="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  normalized="$(printf '%s' "$payload" | jq -ce \
    --arg occurred_at "$occurred_at" '
      def nonblank: type == "string" and test("[^[:space:]]");
      def positive_integer: type == "number" and . > 0 and floor == .;
      if type != "array" or length == 0 then
        error("payload must be a non-empty JSON array")
      else
        map(
          if type != "object" then
            error("every fact must be a JSON object")
          elif ((keys_unsorted - ["subject_type", "subject_id", "description", "occurred_at", "source", "source_id"]) | length) != 0 then
            error("fact contains an unknown field")
          elif (.subject_type | nonblank) | not then
            error("subject_type must be a non-empty string")
          elif (.subject_id | positive_integer) | not then
            error("subject_id must be a positive integer")
          elif (.description | nonblank) | not then
            error("description must be a non-empty string")
          elif (has("occurred_at") and .occurred_at != null and (.occurred_at | type != "string")) then
            error("occurred_at must be a string or null")
          elif (.source | nonblank) | not then
            error("source must be a non-empty string")
          elif (has("source_id") and .source_id != null and ((.source_id | positive_integer) | not)) then
            error("source_id must be a positive integer or null")
          else
            {
              subject_type: .subject_type,
              subject_id: .subject_id,
              description: .description,
              occurred_at: (if ((.occurred_at // "") == "") then $occurred_at else .occurred_at end),
              source_kind: .source,
              source_id: (.source_id // null)
            }
          end
        )
      end
    ')" || fail "append-facts-batch payload is invalid"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  body="$(api_write POST /api/facts/batch "$normalized")"
  emit "$(printf '%s' "$body" | jq -c '.data.items')"
}

# local_day_bounds DATE CMD — resolve YYYY-MM-DD to RFC3339 half-open [from, until)
# in JARVIS_TIMEZONE when provided, otherwise the host timezone. Support both
# GNU date (Linux) and BSD date (macOS), including 23/25-hour DST days.
local_day_bounds() {
  local date="$1" cmd="$2" config_path="$3" timezone
  [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail "${cmd} --date must be YYYY-MM-DD"
  timezone="$(resolve_timezone "$config_path")" || return 1
  local from until
  local -a date_command=(env "TZ=$timezone" date)
  if date --version >/dev/null 2>&1; then
    from="$("${date_command[@]}" -d "$date" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)" ||
      fail "${cmd} could not parse --date $date"
    until="$("${date_command[@]}" -d "$date +1 day" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)" ||
      fail "${cmd} could not advance --date $date"
  else
    from="$("${date_command[@]}" -j -f '%Y-%m-%d %H:%M:%S' "$date 00:00:00" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)" ||
      fail "${cmd} could not parse --date $date"
    until="$("${date_command[@]}" -j -v+1d -f '%Y-%m-%d %H:%M:%S' "$date 00:00:00" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)" ||
      fail "${cmd} could not advance --date $date"
  fi
  [[ "${from:0:10}" == "$date" ]] || fail "${cmd} could not parse --date $date"
  from="$(printf '%s' "$from" | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  until="$(printf '%s' "$until" | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  printf '%s %s' "$from" "$until"
}

# list-facts reads one subject's recorded facts, newest first. --date narrows to
# one natural day in local time; the API takes explicit bounds so the day is
# resolved here rather than assumed by the server.
cmd_list_facts() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  [[ -n "$SUBJECT_TYPE" ]] || fail "list-facts requires --subject-type"
  [[ "$SUBJECT_ID" =~ ^[1-9][0-9]*$ ]] || fail "list-facts requires a positive --subject-id"
  require_limit list-facts "$LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local enc_type query
  enc_type="$(jq -rn --arg s "$SUBJECT_TYPE" '$s|@uri')"
  query="?subject_type=${enc_type}&subject_id=${SUBJECT_ID}&limit=${LIMIT}"
  if [[ -n "$DATE" ]]; then
    local bounds from until
    bounds="$(local_day_bounds "$DATE" list-facts "$CONFIG_PATH")" || return 1
    read -r from until <<<"$bounds"
    query="${query}&from=$(jq -rn --arg s "$from" '$s|@uri')&until=$(jq -rn --arg s "$until" '$s|@uri')"
  fi
  local body
  body="$(api_get "/api/facts${query}")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_get_page() {
  reset_flags
  consume_flags "$@"
  require_page_type get-page "$TYPE"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "get-page requires a positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_get "/api/pages/${TYPE}/${ID}")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_update_page() {
  reset_flags
  consume_flags "$@"
  require_page_type update-page "$TYPE"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "update-page requires a positive --id"
  [[ -n "$IF_UNCHANGED_SINCE" ]] || fail "update-page requires --if-unchanged-since"
  local content
  if [[ "$CONTENT" == "-" ]]; then
    content="$(cat)"
  else
    content="$CONTENT"
  fi
  content="${content%$'\n'}"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload url body http_code code
  payload="$(jq -cn --arg content "$content" --arg if_unchanged_since "$IF_UNCHANGED_SINCE" \
    '{content:$content,if_unchanged_since:$if_unchanged_since}')"
  url="${API_BASE}/api/pages/${TYPE}/${ID}"
  body="$(curl -sS -w '\n%{http_code}' --max-time 30 -X PUT \
    -H 'Content-Type: application/json' --data "$payload" "$url")" || fail "curl failed for ${url}"
  http_code="$(printf '%s\n' "$body" | tail -n1)"
  body="$(printf '%s\n' "$body" | sed '$d')"
  if [[ "$http_code" == "404" ]]; then
    fail "not found"
  fi
  if [[ "$http_code" == "409" ]]; then
    fail "update-page conflict (HTTP 409); current page: ${body}"
  fi
  if [[ "$http_code" != "200" ]]; then
    fail "HTTP ${http_code} from ${url}: ${body}"
  fi
  if printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    code="$(printf '%s' "$body" | jq -r '.code // empty')"
  fi
  if [[ -z "${code:-}" || "$code" != "0" ]]; then
    fail "invalid API response from ${url}: ${body}"
  fi
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_list_pages() {
  reset_flags
  consume_flags "$@"
  if [[ -n "$TYPE" ]]; then
    require_page_type list-pages "$TYPE"
  fi
  if [[ -n "$STALE_DAYS" ]]; then
    [[ "$STALE_DAYS" =~ ^[1-9][0-9]*$ ]] || fail "list-pages --stale-days must be a positive integer"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local query="" sep="?"
  if [[ -n "$TYPE" ]]; then
    query="${query}${sep}type=$(jq -rn --arg s "$TYPE" '$s|@uri')"
    sep="&"
  fi
  if [[ "$ALL" == "true" ]]; then
    query="${query}${sep}all=true"
    sep="&"
  fi
  if [[ -n "$STALE_DAYS" ]]; then
    query="${query}${sep}stale_days=${STALE_DAYS}"
    sep="&"
  fi
  if [[ "$OVER_LIMIT" == "true" ]]; then
    query="${query}${sep}over_limit=true"
    sep="&"
  fi
  local body
  body="$(api_get "/api/pages${query}")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

