cmd_create_task() {
  reset_flags
  consume_flags "$@"
  [[ "${JARVIS_AGENT_STAGE:-}" == "proactive" ]] || fail "create-task is only available to the proactive Agent"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 || fail "create-task payload must be a JSON object"
  payload="$(printf '%s' "$payload" | jq -c '. + {source_type:"proactive"}')"
  body="$(api_write POST /api/tasks "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_start_task() {
  reset_flags
  consume_flags "$@"
  [[ "${JARVIS_AGENT_STAGE:-}" == "proactive" ]] || fail "start-task is only available to the proactive Agent"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "start-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write POST "/api/tasks/${ID}/execute" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_update_task() {
  reset_flags
  consume_flags "$@"
  [[ "${JARVIS_AGENT_STAGE:-}" == "proactive" ]] || fail "update-task is only available to the proactive Agent"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "update-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e '
    type == "object" and
    (.expected_version | type == "number" and . >= 0 and floor == .) and
    (.reason | type == "string" and length > 0) and
    (has("title") or has("target") or has("summary") or has("instruction")) and
    ((has("title") | not) or (.title | type == "string" and length > 0)) and
    ((has("target") | not) or (.target | type == "string")) and
    ((has("summary") | not) or (.summary | type == "string" and length > 0)) and
    ((has("instruction") | not) or (.instruction | type == "string" and length > 0))
  ' >/dev/null 2>&1 || fail "update-task payload requires expected_version, reason and at least one mutable Task field"
  body="$(api_write PATCH "/api/tasks/${ID}" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_close_task() {
  reset_flags
  consume_flags "$@"
  [[ "${JARVIS_AGENT_STAGE:-}" == "proactive" ]] || fail "close-task is only available to the proactive Agent"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "close-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e '
    type == "object" and
    (.expected_version | type == "number" and . >= 0 and floor == .) and
    (.result | type == "object" and (.summary | type == "string" and length > 0))
  ' >/dev/null 2>&1 || fail "close-task payload requires non-negative expected_version and non-empty result.summary"
  body="$(api_write POST "/api/tasks/${ID}/close" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_create_scheduled_task() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 || fail "create-scheduled-task payload must be a JSON object"
  body="$(api_write POST /api/scheduled-tasks "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_update_scheduled_task() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "update-scheduled-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 || fail "update-scheduled-task payload must be a JSON object"
  body="$(api_write PUT "/api/scheduled-tasks/${ID}" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_trigger_scheduled_task() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "trigger-scheduled-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write POST "/api/scheduled-tasks/${ID}/trigger" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# set-todo-status parks a clue or hands it back to Task materialization. The server
# owns which transitions are legal; this only names the caller and the reason.
cmd_set_todo_status() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "set-todo-status requires positive --id"
  case "$STATUS" in
    observing|extracted) ;;
    *) fail "set-todo-status --status must be observing or extracted" ;;
  esac
  local reason
  if [[ "$REASON" == "-" ]]; then
    reason="$(cat)"
  else
    reason="$REASON"
  fi
  [[ -n "${reason//[[:space:]]/}" ]] || fail "set-todo-status reason is empty"
  local actor="$ACTOR"
  if [[ -z "$actor" ]]; then
    actor="${JARVIS_AGENT_STAGE:-}"
  fi
  [[ -n "${actor//[[:space:]]/}" ]] || fail "set-todo-status requires --actor outside a Jarvis Agent process"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --arg status "$STATUS" --arg actor "$actor" --arg reason "$reason" \
    '{status:$status,actor:$actor,reason:$reason}')"
  body="$(api_write PATCH "/api/todos/${ID}/status" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_yield_until() {
  reset_flags
  consume_flags "$@"
  [[ "${JARVIS_TASK_ID:-}" =~ ^[1-9][0-9]*$ ]] || fail "yield-until requires JARVIS_TASK_ID from the Task runner"
  [[ -n "$AT" ]] || fail "yield-until requires --at"
  local reason
  if [[ "$REASON" == "-" ]]; then
    reason="$(cat)"
  else
    reason="$REASON"
  fi
  [[ -n "${reason//[[:space:]]/}" ]] || fail "yield-until reason is empty"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --argjson task_id "$JARVIS_TASK_ID" --arg run_at "$AT" --arg reason "$reason" \
    '{task_id:$task_id,run_at:$run_at,reason:$reason}')"
  body="$(api_write POST /api/scheduled-tasks/yield "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_delete_scheduled_task() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "delete-scheduled-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write DELETE "/api/scheduled-tasks/${ID}" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# --- main -------------------------------------------------------------------

[[ $# -ge 1 ]] || usage_error
SUBCOMMAND="$1"
shift

if [[ "$SUBCOMMAND" == "--help" || "$SUBCOMMAND" == "-h" ]]; then
  print_usage
  exit 0
fi
if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  if ! print_subcommand_help "$SUBCOMMAND"; then
    fail "unknown subcommand \"${SUBCOMMAND}\""
  fi
  exit 0
fi

case "$SUBCOMMAND" in
  list-projects)  cmd_list_projects "$@" ;;
  get-project)    cmd_get_project "$@" ;;
  create-project) cmd_payload_create create-project POST /api/projects "$@" ;;
  update-project) cmd_payload_by_id update-project PUT /api/projects "$@" ;;
  archive-project) cmd_delete_by_id archive-project /api/projects "$@" ;;
  list-key-matters) cmd_list_key_matters "$@" ;;
