# Each command declares its own accepted flags. The parser is shared, but a flag
# that belongs to another command is an error rather than an ignored no-op.
require_command_flag() {
  local cmd="$1" flag="$2"
  local allowed="--config"
  case "$cmd" in
    list-projects | list-key-matters) allowed+=" --keyword --limit" ;;
    list-delegations) allowed+=" --state --query --page --limit" ;;
    get-delegation) allowed+=" --id" ;;
    update-delegation) allowed+=" --id --payload" ;;
    list-delegation-tasks) allowed+=" --id --page --limit" ;;
    get-project) allowed+=" --id --code" ;;
    get-key-matter | touch-key-matter | touch-resource) allowed+=" --id" ;;
    create-project | create-key-matter | update-principal | create-person | create-resource | create-task) allowed+=" --payload" ;;
    notice-principal) allowed+=" --payload --payload-file" ;;
    update-project | update-key-matter | update-group | update-person | update-resource) allowed+=" --id --payload" ;;
    archive-project | close-key-matter | delete-person | delete-resource) allowed+=" --id" ;;
    list-groups) allowed+=" --keyword --limit" ;;
    get-group) allowed+=" --chat-id" ;;
    get-context) allowed+=" --chat-id --project-id" ;;
    get-principal | get-shared-memory) ;;
    list-persons) allowed+=" --role --keyword --limit" ;;
    get-person) allowed+=" --open-id" ;;
    query-resources) allowed+=" --project-id --person-open-id --principal-only --keyword --limit" ;;
    get-resource) allowed+=" --id" ;;
    query-messages) allowed+=" --chat-id --sender-open-id --keyword --date --limit --message-ids" ;;
    get-message | get-todo-event | get-task-event) allowed+=" --id" ;;
    query-captured-resources) allowed+=" --chat-id --message-id --resource-type --keyword --limit" ;;
    get-captured-resource) allowed+=" --id" ;;
    list-skills) allowed+=" --keyword" ;;
    get-skill) allowed+=" --name" ;;
    set-shared-memory) allowed+=" --content" ;;
    append-shared-memory) allowed+=" --note" ;;
    append-clue) allowed+=" --source --external-id --title --content --occurred-at" ;;
    append-fact) allowed+=" --subject-type --subject-id --description --occurred-at --source --source-id" ;;
    append-facts-batch) allowed+=" --payload" ;;
    list-facts) allowed+=" --subject-type --subject-id --date --limit" ;;
    get-page | list-backlinks) allowed+=" --type --id" ;;
    update-page) allowed+=" --type --id --content --if-unchanged-since" ;;
    list-pages) allowed+=" --type --all --stale-days --over-limit" ;;
    list-todos) allowed+=" --date --status --limit --project-id --group-id --page --query --source-message-id" ;;
    get-todo) allowed+=" --id --context --message-id --revision" ;;
    list-tasks) allowed+=" --date --status --limit --project-id --group-id --page --query --source-message-id --action-type" ;;
    get-task) allowed+=" --id --context --message-id" ;;
    list-task-runs) allowed+=" --id --page --limit" ;;
    get-task-run) allowed+=" --id --include-prompt" ;;
    start-task) allowed+=" --id" ;;
    update-task) allowed+=" --id --payload" ;;
    close-task) allowed+=" --id --payload" ;;
    list-scheduled-tasks) allowed+=" --status --limit" ;;
    get-scheduled-task) allowed+=" --id" ;;
    create-scheduled-task) allowed+=" --payload" ;;
    update-scheduled-task) allowed+=" --id --payload" ;;
    trigger-scheduled-task) allowed+=" --id" ;;
    set-todo-status) allowed+=" --id --status --reason --actor" ;;
    yield-until) allowed+=" --at --reason" ;;
    delete-scheduled-task) allowed+=" --id" ;;
    *) fail "unknown subcommand \"${cmd}\"" ;;
  esac
  case " ${allowed} " in
    *" ${flag} "*) ;;
    *) fail "${cmd} does not accept ${flag}" ;;
  esac
}

require_limit() {
  local cmd="$1" value="$2" max="$3"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || fail "${cmd} limit must be a positive integer"
  (( value <= max )) || fail "${cmd} limit must not exceed ${max}"
}

require_page_type() {
  local cmd="$1" value="$2"
  case "$value" in
    principal|person|project|key_matter|group|resource) ;;
    *) fail "${cmd} --type must be principal, person, project, key_matter, group or resource" ;;
  esac
}

# parse_kv_flag NAME VALUE — supports --name value and --name=value via caller.
consume_flags() {
  # remaining args in "$@"
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == --* ]]; then
      require_command_flag "$SUBCOMMAND" "${1%%=*}"
    fi
    case "$1" in
      --config)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CONFIG_PATH="$2"
        shift 2
        ;;
      --config=*)
        CONFIG_PATH="${1#--config=}"
        shift
        ;;
      --id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ID="$2"
        shift 2
        ;;
      --id=*)
        ID="${1#--id=}"
        shift
        ;;
      --code)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CODE="$2"
        shift 2
        ;;
      --code=*)
        CODE="${1#--code=}"
        shift
        ;;
      --chat-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CHAT_ID="$2"
        shift 2
        ;;
      --chat-id=*)
        CHAT_ID="${1#--chat-id=}"
        shift
        ;;
      --open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        OPEN_ID="$2"
        shift 2
        ;;
      --open-id=*)
        OPEN_ID="${1#--open-id=}"
        shift
        ;;
      --role)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ROLE="$2"
        shift 2
        ;;
      --role=*)
        ROLE="${1#--role=}"
        shift
        ;;
      --project-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PROJECT_ID="$2"
        shift 2
        ;;
      --project-id=*)
        PROJECT_ID="${1#--project-id=}"
        shift
        ;;
      --group-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        GROUP_ID="$2"
        shift 2
        ;;
      --group-id=*)
        GROUP_ID="${1#--group-id=}"
        shift
        ;;
      --person-open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PERSON_OPEN_ID="$2"
        shift 2
        ;;
      --person-open-id=*)
        PERSON_OPEN_ID="${1#--person-open-id=}"
        shift
        ;;
      --principal-only)
        PRINCIPAL_ONLY="true"
        shift
        ;;
      --page)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PAGE="$2"
        shift 2
        ;;
      --page=*)
        PAGE="${1#--page=}"
        shift
        ;;
      --query)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        QUERY="$2"
        shift 2
        ;;
      --query=*)
        QUERY="${1#--query=}"
        shift
        ;;
      --source-message-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SOURCE_MESSAGE_ID="$2"
        shift 2
        ;;
      --source-message-id=*)
        SOURCE_MESSAGE_ID="${1#--source-message-id=}"
        shift
        ;;
      --action-type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ACTION_TYPE="$2"
        shift 2
        ;;
      --action-type=*)
        ACTION_TYPE="${1#--action-type=}"
        shift
        ;;
      --context)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CONTEXT_SECTION="$2"
        shift 2
        ;;
      --context=*)
        CONTEXT_SECTION="${1#--context=}"
        shift
        ;;
      --revision)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        REVISION="$2"
        shift 2
        ;;
      --revision=*)
        REVISION="${1#--revision=}"
        shift
        ;;
      --keyword)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        KEYWORD="$2"
        shift 2
        ;;
      --keyword=*)
        KEYWORD="${1#--keyword=}"
        shift
        ;;
      --note)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        NOTE="$2"
        shift 2
        ;;
      --note=*)
        NOTE="${1#--note=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        NAME="$2"
        shift 2
        ;;
      --name=*)
        NAME="${1#--name=}"
        shift
        ;;
      --state)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        STATUS="$2"; shift 2 ;;
      --state=*) STATUS="${1#*=}"; shift ;;
      --status)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        STATUS="$2"
        shift 2
        ;;
      --status=*)
        STATUS="${1#--status=}"
        shift
        ;;
      --limit)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        LIMIT="$2"
        shift 2
        ;;
      --limit=*)
        LIMIT="${1#--limit=}"
        shift
        ;;
      --payload)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PAYLOAD="$2"
        shift 2
        ;;
      --payload=*)
        PAYLOAD="${1#--payload=}"
        shift
        ;;
      --payload-file)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PAYLOAD_FILE="$2"
        shift 2
        ;;
      --payload-file=*)
        PAYLOAD_FILE="${1#--payload-file=}"
        shift
        ;;
      --at)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        AT="$2"
        shift 2
        ;;
      --at=*)
        AT="${1#--at=}"
        shift
        ;;
      --reason)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        REASON="$2"
        shift 2
        ;;
      --reason=*)
        REASON="${1#--reason=}"
        shift
        ;;
      --source)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SOURCE="$2"
        shift 2
        ;;
      --source=*)
        SOURCE="${1#--source=}"
        shift
        ;;
      --source-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SOURCE_ID="$2"
        shift 2
        ;;
      --source-id=*)
        SOURCE_ID="${1#--source-id=}"
        shift
        ;;
      --actor)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ACTOR="$2"
        shift 2
        ;;
      --actor=*)
        ACTOR="${1#--actor=}"
        shift
        ;;
      --external-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        EXTERNAL_ID="$2"
        shift 2
        ;;
      --external-id=*)
        EXTERNAL_ID="${1#--external-id=}"
        shift
        ;;
      --title)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        TITLE="$2"
        shift 2
        ;;
      --title=*)
        TITLE="${1#--title=}"
        shift
        ;;
      --content)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CONTENT="$2"
        shift 2
        ;;
      --content=*)
        CONTENT="${1#--content=}"
        shift
        ;;
      --subject-type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SUBJECT_TYPE="$2"
        shift 2
        ;;
      --subject-type=*)
        SUBJECT_TYPE="${1#--subject-type=}"
        shift
        ;;
      --subject-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SUBJECT_ID="$2"
        shift 2
        ;;
      --subject-id=*)
        SUBJECT_ID="${1#--subject-id=}"
        shift
        ;;
      --description)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        DESCRIPTION="$2"
        shift 2
        ;;
      --description=*)
        DESCRIPTION="${1#--description=}"
        shift
        ;;
      --date)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        DATE="$2"
        shift 2
        ;;
      --date=*)
        DATE="${1#--date=}"
        shift
        ;;
      --occurred-at)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        OCCURRED_AT="$2"
        shift 2
        ;;
      --occurred-at=*)
        OCCURRED_AT="${1#--occurred-at=}"
        shift
        ;;
      --entity-type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ENTITY_TYPE="$2"
        shift 2
        ;;
      --entity-type=*)
        ENTITY_TYPE="${1#--entity-type=}"
        shift
        ;;
      --entity-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ENTITY_ID="$2"
        shift 2
        ;;
      --entity-id=*)
        ENTITY_ID="${1#--entity-id=}"
        shift
        ;;
      --run-limit)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        RUN_LIMIT="$2"
        shift 2
        ;;
      --run-limit=*)
        RUN_LIMIT="${1#--run-limit=}"
        shift
        ;;
      --event-limit)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        EVENT_LIMIT="$2"
        shift 2
        ;;
      --event-limit=*)
        EVENT_LIMIT="${1#--event-limit=}"
        shift
        ;;
      --include-run-output)
        INCLUDE_RUN_OUTPUT="true"
        shift
        ;;
      --include-prompt)
        INCLUDE_PROMPT="true"
        shift
        ;;
      --message-ids)
        [[ $# -ge 2 && -n "$2" ]] || fail "$1 requires a nonempty value"
        MESSAGE_IDS="$2"
        shift 2
        ;;
      --message-ids=*)
        MESSAGE_IDS="${1#--message-ids=}"
        [[ -n "$MESSAGE_IDS" ]] || fail "--message-ids requires a nonempty value"
        shift
        ;;
      --message-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        MESSAGE_ID="$2"
        shift 2
        ;;
      --message-id=*)
        MESSAGE_ID="${1#--message-id=}"
        shift
        ;;
      --resource-type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        RESOURCE_TYPE="$2"
        shift 2
        ;;
      --resource-type=*)
        RESOURCE_TYPE="${1#--resource-type=}"
        shift
        ;;
      --sender-open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SENDER_OPEN_ID="$2"
        shift 2
        ;;
      --sender-open-id=*)
        SENDER_OPEN_ID="${1#--sender-open-id=}"
        shift
        ;;
      --type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        TYPE="$2"
        shift 2
        ;;
      --type=*)
        TYPE="${1#--type=}"
        shift
        ;;
      --all)
        ALL="true"
        shift
        ;;
      --stale-days)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        STALE_DAYS="$2"
        shift 2
        ;;
      --stale-days=*)
        STALE_DAYS="${1#--stale-days=}"
        shift
        ;;
      --over-limit)
        OVER_LIMIT="true"
        shift
        ;;
      --if-unchanged-since)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        IF_UNCHANGED_SINCE="$2"
        shift 2
        ;;
      --if-unchanged-since=*)
        IF_UNCHANGED_SINCE="${1#--if-unchanged-since=}"
        shift
        ;;
      -*)
        fail "unknown flag: $1"
        ;;
      *)
        fail "unexpected argument: $1"
        ;;
    esac
  done
}

# --- subcommands ------------------------------------------------------------

cmd_list_projects() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit list-projects "$LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local items total
  if [[ -z "$KEYWORD" ]]; then
    local body
    body="$(api_get "/api/projects?page=1&page_size=${LIMIT}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -er '.data.total')"
  else
    local all
    all="$(fetch_all_items /api/projects)"
    items="$(printf '%s' "$all" | jq -c --arg keyword "$KEYWORD" --argjson limit "$LIMIT" '
      [.[] | select((([.code,.name,.description,.role,.status] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))][: $limit]')"
    total="$(printf '%s' "$all" | jq -r --arg keyword "$KEYWORD" '
      [.[] | select((([.code,.name,.description,.role,.status] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))] | length')"
  fi
  items="$(printf '%s' "$items" | jq -c '[.[] | {id,code,name,role,status,priority,description,updated_at}]')"
  emit "$(jq -cn --argjson total "$total" --argjson projects "$items" '{total:$total,projects:$projects}')"
}

cmd_get_project() {
  reset_flags
  consume_flags "$@"
  local has_id=0 has_code=0
  [[ -n "$ID" ]] && has_id=1
  [[ -n "$CODE" ]] && has_code=1
  if (( has_id + has_code != 1 )); then
    fail "get-project requires exactly one of --id or --code"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  if (( has_id )); then
    [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "get-project --id must be a positive integer"
    local body project
    body="$(api_get "/api/projects/${ID}")"
    project="$(printf '%s' "$body" | jq -c '.data')"
    emit "$project"
    return
  fi
  local items matched
  items="$(fetch_all_items /api/projects)"
  matched="$(printf '%s' "$items" | jq -c --arg code "$CODE" '[.[] | select(.code == $code)]')"
  local n
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple projects matched code=${CODE}"
  fi
  local project
  project="$(printf '%s' "$matched" | jq -c '.[0]')"
  emit "$project"
}

