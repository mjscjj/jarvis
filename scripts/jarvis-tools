# append-shared-memory uses one server-side append operation so concurrent agents
# cannot overwrite each other's entries.
cmd_append_shared_memory() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local note
  note="$(read_note_arg)"
  if [[ -z "${note//[[:space:]]/}" ]]; then
    fail "append-shared-memory note is empty"
  fi
  local payload body
  payload="$(jq -cn --arg note "$note" '{note:$note}')"
  body="$(api_write POST /api/shared-memory/append "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# append-clue hands M2 a raw observed fact. The server owns idempotency, so a
# producer can safely redeliver the same (source, external-id) on every run.
cmd_append_clue() {
  reset_flags
  consume_flags "$@"
  [[ -n "$SOURCE" ]] || fail "append-clue requires --source"
  [[ -n "$EXTERNAL_ID" ]] || fail "append-clue requires --external-id"
  [[ -n "$TITLE" ]] || fail "append-clue requires --title"
  local content
  if [[ "$CONTENT" == "-" ]]; then
    content="$(cat)"
  else
    content="$CONTENT"
  fi
  content="${content%$'\n'}"
  local occurred_at="$OCCURRED_AT"
  if [[ -z "$occurred_at" ]]; then
    occurred_at="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --arg source "$SOURCE" --arg external_id "$EXTERNAL_ID" \
    --arg title "$TITLE" --arg content "$content" --arg occurred_at "$occurred_at" \
    '{source:$source,external_id:$external_id,title:$title,content:$content,occurred_at:$occurred_at}')"
  body="$(api_write POST /api/clues "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# append-fact records one thing that happened about a subject. Facts are the
# side channel the daily digests read back, so write them as they are learned
# rather than batching them at the end.
cmd_append_fact() {
  reset_flags
  consume_flags "$@"
  [[ -n "$SUBJECT_TYPE" ]] || fail "append-fact requires --subject-type"
  [[ "$SUBJECT_ID" =~ ^[1-9][0-9]*$ ]] || fail "append-fact requires a positive --subject-id"
  local description
  if [[ "$DESCRIPTION" == "-" ]]; then
    description="$(cat)"
  else
    description="$DESCRIPTION"
  fi
  description="${description%$'\n'}"
  [[ -n "${description//[[:space:]]/}" ]] || fail "append-fact description is empty"
  local occurred_at="$OCCURRED_AT"
  if [[ -z "$occurred_at" ]]; then
    occurred_at="$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  fi
  # Default both provenance fields to the running Task. An explicit source is
  # independent and never accidentally borrows JARVIS_TASK_ID.
  if [[ -n "$SOURCE_ID" && -z "$SOURCE" ]]; then
    fail "append-fact --source-id requires --source"
  fi
  local source_kind="$SOURCE"
  local source_id="null"
  if [[ -z "$source_kind" && "${JARVIS_TASK_ID:-}" =~ ^[1-9][0-9]*$ ]]; then
    source_kind="task"
    source_id="$JARVIS_TASK_ID"
  elif [[ -z "$source_kind" && "${JARVIS_AGENT_STAGE:-}" == "proactive" ]]; then
    source_kind="proactive"
  elif [[ -z "$source_kind" && "${JARVIS_AGENT_STAGE:-}" == "factengine" ]]; then
    source_kind="factengine"
  elif [[ -n "$SOURCE_ID" ]]; then
    [[ -n "$source_kind" ]] || fail "append-fact --source-id requires --source"
    [[ "$SOURCE_ID" =~ ^[1-9][0-9]*$ ]] || fail "append-fact --source-id must be a positive integer"
    source_id="$SOURCE_ID"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --arg subject_type "$SUBJECT_TYPE" --argjson subject_id "$SUBJECT_ID" \
    --arg description "$description" --arg occurred_at "$occurred_at" \
    --arg source_kind "$source_kind" --argjson source_id "$source_id" \
    '{subject_type:$subject_type,subject_id:$subject_id,description:$description,occurred_at:$occurred_at,
      source_kind:(if $source_kind=="" then null else $source_kind end),source_id:$source_id}')"
  body="$(api_write POST /api/facts "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# local_day_bounds DATE CMD — resolve YYYY-MM-DD to RFC3339 half-open [from, until)
# in the local timezone. Fail-fast with the calling command name on bad input.
local_day_bounds() {
  local date="$1" cmd="$2"
  [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || fail "${cmd} --date must be YYYY-MM-DD"
  local from until
  from="$(date -j -f '%Y-%m-%d %H:%M:%S' "$date 00:00:00" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)" ||
    fail "${cmd} could not parse --date $date"
  until="$(date -j -v+1d -f '%Y-%m-%d %H:%M:%S' "$date 00:00:00" +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)" ||
    fail "${cmd} could not advance --date $date"
  from="$(printf '%s' "$from" | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  until="$(printf '%s' "$until" | sed -E 's/([0-9]{2})([0-9]{2})$/\1:\2/')"
  printf '%s %s' "$from" "$until"
}

# list-facts reads one subject's recorded facts, newest first. --date narrows to
# one natural day in local time; the API takes explicit bounds so the day is
# resolved here rather than assumed by the server.
cmd_list_facts() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  [[ -n "$SUBJECT_TYPE" ]] || fail "list-facts requires --subject-type"
  [[ "$SUBJECT_ID" =~ ^[1-9][0-9]*$ ]] || fail "list-facts requires a positive --subject-id"
  require_limit list-facts "$LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local enc_type query
  enc_type="$(jq -rn --arg s "$SUBJECT_TYPE" '$s|@uri')"
  query="?subject_type=${enc_type}&subject_id=${SUBJECT_ID}&limit=${LIMIT}"
  if [[ -n "$DATE" ]]; then
    local from until
    read -r from until <<<"$(local_day_bounds "$DATE" list-facts)"
    query="${query}&from=$(jq -rn --arg s "$from" '$s|@uri')&until=$(jq -rn --arg s "$until" '$s|@uri')"
  fi
  local body
  body="$(api_get "/api/facts${query}")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

