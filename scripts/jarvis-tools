  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "get-resource requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  emit "$(api_get "/api/resources/${ID}" | jq -c '.data')"
}

cmd_query_messages() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit query-messages "$LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local query="limit=${LIMIT}" value
  if [[ -n "$CHAT_ID" ]]; then
    value="$(jq -rn --arg s "$CHAT_ID" '$s|@uri')"
    query="${query}&chat_id=${value}"
  fi
  if [[ -n "$SENDER_OPEN_ID" ]]; then
    value="$(jq -rn --arg s "$SENDER_OPEN_ID" '$s|@uri')"
    query="${query}&sender_open_id=${value}"
  fi
  if [[ -n "$KEYWORD" ]]; then
    value="$(jq -rn --arg s "$KEYWORD" '$s|@uri')"
    query="${query}&keyword=${value}"
  fi
  if [[ -n "$DATE" ]]; then
    local from until
    read -r from until <<<"$(local_day_bounds "$DATE" query-messages)"
    query="${query}&from=$(jq -rn --arg s "$from" '$s|@uri')&until=$(jq -rn --arg s "$until" '$s|@uri')"
  fi
  emit "$(api_get "/api/messages?${query}" | jq -c '.data')"
}

