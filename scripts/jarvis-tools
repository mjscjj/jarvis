cmd_set_shared_memory() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local content payload body
  if [[ "$CONTENT" == "-" ]]; then
    content="$(cat)"
  else
    content="$CONTENT"
  fi
  content="${content%$'\n'}"
  payload="$(jq -cn --arg content "$content" '{content:$content}')"
  body="$(api_write PUT /api/shared-memory "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

