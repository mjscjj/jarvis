  list-persons)   cmd_list_persons "$@" ;;
  get-person)     cmd_get_person "$@" ;;
  create-person)  cmd_payload_create create-person POST /api/persons "$@" ;;
  update-person)  cmd_payload_by_id update-person PUT /api/persons "$@" ;;
  delete-person)  cmd_delete_by_id delete-person /api/persons "$@" ;;
  query-resources)      cmd_query_resources "$@" ;;
  get-resource)         cmd_get_resource "$@" ;;
  create-resource)      cmd_payload_create create-resource POST /api/resources "$@" ;;
  update-resource)      cmd_payload_by_id update-resource PUT /api/resources "$@" ;;
  touch-resource)       cmd_touch_by_id touch-resource /api/resources "$@" ;;
  delete-resource)      cmd_delete_by_id delete-resource /api/resources "$@" ;;
  query-messages)       cmd_query_messages "$@" ;;
  get-message)           cmd_get_message "$@" ;;
  get-todo-event)        cmd_get_todo_event "$@" ;;
  get-task-event)        cmd_get_task_event "$@" ;;
  query-captured-resources) cmd_query_captured_resources "$@" ;;
  get-captured-resource) cmd_get_captured_resource "$@" ;;
  get-shared-memory)    cmd_get_shared_memory "$@" ;;
  set-shared-memory)    cmd_set_shared_memory "$@" ;;
  list-skills)          cmd_list_skills "$@" ;;
  get-skill)            cmd_get_skill "$@" ;;
  append-shared-memory) cmd_append_shared_memory "$@" ;;
  notice-principal)     cmd_notice_principal "$@" ;;
  append-clue)          cmd_append_clue "$@" ;;
  append-fact)          cmd_append_fact "$@" ;;
  append-facts-batch)   cmd_append_facts_batch "$@" ;;
  list-facts)           cmd_list_facts "$@" ;;
  get-page)             cmd_get_page "$@" ;;
  update-page)          cmd_update_page "$@" ;;
  list-pages)           cmd_list_pages "$@" ;;
  list-backlinks)       cmd_list_backlinks "$@" ;;
  list-todos)           cmd_list_todos "$@" ;;
  get-todo)             cmd_get_todo "$@" ;;
  list-delegations)     cmd_list_delegations "$@" ;;
  get-delegation)       cmd_get_delegation "$@" ;;
