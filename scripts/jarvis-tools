cmd_notice_principal() {
  reset_flags
  consume_flags "$@"
  [[ -z "$PAYLOAD_FILE" || "$PAYLOAD" == "-" ]] || fail "choose --payload or --payload-file"
  if [[ -n "$PAYLOAD_FILE" ]]; then
    [[ -f "$PAYLOAD_FILE" ]] || fail "notice payload file not found: $PAYLOAD_FILE"
    PAYLOAD="$(cat -- "$PAYLOAD_FILE")"
  fi
  local payload body
  payload="$(read_payload_object notice-principal)"
  if [[ -n "${JARVIS_TASK_ID:-}" ]] && ! jq -e 'has("task_id")' <<<"$payload" >/dev/null; then
    [[ "$JARVIS_TASK_ID" =~ ^[1-9][0-9]*$ ]] || fail "JARVIS_TASK_ID must be positive"
    payload="$(jq -c --argjson task_id "$JARVIS_TASK_ID" '. + {task_id:$task_id}' <<<"$payload")"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  body="$(api_write POST /api/notices/principal "$payload" 300)"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_payload_create() {
  local command_name="$1" method="$2" path="$3"
  shift 3
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(read_payload_object "$command_name")"
  if [[ "$command_name" == "update-principal" ]]; then
    forbid_summary_payload "$command_name" "$payload"
  fi
  body="$(api_write "$method" "$path" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_payload_by_id() {
  local command_name="$1" method="$2" path_prefix="$3"
  shift 3
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "${command_name} requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(read_payload_object "$command_name")"
  case "$command_name" in
    update-project|update-key-matter|update-group|update-person|update-resource)
      forbid_summary_payload "$command_name" "$payload"
      ;;
  esac
  body="$(api_write "$method" "${path_prefix}/${ID}" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

