cmd_list_persons() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit list-persons "$LIMIT" 100
  if [[ -n "$ROLE" && ! "$ROLE" =~ ^(leader|key|colleague|other)$ ]]; then
    fail "list-persons --role must be leader, key, colleague or other"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local items total
  if [[ -z "$ROLE" && -z "$KEYWORD" ]]; then
    local body
    body="$(api_get "/api/persons?page=1&page_size=${LIMIT}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -r '.data.total')"
  else
    items="$(fetch_all_items /api/persons)"
    if [[ -n "$ROLE" ]]; then
      items="$(printf '%s' "$items" | jq -c --arg role "$ROLE" '[.[] | select(.role == $role)]')"
    fi
    if [[ -n "$KEYWORD" ]]; then
      items="$(printf '%s' "$items" | jq -c --arg keyword "$KEYWORD" '
        [.[] | select((([.name,.en_name,.department,.title,.role,.open_id] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))]')"
    fi
    total="$(printf '%s' "$items" | jq -r 'length')"
  fi
  items="$(printf '%s' "$items" | jq -c --argjson limit "$LIMIT" '[.[:$limit][] | {id,open_id,name,en_name,department,title,role,is_active,updated_at}]')"
  emit "$(jq -cn --argjson total "$total" --argjson persons "$items" '{total:$total,persons:$persons}')"
}

cmd_get_person() {
  reset_flags
  consume_flags "$@"
  if [[ -z "$OPEN_ID" ]]; then
    fail "get-person requires --open-id"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  # GET /api/persons/:id is DB id, not open_id — list + filter.
  local items matched n
  items="$(fetch_all_items /api/persons)"
  matched="$(printf '%s' "$items" | jq -c --arg oid "$OPEN_ID" '[.[] | select(.open_id == $oid)]')"
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple persons matched open_id=${OPEN_ID}"
  fi
  local person
  person="$(printf '%s' "$matched" | jq -c '.[0]')"
  emit "$person"
}

cmd_query_resources() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit query-resources "$LIMIT" 100
  if [[ -n "$PROJECT_ID" && ! "$PROJECT_ID" =~ ^[1-9][0-9]*$ ]]; then
    fail "query-resources --project-id must be a positive integer"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"

  local person_id=""
  if [[ -n "$PERSON_OPEN_ID" ]]; then
    local persons matched n
    persons="$(fetch_all_items /api/persons)"
    matched="$(printf '%s' "$persons" | jq -c --arg oid "$PERSON_OPEN_ID" '[.[] | select(.open_id == $oid)]')"
    n="$(printf '%s' "$matched" | jq -er 'length')"
    (( n == 1 )) || fail "query-resources expected exactly one person for open_id=${PERSON_OPEN_ID}, got ${n}"
    person_id="$(printf '%s' "$matched" | jq -er '.[0].id')"
  fi

  local filters="active_only=true"
  if [[ -n "$PROJECT_ID" ]]; then
    filters="${filters}&project_id=${PROJECT_ID}"
  fi
  if [[ -n "$person_id" ]]; then
    filters="${filters}&person_id=${person_id}"
  fi
  if [[ "$PRINCIPAL_ONLY" == "true" ]]; then
    filters="${filters}&principal_only=true"
  fi
  local items filtered total
  if [[ -z "$KEYWORD" ]]; then
    local body
    body="$(api_get "/api/resources?${filters}&page=1&page_size=${LIMIT}")"
    filtered="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -r '.data.total')"
  else
    items="$(fetch_all_items /api/resources "$filters")"
    filtered="$(printf '%s' "$items" | jq -c \
      --arg keyword "$KEYWORD" \
      --argjson limit "$LIMIT" '
        [.[]
         | select(([
             .title, .resource_type, .url, .description, .person_name, .project_name
           ] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase))
        ][: $limit]')"
    total="$(printf '%s' "$items" | jq -r --arg keyword "$KEYWORD" '
      [.[] | select(([
          .title, .resource_type, .url, .description, .person_name, .project_name
        ] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase))] | length')"
  fi
  emit "$(jq -cn --argjson total "$total" --argjson resources "$filtered" '{total:$total,count:($resources|length),resources:$resources}')"
}

