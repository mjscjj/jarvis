# Each command declares its own accepted flags. The parser is shared, but a flag
# that belongs to another command is an error rather than an ignored no-op.
require_command_flag() {
  local cmd="$1" flag="$2"
  local allowed="--config"
  case "$cmd" in
    list-projects | list-key-matters) allowed+=" --keyword --limit" ;;
    get-project) allowed+=" --id --code" ;;
    get-key-matter | touch-key-matter | touch-resource) allowed+=" --id" ;;
    create-project | create-key-matter | update-principal | create-person | create-resource | create-relation | create-task) allowed+=" --payload" ;;
    update-project | update-key-matter | update-group | update-person | update-resource | update-relation) allowed+=" --id --payload" ;;
    archive-project | close-key-matter | delete-person | delete-resource | delete-relation) allowed+=" --id" ;;
    list-groups) allowed+=" --keyword --limit" ;;
    get-group) allowed+=" --chat-id" ;;
    get-context) allowed+=" --chat-id --project-id" ;;
    get-principal | get-shared-memory) ;;
    list-persons) allowed+=" --role --keyword --limit" ;;
    get-person) allowed+=" --open-id" ;;
    query-resources) allowed+=" --project-id --person-open-id --principal-only --keyword --limit" ;;
    get-resource) allowed+=" --id" ;;
    query-messages) allowed+=" --chat-id --sender-open-id --keyword --date --limit" ;;
    query-captured-resources) allowed+=" --chat-id --message-id --resource-type --keyword --limit" ;;
    get-captured-resource) allowed+=" --id" ;;
    list-skills) allowed+=" --keyword" ;;
    get-skill) allowed+=" --name" ;;
    append-shared-memory) allowed+=" --note" ;;
    append-clue) allowed+=" --source --external-id --title --content --occurred-at" ;;
    append-fact) allowed+=" --subject-type --subject-id --description --occurred-at --source --source-id" ;;
    list-facts) allowed+=" --subject-type --subject-id --date --limit" ;;
    list-relations) allowed+=" --entity-type --entity-id --limit" ;;
    list-todos) allowed+=" --date --status --limit" ;;
    get-todo) allowed+=" --id" ;;
    list-tasks) allowed+=" --date --status --limit" ;;
    get-task) allowed+=" --id --run-limit --event-limit --include-run-output --include-prompt" ;;
    start-task) allowed+=" --id" ;;
    update-task) allowed+=" --id --payload" ;;
    close-task) allowed+=" --id --payload" ;;
    list-scheduled-tasks) allowed+=" --status --limit" ;;
    get-scheduled-task) allowed+=" --id" ;;
    create-scheduled-task) allowed+=" --payload" ;;
    update-scheduled-task) allowed+=" --id --payload" ;;
    trigger-scheduled-task) allowed+=" --id" ;;
    set-todo-status) allowed+=" --id --status --reason --actor" ;;
    yield-until) allowed+=" --at --reason" ;;
    delete-scheduled-task) allowed+=" --id" ;;
    *) fail "unknown subcommand \"${cmd}\"" ;;
  esac
  case " ${allowed} " in
    *" ${flag} "*) ;;
    *) fail "${cmd} does not accept ${flag}" ;;
  esac
}

require_limit() {
  local cmd="$1" value="$2" max="$3"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || fail "${cmd} limit must be a positive integer"
  (( value <= max )) || fail "${cmd} limit must not exceed ${max}"
}

# parse_kv_flag NAME VALUE — supports --name value and --name=value via caller.
consume_flags() {
  # remaining args in "$@"
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == --* ]]; then
      require_command_flag "$SUBCOMMAND" "${1%%=*}"
    fi
    case "$1" in
      --config)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CONFIG_PATH="$2"
        shift 2
        ;;
      --config=*)
        CONFIG_PATH="${1#--config=}"
        shift
        ;;
      --id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ID="$2"
        shift 2
        ;;
      --id=*)
        ID="${1#--id=}"
        shift
        ;;
      --code)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CODE="$2"
        shift 2
        ;;
      --code=*)
        CODE="${1#--code=}"
        shift
        ;;
      --chat-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CHAT_ID="$2"
        shift 2
        ;;
      --chat-id=*)
        CHAT_ID="${1#--chat-id=}"
        shift
        ;;
      --open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        OPEN_ID="$2"
        shift 2
        ;;
      --open-id=*)
        OPEN_ID="${1#--open-id=}"
        shift
        ;;
      --role)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ROLE="$2"
        shift 2
        ;;
      --role=*)
        ROLE="${1#--role=}"
        shift
        ;;
      --project-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PROJECT_ID="$2"
        shift 2
        ;;
      --project-id=*)
        PROJECT_ID="${1#--project-id=}"
        shift
        ;;
      --person-open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PERSON_OPEN_ID="$2"
        shift 2
        ;;
      --person-open-id=*)
        PERSON_OPEN_ID="${1#--person-open-id=}"
        shift
        ;;
      --principal-only)
        PRINCIPAL_ONLY="true"
        shift
        ;;
      --keyword)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        KEYWORD="$2"
        shift 2
        ;;
      --keyword=*)
        KEYWORD="${1#--keyword=}"
        shift
        ;;
      --note)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        NOTE="$2"
        shift 2
        ;;
      --note=*)
        NOTE="${1#--note=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        NAME="$2"
        shift 2
        ;;
      --name=*)
        NAME="${1#--name=}"
        shift
        ;;
      --status)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        STATUS="$2"
        shift 2
        ;;
      --status=*)
        STATUS="${1#--status=}"
        shift
        ;;
      --limit)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        LIMIT="$2"
        shift 2
        ;;
      --limit=*)
        LIMIT="${1#--limit=}"
        shift
        ;;
      --payload)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        PAYLOAD="$2"
        shift 2
        ;;
      --payload=*)
        PAYLOAD="${1#--payload=}"
        shift
        ;;
      --at)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        AT="$2"
        shift 2
        ;;
      --at=*)
        AT="${1#--at=}"
        shift
        ;;
      --reason)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        REASON="$2"
        shift 2
        ;;
      --reason=*)
        REASON="${1#--reason=}"
        shift
        ;;
      --source)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SOURCE="$2"
        shift 2
        ;;
      --source=*)
        SOURCE="${1#--source=}"
        shift
        ;;
      --source-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SOURCE_ID="$2"
        shift 2
        ;;
      --source-id=*)
        SOURCE_ID="${1#--source-id=}"
        shift
        ;;
      --actor)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ACTOR="$2"
        shift 2
        ;;
      --actor=*)
        ACTOR="${1#--actor=}"
        shift
        ;;
      --external-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        EXTERNAL_ID="$2"
        shift 2
        ;;
      --external-id=*)
        EXTERNAL_ID="${1#--external-id=}"
        shift
        ;;
      --title)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        TITLE="$2"
        shift 2
        ;;
      --title=*)
        TITLE="${1#--title=}"
        shift
        ;;
      --content)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        CONTENT="$2"
        shift 2
        ;;
      --content=*)
        CONTENT="${1#--content=}"
        shift
        ;;
      --subject-type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SUBJECT_TYPE="$2"
        shift 2
        ;;
      --subject-type=*)
        SUBJECT_TYPE="${1#--subject-type=}"
        shift
        ;;
      --subject-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SUBJECT_ID="$2"
        shift 2
        ;;
      --subject-id=*)
        SUBJECT_ID="${1#--subject-id=}"
        shift
        ;;
      --description)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        DESCRIPTION="$2"
        shift 2
        ;;
      --description=*)
        DESCRIPTION="${1#--description=}"
        shift
        ;;
      --date)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        DATE="$2"
        shift 2
        ;;
      --date=*)
        DATE="${1#--date=}"
        shift
        ;;
      --occurred-at)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        OCCURRED_AT="$2"
        shift 2
        ;;
      --occurred-at=*)
        OCCURRED_AT="${1#--occurred-at=}"
        shift
        ;;
      --entity-type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ENTITY_TYPE="$2"
        shift 2
        ;;
      --entity-type=*)
        ENTITY_TYPE="${1#--entity-type=}"
        shift
        ;;
      --entity-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        ENTITY_ID="$2"
        shift 2
        ;;
      --entity-id=*)
        ENTITY_ID="${1#--entity-id=}"
        shift
        ;;
      --run-limit)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        RUN_LIMIT="$2"
        shift 2
        ;;
      --run-limit=*)
        RUN_LIMIT="${1#--run-limit=}"
        shift
        ;;
      --event-limit)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        EVENT_LIMIT="$2"
        shift 2
        ;;
      --event-limit=*)
        EVENT_LIMIT="${1#--event-limit=}"
        shift
        ;;
      --include-run-output)
        INCLUDE_RUN_OUTPUT="true"
        shift
        ;;
      --include-prompt)
        INCLUDE_PROMPT="true"
        shift
        ;;
      --message-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        MESSAGE_ID="$2"
        shift 2
        ;;
      --message-id=*)
        MESSAGE_ID="${1#--message-id=}"
        shift
        ;;
      --resource-type)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        RESOURCE_TYPE="$2"
        shift 2
        ;;
      --resource-type=*)
        RESOURCE_TYPE="${1#--resource-type=}"
        shift
        ;;
      --sender-open-id)
        [[ $# -ge 2 ]] || fail "$1 requires a value"
        SENDER_OPEN_ID="$2"
        shift 2
        ;;
      --sender-open-id=*)
        SENDER_OPEN_ID="${1#--sender-open-id=}"
        shift
        ;;
      -*)
        fail "unknown flag: $1"
        ;;
      *)
        fail "unexpected argument: $1"
        ;;
    esac
  done
}

# --- subcommands ------------------------------------------------------------

cmd_list_projects() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit list-projects "$LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local items total
  if [[ -z "$KEYWORD" ]]; then
    local body
    body="$(api_get "/api/projects?page=1&page_size=${LIMIT}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -er '.data.total')"
  else
    local all
    all="$(fetch_all_items /api/projects)"
    items="$(printf '%s' "$all" | jq -c --arg keyword "$KEYWORD" --argjson limit "$LIMIT" '
      [.[] | select((([.code,.name,.description,.role,.status] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))][: $limit]')"
    total="$(printf '%s' "$all" | jq -r --arg keyword "$KEYWORD" '
      [.[] | select((([.code,.name,.description,.role,.status] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))] | length')"
  fi
  items="$(printf '%s' "$items" | jq -c '[.[] | {id,code,name,role,status,priority,description,updated_at}]')"
  emit "$(jq -cn --argjson total "$total" --argjson projects "$items" '{total:$total,projects:$projects}')"
}

cmd_get_project() {
  reset_flags
  consume_flags "$@"
  local has_id=0 has_code=0
  [[ -n "$ID" ]] && has_id=1
  [[ -n "$CODE" ]] && has_code=1
  if (( has_id + has_code != 1 )); then
    fail "get-project requires exactly one of --id or --code"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  if (( has_id )); then
    [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "get-project --id must be a positive integer"
    local body project
    body="$(api_get "/api/projects/${ID}")"
    project="$(printf '%s' "$body" | jq -c '.data')"
    emit "$project"
    return
  fi
  local items matched
  items="$(fetch_all_items /api/projects)"
  matched="$(printf '%s' "$items" | jq -c --arg code "$CODE" '[.[] | select(.code == $code)]')"
  local n
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple projects matched code=${CODE}"
  fi
  local project
  project="$(printf '%s' "$matched" | jq -c '.[0]')"
  emit "$project"
}

cmd_list_key_matters() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit list-key-matters "$LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local items total
  if [[ -z "$KEYWORD" ]]; then
    local body
    body="$(api_get "/api/key-matters?page=1&page_size=${LIMIT}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -er '.data.total')"
  else
    local all
    all="$(fetch_all_items /api/key-matters)"
    items="$(printf '%s' "$all" | jq -c --arg keyword "$KEYWORD" --argjson limit "$LIMIT" '
      [.[] | select((([.title,.status,.summary] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))][: $limit]')"
    total="$(printf '%s' "$all" | jq -r --arg keyword "$KEYWORD" '
      [.[] | select((([.title,.status,.summary] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))] | length')"
  fi
  items="$(printf '%s' "$items" | jq -c '[.[] | {id,title,status,summary,project_id,due_at,last_progress_at,last_active_at}]')"
  emit "$(jq -cn --argjson total "$total" --argjson key_matters "$items" '{total:$total,key_matters:$key_matters}')"
}

cmd_get_key_matter() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "get-key-matter requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_get "/api/key-matters/${ID}")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_payload_create() {
  local command_name="$1" method="$2" path="$3"
  shift 3
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(read_payload_object "$command_name")"
  body="$(api_write "$method" "$path" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_payload_by_id() {
  local command_name="$1" method="$2" path_prefix="$3"
  shift 3
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "${command_name} requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(read_payload_object "$command_name")"
  body="$(api_write "$method" "${path_prefix}/${ID}" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_delete_by_id() {
  local command_name="$1" path_prefix="$2"
  shift 2
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "${command_name} requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write DELETE "${path_prefix}/${ID}" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_touch_by_id() {
  local command_name="$1" path_prefix="$2"
  shift 2
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "${command_name} requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write POST "${path_prefix}/${ID}/touch" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_list_groups() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit list-groups "$LIMIT" 100
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local query="page=1&page_size=${LIMIT}"
  if [[ -n "$KEYWORD" ]]; then
    query="${query}&keyword=$(jq -rn --arg s "$KEYWORD" '$s|@uri')"
  fi
  local body
  body="$(api_get "/api/groups?${query}")"
  emit "$(printf '%s' "$body" | jq -c '.data | {
    total,page,page_size,broadened,
    items:[.items[] | {id,chat_id,name,description,project:(if .project == null then null else {id:.project.id,code:.project.code,name:.project.name} end),tier,pinned,is_key_group,related_group,last_active_at,message_count}]
  }')"
}

cmd_get_group() {
  reset_flags
  consume_flags "$@"
  if [[ -z "$CHAT_ID" ]]; then
    fail "get-group requires --chat-id"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  # /api/groups has no by-chat-id GET; keyword searches chat_id (and name/...).
  # Use keyword to narrow, then exact-match on chat_id (fail-fast if missing).
  local enc body matched n
  enc="$(jq -rn --arg s "$CHAT_ID" '$s|@uri')"
  body="$(api_get "/api/groups?keyword=${enc}&page=1&page_size=100")"
  matched="$(printf '%s' "$body" | jq -c --arg cid "$CHAT_ID" '[.data.items[] | select(.chat_id == $cid)]')"
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple groups matched chat_id=${CHAT_ID}"
  fi
  emit "$(printf '%s' "$matched" | jq -c '.[0]')"
}

cmd_get_context() {
  reset_flags
  consume_flags "$@"
  if [[ -n "$PROJECT_ID" && ! "$PROJECT_ID" =~ ^[1-9][0-9]*$ ]]; then
    fail "get-context --project-id must be a positive integer"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -nc --arg chat_id "$CHAT_ID" --arg project_id "$PROJECT_ID" '{
    chat_id: $chat_id,
    project_id: (if $project_id == "" then null else ($project_id | tonumber) end)
  }')"
  body="$(api_write POST /api/context "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_get_principal() {
  reset_flags
  consume_flags "$@"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_get /api/profile)"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_list_persons() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit list-persons "$LIMIT" 100
  if [[ -n "$ROLE" && ! "$ROLE" =~ ^(leader|key|colleague|other)$ ]]; then
    fail "list-persons --role must be leader, key, colleague or other"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local items total
  if [[ -z "$ROLE" && -z "$KEYWORD" ]]; then
    local body
    body="$(api_get "/api/persons?page=1&page_size=${LIMIT}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -r '.data.total')"
  else
    items="$(fetch_all_items /api/persons)"
    if [[ -n "$ROLE" ]]; then
      items="$(printf '%s' "$items" | jq -c --arg role "$ROLE" '[.[] | select(.role == $role)]')"
    fi
    if [[ -n "$KEYWORD" ]]; then
      items="$(printf '%s' "$items" | jq -c --arg keyword "$KEYWORD" '
        [.[] | select((([.name,.en_name,.department,.title,.role,.relation,.open_id] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase)))]')"
    fi
    total="$(printf '%s' "$items" | jq -r 'length')"
  fi
  items="$(printf '%s' "$items" | jq -c --argjson limit "$LIMIT" '[.[:$limit][] | {id,open_id,name,en_name,department,title,role,relation,is_active,updated_at}]')"
  emit "$(jq -cn --argjson total "$total" --argjson persons "$items" '{total:$total,persons:$persons}')"
}

cmd_get_person() {
  reset_flags
  consume_flags "$@"
  if [[ -z "$OPEN_ID" ]]; then
    fail "get-person requires --open-id"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  # GET /api/persons/:id is DB id, not open_id — list + filter.
  local items matched n
  items="$(fetch_all_items /api/persons)"
  matched="$(printf '%s' "$items" | jq -c --arg oid "$OPEN_ID" '[.[] | select(.open_id == $oid)]')"
  n="$(printf '%s' "$matched" | jq -er 'length')"
  if (( n == 0 )); then
    fail "not found"
  fi
  if (( n > 1 )); then
    fail "multiple persons matched open_id=${OPEN_ID}"
  fi
  local person
  person="$(printf '%s' "$matched" | jq -c '.[0]')"
  emit "$person"
}

cmd_query_resources() {
  reset_flags
  LIMIT="20"
  consume_flags "$@"
  require_limit query-resources "$LIMIT" 100
  if [[ -n "$PROJECT_ID" && ! "$PROJECT_ID" =~ ^[1-9][0-9]*$ ]]; then
    fail "query-resources --project-id must be a positive integer"
  fi
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"

  local person_id=""
  if [[ -n "$PERSON_OPEN_ID" ]]; then
    local persons matched n
    persons="$(fetch_all_items /api/persons)"
    matched="$(printf '%s' "$persons" | jq -c --arg oid "$PERSON_OPEN_ID" '[.[] | select(.open_id == $oid)]')"
    n="$(printf '%s' "$matched" | jq -er 'length')"
    (( n == 1 )) || fail "query-resources expected exactly one person for open_id=${PERSON_OPEN_ID}, got ${n}"
    person_id="$(printf '%s' "$matched" | jq -er '.[0].id')"
  fi

  local filters="active_only=true"
  if [[ -n "$PROJECT_ID" ]]; then
    filters="${filters}&project_id=${PROJECT_ID}"
  fi
  if [[ -n "$person_id" ]]; then
    filters="${filters}&person_id=${person_id}"
  fi
  if [[ "$PRINCIPAL_ONLY" == "true" ]]; then
    filters="${filters}&principal_only=true"
  fi
  local items filtered total
  if [[ -z "$KEYWORD" ]]; then
    local body
    body="$(api_get "/api/resources?${filters}&page=1&page_size=${LIMIT}")"
    filtered="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -r '.data.total')"
  else
    items="$(fetch_all_items /api/resources "$filters")"
    filtered="$(printf '%s' "$items" | jq -c \
      --arg keyword "$KEYWORD" \
      --argjson limit "$LIMIT" '
        [.[]
         | select(([
             .title, .resource_type, .url, .description, .person_name, .project_name
           ] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase))
        ][: $limit]')"
    total="$(printf '%s' "$items" | jq -r --arg keyword "$KEYWORD" '
      [.[] | select(([
          .title, .resource_type, .url, .description, .person_name, .project_name
        ] | map(. // "") | join(" ")) | ascii_downcase | contains($keyword | ascii_downcase))] | length')"
  fi
  emit "$(jq -cn --argjson total "$total" --argjson resources "$filtered" '{total:$total,count:($resources|length),resources:$resources}')"
}

