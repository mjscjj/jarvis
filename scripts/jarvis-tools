#!/usr/bin/env bash
# jarvis-tools: canonical Jarvis query/controlled-write CLI for agents.
# All data access goes through jarvis-server HTTP API (curl + jq; Node for exact JSON reads).
#
# Output contract: data commands → compact JSON on stdout only; help → text on
# stdout; errors → stderr + exit 1.
set -euo pipefail

fail() {
  echo "jarvis-tools error: $*" >&2
  exit 1
}

command -v curl >/dev/null 2>&1 || fail "curl is required but not found in PATH"
command -v jq >/dev/null 2>&1 || fail "jq is required but not found in PATH"

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  if [[ "$SOURCE_PATH" != /* ]]; then
    SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

print_usage() {
  cat <<'EOF'
usage: jarvis-tools <subcommand> [flags]

principles:
  Simple first. Each command serves one concrete intent; there is no generic API
  passthrough, compatibility layer or fallback for imagined future needs.
  Progressive loading. Start with list/query summaries, then get one matched
  object. Large prompts, run outputs and captured resource text are opt-in.

subcommands:
  list-projects          List projects
  get-project            Get one project
  create-project         Create a project from a JSON payload
  update-project         Replace a project's control fields
  archive-project        Archive a project
  list-key-matters       List open key matters
  get-key-matter         Get one key matter
  create-key-matter      Create a key matter from a JSON payload
  update-key-matter      Replace a key matter's control fields
  touch-key-matter       Mark an open key matter as freshly active
  close-key-matter       Close a key matter
  list-groups            Search Feishu groups
  get-group              Get one Feishu group by chat_id
  get-context            Assemble current principal/project/chat work context
  update-group           Replace one group's control fields
  get-principal          Get the assistant owner's profile
  notice-principal       Send an agent-authored Feishu card to the principal
  update-principal       Replace the principal's control fields
  list-persons           List important people, optionally by role
  get-person             Get one person by Feishu open_id
  create-person          Create a person from a JSON payload
  update-person          Replace a person's control fields
  delete-person          Delete a person
  query-resources        Query managed resource summaries
  get-resource           Get one managed resource
  create-resource        Create a managed resource
  update-resource        Replace a managed resource's control fields
  touch-resource         Mark an enabled managed resource as freshly active
  delete-resource        Delete a managed resource
  query-messages         Query locally captured Feishu messages
  get-message            Load one locally captured message by database ID
  get-todo-event         Load one Todo lifecycle event by database ID
  get-task-event         Load one Task lifecycle event by database ID
  query-captured-resources List captured attachment/document summaries
  get-captured-resource  Load one captured resource including extracted text
  get-shared-memory      Read shared memory
  set-shared-memory      Replace shared memory
  list-skills            List locally managed Skills
  get-skill              Read one locally managed Skill
  append-shared-memory   Append one entry to shared memory
  append-clue            Hand M2 one observed fact as evidence for M3
  get-page               Read one entity's long-term fact page
  update-page            Replace one entity's long-term fact page
  list-pages             List long-term fact page indexes
  list-backlinks         List pages that reference an entity
  append-fact            Record one fact about a project, group, person or other subject
  append-facts-batch     Record multiple facts from one JSON array
  list-facts             Read a subject's recorded facts, optionally for one day
  list-todos             List action clues, optionally for one day
  get-todo               Get one clue with the details omitted from summaries
  list-delegations       List identified commitments (independent of check Tasks)
  get-delegation         Read original context and current check result
  update-delegation      Update check result with an expected version
  list-delegation-tasks  List checks linked to one commitment
  list-tasks             List tasks, optionally for one day
  get-task               Read task overview or a frozen context section
  list-task-runs         Page through a task’s execution history
  get-task-run           Read one run’s output and effects
  create-task            Create a normal Task for strong M5 (proactive agent only)
  start-task             Start one pending Task with strong M5 (proactive agent only)
  update-task            Update one non-terminal Task (proactive agent only)
  close-task             Close one non-terminal Task (proactive agent only)
  list-scheduled-tasks   List time-triggered tasks
  get-scheduled-task     Get one time-triggered task
  create-scheduled-task  Create a time trigger for a new task
  update-scheduled-task  Update a standalone time trigger
  trigger-scheduled-task Trigger a standalone time trigger now
  set-todo-status        Park a clue, or hand it back for execution
  yield-until            Pause the current task until a future time
  delete-scheduled-task  Delete a standalone time trigger

Run "jarvis-tools <subcommand> --help" for command-specific flags.
EOF
}

usage_error() {
  print_usage >&2
  exit 1
}

print_subcommand_help() {
  case "$1" in
    list-projects) cat <<'EOF'
usage: jarvis-tools list-projects [--keyword TEXT] [--limit N] [--config PATH]
List compact project summaries. Use get-project for full project background.
EOF
      ;;
    get-project) cat <<'EOF'
usage: jarvis-tools get-project (--id ID | --code CODE) [--config PATH]
Get one project. Long-term facts are on get-page; use list-facts for history detail.
EOF
      ;;
    create-project) payload_help "create-project" "Create one project." ;;
    update-project) payload_id_help "update-project" "Replace one project's control fields. Long-term facts are written with update-page; this payload does not accept summary." ;;
    archive-project) delete_id_help "archive-project" "Archive one project; this does not hard-delete it." ;;
    list-key-matters) cat <<'EOF'
usage: jarvis-tools list-key-matters [--keyword TEXT] [--limit N] [--config PATH]
List compact open key matters. Use get-key-matter for full background.
EOF
      ;;
    get-key-matter) cat <<'EOF'
usage: jarvis-tools get-key-matter --id ID [--config PATH]
Get one key matter. Long-term facts are on get-page; use list-facts for history detail.
EOF
      ;;
    create-key-matter) payload_help "create-key-matter" "Create one key matter." ;;
    update-key-matter) payload_id_help "update-key-matter" "Replace one key matter's control fields. Long-term facts are written with update-page; this payload does not accept summary." ;;
    touch-key-matter) delete_id_help "touch-key-matter" "Mark one open key matter as freshly active without changing its content." ;;
    close-key-matter) delete_id_help "close-key-matter" "Close one key matter; this does not hard-delete it." ;;
    list-groups) cat <<'EOF'
usage: jarvis-tools list-groups [--keyword TEXT] [--limit N] [--config PATH]
Search compact Feishu group summaries. Use get-group for full background.
EOF
      ;;
    get-group) cat <<'EOF'
usage: jarvis-tools get-group --chat-id CHAT_ID [--config PATH]
Get the Jarvis group binding and background for an exact Feishu chat_id.
EOF
      ;;
    get-context) cat <<'EOF'
usage: jarvis-tools get-context [--chat-id CHAT_ID] [--project-id ID] [--config PATH]
Assemble the canonical current context. An explicit project wins; otherwise a
chat resolves through its Jarvis group binding. With neither flag, returns the
principal-level global context.
EOF
      ;;
    update-group) payload_id_help "update-group" "Replace one group's control fields. Long-term facts are written with update-page; this payload does not accept summary." ;;
    get-principal) cat <<'EOF'
usage: jarvis-tools get-principal [--config PATH]
Get the profile of the person Jarvis assists.
EOF
      ;;
    update-principal) payload_help "update-principal" "Replace the principal's control fields. Long-term facts are written with update-page; this payload does not accept summary." ;;
    list-persons) cat <<'EOF'
usage: jarvis-tools list-persons [--role leader|key|colleague|other]
                                 [--keyword TEXT] [--limit N] [--config PATH]
List compact person summaries. Use get-person for full details.
EOF
      ;;
    get-person) cat <<'EOF'
usage: jarvis-tools get-person --open-id OPEN_ID [--config PATH]
Get one person by exact Feishu open_id. Long-term facts are on get-page; use
list-facts for history detail.
EOF
      ;;
    create-person) payload_help "create-person" "Create one person." ;;
    update-person) payload_id_help "update-person" "Replace one person's control fields. Long-term facts are written with update-page; this payload does not accept summary." ;;
    delete-person) delete_id_help "delete-person" "Delete one person." ;;
    query-resources) cat <<'EOF'
usage: jarvis-tools query-resources [--project-id ID] [--person-open-id OPEN_ID] [--principal-only] [--keyword TEXT] [--limit N] [--config PATH]
Query active managed resources such as project repos, documents, links and notes.
EOF
      ;;
    get-resource) cat <<'EOF'
usage: jarvis-tools get-resource --id ID [--config PATH]
Get one managed resource in full.
EOF
      ;;
    create-resource) payload_help "create-resource" "Create one managed resource." ;;
    update-resource) payload_id_help "update-resource" "Replace one managed resource's control fields. Long-term facts are written with update-page; this payload does not accept summary." ;;
    touch-resource) delete_id_help "touch-resource" "Mark one enabled managed resource as freshly active without changing its content." ;;
    delete-resource) delete_id_help "delete-resource" "Delete one managed resource." ;;
    query-messages) cat <<'EOF'
usage: jarvis-tools query-messages [--chat-id CHAT_ID] [--sender-open-id OPEN_ID]
                                   [--keyword TEXT] [--date YYYY-MM-DD]
                                   [--message-ids ID,ID,...]
                                   [--limit N] [--config PATH]
Query locally captured messages, newest first. At least one narrowing filter is
recommended. Content is returned because it is the evidence being queried;
--date uses capture.timezone; --limit defaults to 20 and must not exceed 100.
--message-ids exactly matches original message IDs and returns only id/message_id.
Use --limit 100 for batches; the number of requested IDs must not exceed limit.
EOF
      ;;
    get-message) cat <<'EOF'
usage: jarvis-tools get-message --id ID [--config PATH]
Load one locally captured message by its database ID, including original content.
EOF
      ;;
    get-todo-event) cat <<'EOF'
usage: jarvis-tools get-todo-event --id ID [--config PATH]
Load one Todo lifecycle event addressed by a Fact source pointer.
EOF
      ;;
    get-task-event) cat <<'EOF'
usage: jarvis-tools get-task-event --id ID [--config PATH]
Load one Task lifecycle event addressed by a Fact source pointer.
EOF
      ;;
    query-captured-resources) cat <<'EOF'
usage: jarvis-tools query-captured-resources [--chat-id CHAT_ID]
                                             [--message-id MESSAGE_ID]
                                             [--resource-type TYPE]
                                             [--keyword TEXT] [--limit N]
                                             [--config PATH]
List captured attachment/document summaries without local_path or extracted_text.
Use get-captured-resource after selecting one item.
EOF
      ;;
    get-captured-resource) cat <<'EOF'
usage: jarvis-tools get-captured-resource --id ID [--config PATH]
Load one captured resource in full, including local_path and extracted_text.
EOF
      ;;
    get-shared-memory) cat <<'EOF'
usage: jarvis-tools get-shared-memory [--config PATH]
Read the complete shared memory Markdown.
EOF
      ;;
    set-shared-memory) cat <<'EOF'
usage: jarvis-tools set-shared-memory [--content TEXT|-] [--config PATH]
Replace shared memory. The complete content must not exceed 2000 characters.
EOF
      ;;
    list-skills) cat <<'EOF'
usage: jarvis-tools list-skills [--keyword TEXT] [--config PATH]
List enabled and disabled Skill summaries. Use get-skill for full content.
EOF
      ;;
    get-skill) cat <<'EOF'
usage: jarvis-tools get-skill --name NAME [--config PATH]
Read the complete content of one locally managed Skill.
EOF
      ;;
    append-shared-memory) cat <<'EOF'
usage: jarvis-tools append-shared-memory [--note TEXT|-] [--config PATH]
Atomically append one non-empty entry. The result must not exceed 2000 characters.
Use --note - or omit it to read stdin.
EOF
      ;;
    append-fact) cat <<'EOF'
usage: jarvis-tools append-fact --subject-type TYPE --subject-id ID
                              [--description TEXT|-] [--occurred-at RFC3339]
                              --source KIND [--source-id ID] [--config PATH]

Record one evidence index entry. description is a short retrieval anchor, not
the current conclusion; current knowledge belongs on the entity page.

  --subject-type  what the fact is about: project, group, person or task are the
                  types read back today. If the fact genuinely belongs to
                  something else, write that instead of forcing a fit — the type
                  is not a fixed list.
  --subject-id    the numeric id of that subject.
  --description   at most 200 characters identifying the relevant event and
                  people. Use --description - or omit it to read stdin.
  --occurred-at   when it happened (defaults to now). Pass it explicitly when
                  recording something you learned after the event.
  --source        message, todo_event, task_event, execution_run, resource, or
                  system.
  --source-id     required for raw material sources; forbidden for system.

example:
  jarvis-tools append-fact --subject-type project --subject-id 3 \
    --source message --source-id 91 --description "讨论确认 Fact 只保留证据索引"
EOF
      ;;
    append-facts-batch) cat <<'EOF'
usage: jarvis-tools append-facts-batch --payload JSON|- [--config PATH]

Record one batch of facts in one request.

  --payload  JSON array of fact objects. Each fact must include
             subject_type, subject_id, description and source.
             Optional: occurred_at. source_id is required for message,
             todo_event, task_event, execution_run and resource, and forbidden
             for system. description is limited to 200 characters.
             Unknown fields are rejected before the request is sent.

  --payload - reads from stdin. Omit it to pass --payload text directly.

example:
  cat <<'TXT' | jarvis-tools append-facts-batch --payload -
  [
    {"subject_type":"project","subject_id":3,"description":"消息确认本周验收窗口已冻结","source":"message","source_id":91},
    {"subject_type":"task","subject_id":18,"description":"执行结果显示开发完成、待验收","source":"execution_run","source_id":52}
  ]
  TXT
EOF
      ;;
    list-facts) cat <<'EOF'
usage: jarvis-tools list-facts --subject-type TYPE --subject-id ID
                             [--date YYYY-MM-DD] [--limit N] [--config PATH]

Read a subject's evidence indexes, newest first. description is only a retrieval
anchor; follow source_kind/source_id to the raw material before relying on it.
--date narrows to one natural day in capture.timezone; --limit defaults to 20
and must not exceed 100.

example:
  jarvis-tools list-facts --subject-type group --subject-id 12 --date 2026-08-02
EOF
      ;;
    get-page) cat <<'EOF'
usage: jarvis-tools get-page --type TYPE --id N [--config PATH]
Read one entity's long-term fact page. TYPE is principal, person, project,
key_matter, group or resource. Returns the full summary, character count and
limit, updated_at for CAS, outbound and back links, and the subject's fact
count without fact content. Use list-facts for history detail.
EOF
      ;;
    update-page) cat <<'EOF'
usage: jarvis-tools update-page --type TYPE --id N --content -|TEXT
                               --if-unchanged-since TS [--config PATH]
Replace one entity's long-term fact page. TYPE is principal, person, project,
key_matter, group or resource. --content - reads stdin. --if-unchanged-since is
the updated_at from get-page; a 409 response returns the current page so the
caller can re-merge.
EOF
      ;;
    list-pages) cat <<'EOF'
usage: jarvis-tools list-pages [--type TYPE] [--all] [--stale-days N]
                              [--over-limit] [--config PATH]
List long-term fact page indexes. TYPE is principal, person, project,
key_matter, group or resource. Default is active entities only; --all includes
inactive ones. --stale-days and --over-limit are inspection filters.
EOF
      ;;
    list-backlinks) cat <<'EOF'
usage: jarvis-tools list-backlinks --type TYPE --id N [--config PATH]
List pages that reference this entity. TYPE is principal, person, project,
key_matter, group or resource.
EOF
      ;;
    list-todos) cat <<'EOF'
usage: jarvis-tools list-todos [--date YYYY-MM-DD] [--status S] [--limit N]
                              [--project-id N] [--group-id N] [--page N] [--query TEXT]
                              [--source-message-id MESSAGE_ID] [--config PATH]

List compact action-clue summaries newest-evidence first. --date narrows by
last_evidence_at to one natural day in capture.timezone. --limit defaults to 20.
Use get-todo for description, context, source evidence, resolution and the
frozen snapshot.

--group-id is the sharper scope: every clue comes from a chat, while
--project-id only matches once that chat is bound to a project.

example:
  jarvis-tools list-todos --date 2026-08-02 --status extracted
  jarvis-tools list-todos --group-id 7 --status observing
EOF
      ;;
    list-delegations) cat <<'EOF'
usage: jarvis-tools list-delegations [--state open|closed|all] [--query TEXT] [--page N] [--limit N] [--config PATH]
IDs are M3 Todo IDs; materialized/Task done does not mean delivered.
EOF
      ;;
    get-delegation) cat <<'EOF'
usage: jarvis-tools get-delegation --id TODO_ID [--config PATH]
Returns source_payload unchanged, current content, closed_at and version.
EOF
      ;;
    update-delegation) payload_id_help "update-delegation" "Payload: expected_version, content (any valid JSON), actor, optional closed (boolean). Never changes source or Task state. Version 0 means not checked yet." ;;
    list-delegation-tasks) cat <<'EOF'
usage: jarvis-tools list-delegation-tasks --id TODO_ID [--page N] [--limit N] [--config PATH]
All states, newest first. Includes the initial materialized check and later Tasks with source.delegation_id or annotation.delegation_id.
EOF
      ;;
    list-tasks) cat <<'EOF'
usage: jarvis-tools list-tasks [--date YYYY-MM-DD] [--status S] [--limit N]
                              [--project-id N] [--group-id N] [--page N] [--query TEXT]
                              [--source-message-id MESSAGE_ID] [--action-type TYPE]
                              [--config PATH]

List compact task summaries. --date narrows by COALESCE(last_progress_at,
created_at) to one natural day in capture.timezone. --limit defaults to 20.
Without --status, all task statuses are queried. Use get-task for details and
recent history.

--group-id matches through the source clue, so manual, scheduled and proactive
tasks belong to no group and are excluded by it.

example:
  jarvis-tools list-tasks --date 2026-08-02 --status done,executing
  jarvis-tools list-tasks --project-id 44 --status done
EOF
      ;;
    get-task | get-todo) cat <<'EOF'
usage: jarvis-tools get-task|get-todo --id ID [--context conversation|background|SECTION|full]
                                    [--message-id MESSAGE_ID] [--config PATH]
Default: brief, scene, complete source messages, and available context sections.
Use --context to read a frozen section, or --message-id for one frozen message.
These options are mutually exclusive. get-todo also accepts --revision N to
reject a read if the clue has been re-extracted since you read its overview.
EOF
      ;;
    list-task-runs) cat <<'EOF'
usage: jarvis-tools list-task-runs --id TASK_ID [--page N] [--limit N] [--config PATH]
Read paginated run summaries (default page 1, 20 per page), including failures.
EOF
      ;;
    get-task-run) cat <<'EOF'
usage: jarvis-tools get-task-run --id RUN_ID [--include-prompt] [--config PATH]
Read complete output, effects and failure details for one execution attempt.
EOF
      ;;
    create-task) cat <<'EOF'
usage: jarvis-tools create-task [--payload JSON|-] [--config PATH]

Create one ordinary Task and hand it to the strong M5 executor. This command is
only available when JARVIS_AGENT_STAGE=proactive. The payload uses the existing
POST /api/tasks contract: title, action_type, target, background, source_payload
and optional project_id. source_type=proactive is enforced.
EOF
      ;;
    start-task) cat <<'EOF'
usage: jarvis-tools start-task --id ID [--config PATH]

Start one existing pending Task with the strong M5 executor. This command is
only available when JARVIS_AGENT_STAGE=proactive. It returns after M5 claims the
Task; use get-task in a later heartbeat to inspect and verify the result.
EOF
      ;;
    update-task) cat <<'EOF'
usage: jarvis-tools update-task --id ID [--payload JSON|-] [--config PATH]

Update the mutable current surface of one non-terminal Task. This command is
only available when JARVIS_AGENT_STAGE=proactive. The payload requires
expected_version, reason, and at least one of title, target, summary or
instruction. source_payload remains frozen. instruction is appended for M5
rather than rewriting source evidence. A needs_human Task only accepts
summary updates so an Agent cannot silently change the goal behind a question
the principal is already looking at.

example:
  jarvis-tools update-task --id 42 --payload '{"expected_version":2,"summary":"权限申请仍有效，等待 owner 审批","instruction":"恢复后先重新核验权限，再继续转换文档","reason":"跨日后等待条件仍有效，补充最新状态而不是关闭"}'
EOF
      ;;
    close-task) cat <<'EOF'
usage: jarvis-tools close-task --id ID [--payload JSON|-] [--config PATH]

Close one existing non-terminal Task. This command is only available when
JARVIS_AGENT_STAGE=proactive. The payload must contain expected_version and a
non-empty result object. Put the close result in result.summary and optional
supporting data in result.evidence; the server records actor=proactive and
stage=proactive_closed.

example:
  jarvis-tools close-task --id 42 --payload '{"expected_version":2,"result":{"summary":"关闭结果","evidence":"支持材料"}}'
EOF
      ;;
    notice-principal) cat <<'EOF'
usage: jarvis-tools notice-principal [--payload JSON|- | --payload-file PATH] [--config PATH]

Send one Bot card to the configured principal. No recipient or card JSON needed.
Required: content (Markdown), idempotency_key (stable, <=50 bytes).
Optional: type (defaults to Notice), links [{label,url}], details (folded
Markdown), extra (free text or open JSON, displayed in a supplemental panel),
task_id (defaults to JARVIS_TASK_ID; validates/audits the task and adds its details link).
The task link uses the runtime listen address; packaged local links require the
computer running Jarvis. Use links for business materials, not hand-built task URLs.

Type suggestions: Notice, Update, Reminder, Alert, Brief. These are examples,
not an enum; custom words work unchanged. Type never selects a workflow.
Write 1–3 natural sentences of content, opening with a brief description of
what happened. There is no separate title field or headline. Do not add a
heading, bold headline or "Title:" label. Put long explanation in details and
original sources in links. Optional sections can be omitted.

Reuse the same idempotency_key on retry. An error can contain a partial delivery
receipt: inspect message_id/send_response, prior run effects and
var/log/principal-notices.jsonl before retry.
The Feishu deduplication window is limited; this is not exactly-once delivery.
Success returns verified, message_id, chat_id, url and effect. M5 records the
returned effect verbatim in its run effects. Sending does not change Task state.

example:
  jarvis-tools notice-principal --payload-file notice.json
  jarvis-tools notice-principal --payload - < notice.json
EOF
      ;;
    append-clue) cat <<'EOF'
usage: jarvis-tools append-clue --source SOURCE --external-id ID --title TEXT
                               [--content TEXT|-] [--occurred-at RFC3339] [--config PATH]

Deliver one observed fact into the evidence stream so M3 can judge it. Report
only what you actually saw; do not classify it, rate it, or chase follow-up
material — working out what the fact means is M3's job.

  --source       lowercase snake_case producer id, e.g. feishu_meeting. Picks
                 the clue channel; a new source creates its channel on first use.
  --external-id  producer-side id used for idempotency. Redelivering the same
                 (source, external-id) returns inserted=false and changes nothing.
  --title        one line stating the fact, e.g. "会议结束：公会基建Agent 日会".
  --content      the raw detail. Use --content - or omit it to read stdin.
  --occurred-at  when the fact happened (defaults to now).

example:
  jarvis-tools append-clue --source feishu_meeting --external-id 7667030332496007223 \
    --title '会议结束：公会基建Agent 日会' --occurred-at 2026-07-27T14:01:00+08:00 --content - <<'TXT'
  会议 ID：7667030332496007223
  时间：2026-07-27 11:45 ~ 14:01
  参会人：...
  TXT
EOF
      ;;
    list-scheduled-tasks) cat <<'EOF'
usage: jarvis-tools list-scheduled-tasks [--status binding|active|running|completed] [--limit N] [--config PATH]
List compact time-trigger summaries. binding entries are owned by waiting Tasks.
Use get-scheduled-task for the instruction, context and latest result.
EOF
      ;;
    get-scheduled-task) cat <<'EOF'
usage: jarvis-tools get-scheduled-task --id ID [--config PATH]
Get one time trigger in full.
EOF
      ;;
    create-scheduled-task) cat <<'EOF'
usage: jarvis-tools create-scheduled-task [--payload JSON|-] [--config PATH]
Create a trigger for an independent new task. The payload must contain title,
instruction, context_snapshot, schedule_type and its matching schedule field.

once example:
  {"title":"明早检查进展","instruction":"查询项目最新进展","context_snapshot":{},"schedule_type":"once","run_at":"2026-07-25T09:00:00+08:00"}
daily example:
  {"title":"每日汇总","instruction":"汇总今日进展","context_snapshot":{},"schedule_type":"daily","daily_time":"18:00"}
interval example:
  {"title":"轮询状态","instruction":"检查任务是否完成","context_snapshot":{},"schedule_type":"interval","interval_minutes":60}
EOF
      ;;
    update-scheduled-task) cat <<'EOF'
usage: jarvis-tools update-scheduled-task --id ID [--payload JSON|-] [--config PATH]
Replace one standalone trigger using the same payload contract as create.
Continuation triggers owned by waiting Tasks cannot be edited.
EOF
      ;;
    trigger-scheduled-task) cat <<'EOF'
usage: jarvis-tools trigger-scheduled-task --id ID [--config PATH]
Run one standalone trigger immediately.
EOF
      ;;
    set-todo-status) cat <<'EOF'
usage: jarvis-tools set-todo-status --id TODO_ID --status observing|extracted
                                    --reason TEXT|- [--actor NAME] [--config PATH]

Move one clue between the two states that mean nobody is acting on it.

  observing  Nothing to do right now, but keep the clue in view. No Task is
             created; later evidence can bring it back for execution.
  extracted  Hand the clue back for direct Task materialization and execution.

Only observing and extracted are accepted target statuses; every other target
status is rejected by the server.
Pass "-" to --reason to read the reason from stdin.
Actor defaults to JARVIS_AGENT_STAGE. Outside a Jarvis Agent process, pass
--actor explicitly so the event provenance stays truthful.

  jarvis-tools set-todo-status --id 412 --status observing \
    --reason "对方已经自己处理完了，这里不需要我动手，先留着看"
EOF
      ;;
    yield-until) cat <<'EOF'
usage: jarvis-tools yield-until --at RFC3339 [--reason TEXT|-] [--config PATH]
Pause the current executing Task and arrange its continuation. JARVIS_TASK_ID
must be provided by the Task runner.
EOF
      ;;
    delete-scheduled-task) cat <<'EOF'
usage: jarvis-tools delete-scheduled-task --id ID [--config PATH]
Delete a standalone trigger. A continuation owned by a waiting Task cannot be deleted.
EOF
      ;;
    *) return 1 ;;
  esac
}

payload_help() {
  local command_name="$1" description="$2"
  printf 'usage: jarvis-tools %s [--payload JSON|-] [--config PATH]\n%s The payload must be a JSON object; use - or omit it to read stdin.\n' \
    "$command_name" "$description"
}

