cmd_trigger_scheduled_task() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "trigger-scheduled-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write POST "/api/scheduled-tasks/${ID}/trigger" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# set-todo-status parks a clue or hands it back to Task materialization. The server
# owns which transitions are legal; this only names the caller and the reason.
cmd_set_todo_status() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "set-todo-status requires positive --id"
  case "$STATUS" in
    observing|extracted) ;;
    *) fail "set-todo-status --status must be observing or extracted" ;;
  esac
  local reason
  if [[ "$REASON" == "-" ]]; then
    reason="$(cat)"
  else
    reason="$REASON"
  fi
  [[ -n "${reason//[[:space:]]/}" ]] || fail "set-todo-status reason is empty"
  local actor="$ACTOR"
  if [[ -z "$actor" ]]; then
    actor="${JARVIS_AGENT_STAGE:-}"
  fi
  [[ -n "${actor//[[:space:]]/}" ]] || fail "set-todo-status requires --actor outside a Jarvis Agent process"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --arg status "$STATUS" --arg actor "$actor" --arg reason "$reason" \
    '{status:$status,actor:$actor,reason:$reason}')"
  body="$(api_write PATCH "/api/todos/${ID}/status" "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_yield_until() {
  reset_flags
  consume_flags "$@"
  [[ "${JARVIS_TASK_ID:-}" =~ ^[1-9][0-9]*$ ]] || fail "yield-until requires JARVIS_TASK_ID from the Task runner"
  [[ -n "$AT" ]] || fail "yield-until requires --at"
  local reason
  if [[ "$REASON" == "-" ]]; then
    reason="$(cat)"
  else
    reason="$REASON"
  fi
  [[ -n "${reason//[[:space:]]/}" ]] || fail "yield-until reason is empty"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local payload body
  payload="$(jq -cn --argjson task_id "$JARVIS_TASK_ID" --arg run_at "$AT" --arg reason "$reason" \
    '{task_id:$task_id,run_at:$run_at,reason:$reason}')"
  body="$(api_write POST /api/scheduled-tasks/yield "$payload")"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

cmd_delete_scheduled_task() {
  reset_flags
  consume_flags "$@"
  [[ "$ID" =~ ^[1-9][0-9]*$ ]] || fail "delete-scheduled-task requires positive --id"
  API_BASE="$(resolve_api_base "$CONFIG_PATH")"
  local body
  body="$(api_write DELETE "/api/scheduled-tasks/${ID}" '{}')"
  emit "$(printf '%s' "$body" | jq -c '.data')"
}

# --- main -------------------------------------------------------------------

[[ $# -ge 1 ]] || usage_error
SUBCOMMAND="$1"
shift

if [[ "$SUBCOMMAND" == "--help" || "$SUBCOMMAND" == "-h" ]]; then
  print_usage
  exit 0
fi
if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  if ! print_subcommand_help "$SUBCOMMAND"; then
    fail "unknown subcommand \"${SUBCOMMAND}\""
  fi
  exit 0
fi

case "$SUBCOMMAND" in
  list-projects)  cmd_list_projects "$@" ;;
  get-project)    cmd_get_project "$@" ;;
  create-project) cmd_payload_create create-project POST /api/projects "$@" ;;
  update-project) cmd_payload_by_id update-project PUT /api/projects "$@" ;;
  archive-project) cmd_delete_by_id archive-project /api/projects "$@" ;;
  list-key-matters) cmd_list_key_matters "$@" ;;
  get-key-matter) cmd_get_key_matter "$@" ;;
  create-key-matter) cmd_payload_create create-key-matter POST /api/key-matters "$@" ;;
  update-key-matter) cmd_payload_by_id update-key-matter PUT /api/key-matters "$@" ;;
  touch-key-matter) cmd_touch_by_id touch-key-matter /api/key-matters "$@" ;;
  close-key-matter) cmd_delete_by_id close-key-matter /api/key-matters "$@" ;;
  list-groups)    cmd_list_groups "$@" ;;
  get-group)      cmd_get_group "$@" ;;
  get-context)    cmd_get_context "$@" ;;
  update-group)   cmd_payload_by_id update-group PUT /api/groups "$@" ;;
  get-principal)  cmd_get_principal "$@" ;;
  update-principal) cmd_payload_create update-principal PUT /api/profile "$@" ;;
  list-persons)   cmd_list_persons "$@" ;;
  get-person)     cmd_get_person "$@" ;;
  create-person)  cmd_payload_create create-person POST /api/persons "$@" ;;
  update-person)  cmd_payload_by_id update-person PUT /api/persons "$@" ;;
  delete-person)  cmd_delete_by_id delete-person /api/persons "$@" ;;
  query-resources)      cmd_query_resources "$@" ;;
  get-resource)         cmd_get_resource "$@" ;;
  create-resource)      cmd_payload_create create-resource POST /api/resources "$@" ;;
  update-resource)      cmd_payload_by_id update-resource PUT /api/resources "$@" ;;
  touch-resource)       cmd_touch_by_id touch-resource /api/resources "$@" ;;
  delete-resource)      cmd_delete_by_id delete-resource /api/resources "$@" ;;
  query-messages)       cmd_query_messages "$@" ;;
  query-captured-resources) cmd_query_captured_resources "$@" ;;
  get-captured-resource) cmd_get_captured_resource "$@" ;;
  get-shared-memory)    cmd_get_shared_memory "$@" ;;
  list-skills)          cmd_list_skills "$@" ;;
  get-skill)            cmd_get_skill "$@" ;;
  append-shared-memory) cmd_append_shared_memory "$@" ;;
  append-clue)          cmd_append_clue "$@" ;;
  append-fact)          cmd_append_fact "$@" ;;
  list-facts)           cmd_list_facts "$@" ;;
  list-relations)       cmd_list_relations "$@" ;;
  create-relation)      cmd_payload_create create-relation POST /api/relation-facts "$@" ;;
  update-relation)      cmd_payload_by_id update-relation PUT /api/relation-facts "$@" ;;
  delete-relation)      cmd_delete_by_id delete-relation /api/relation-facts "$@" ;;
  list-todos)           cmd_list_todos "$@" ;;
  get-todo)             cmd_get_todo "$@" ;;
  list-tasks)           cmd_list_tasks "$@" ;;
  get-task)             cmd_get_task "$@" ;;
  create-task)          cmd_create_task "$@" ;;
  start-task)           cmd_start_task "$@" ;;
  update-task)          cmd_update_task "$@" ;;
  close-task)           cmd_close_task "$@" ;;
  list-scheduled-tasks) cmd_list_scheduled_tasks "$@" ;;
  get-scheduled-task)   cmd_get_scheduled_task "$@" ;;
  create-scheduled-task) cmd_create_scheduled_task "$@" ;;
  update-scheduled-task) cmd_update_scheduled_task "$@" ;;
  trigger-scheduled-task) cmd_trigger_scheduled_task "$@" ;;
  set-todo-status)      cmd_set_todo_status "$@" ;;
  yield-until)          cmd_yield_until "$@" ;;
  delete-scheduled-task) cmd_delete_scheduled_task "$@" ;;
  *)
    fail "unknown subcommand \"${SUBCOMMAND}\"; run jarvis-tools --help"
    ;;
esac
