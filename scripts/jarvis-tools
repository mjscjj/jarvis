#!/usr/bin/env bash
# jarvis-tools: canonical Jarvis query/controlled-write CLI for agents.
# All data access goes through jarvis-server HTTP API (curl + jq).
#
# Output contract: data commands → compact JSON on stdout only; help → text on
# stdout; errors → stderr + exit 1.
set -euo pipefail

fail() {
  echo "jarvis-tools error: $*" >&2
  exit 1
}

command -v curl >/dev/null 2>&1 || fail "curl is required but not found in PATH"
command -v jq >/dev/null 2>&1 || fail "jq is required but not found in PATH"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

print_usage() {
  cat <<'EOF'
usage: jarvis-tools <subcommand> [flags]

principles:
  Simple first. Each command serves one concrete intent; there is no generic API
  passthrough, compatibility layer or fallback for imagined future needs.
  Progressive loading. Start with list/query summaries, then get one matched
  object. Large prompts, run outputs and captured resource text are opt-in.

subcommands:
  list-projects          List projects
  get-project            Get one project's full background
  create-project         Create a project from a JSON payload
  update-project         Replace a project's editable background
  archive-project        Archive a project
  list-key-matters       List open key matters
  get-key-matter         Get one key matter's full background
  create-key-matter      Create a key matter from a JSON payload
  update-key-matter      Replace a key matter's editable background
  touch-key-matter       Mark an open key matter as freshly active
  close-key-matter       Close a key matter
  list-groups            Search Feishu groups
  get-group              Get one Feishu group by chat_id
  get-context            Assemble current principal/project/chat work context
  update-group           Replace one group's curated background
  get-principal          Get the assistant owner's profile
  update-principal       Replace the assistant owner's profile
  list-persons           List important people, optionally by role
  get-person             Get one person by Feishu open_id
  create-person          Create a person from a JSON payload
  update-person          Replace a person's editable background
  delete-person          Delete a person
  query-resources        Query managed resource summaries
  get-resource           Get one managed resource
  create-resource        Create a managed resource
  update-resource        Replace a managed resource
  touch-resource         Mark an enabled managed resource as freshly active
  delete-resource        Delete a managed resource
  query-messages         Query locally captured Feishu messages
  query-captured-resources List captured attachment/document summaries
  get-captured-resource  Load one captured resource including extracted text
  get-shared-memory      Read shared memory
  list-skills            List locally managed Skills
  get-skill              Read one locally managed Skill
  append-shared-memory   Append one entry to shared memory
  append-clue            Hand M2 one observed fact as evidence for M3
  append-fact            Record one fact about a project, group, person or other subject
  list-facts             Read a subject's recorded facts, optionally for one day
  list-relations         Read relation facts for one entity
  create-relation        Create a natural-language relation fact
  update-relation        Replace a relation fact's editable content
  delete-relation        Delete a relation fact
  list-todos             List action clues, optionally for one day
  get-todo               Get one clue with the details omitted from summaries
  list-tasks             List tasks, optionally for one day
  get-task               Get one task with bounded execution history
  create-task            Create a normal Task for strong M5 (proactive agent only)
  start-task             Start one pending Task with strong M5 (proactive agent only)
  update-task            Update one non-terminal Task (proactive agent only)
  close-task             Close one verified resolved Task (proactive agent only)
  list-scheduled-tasks   List time-triggered tasks
  get-scheduled-task     Get one time-triggered task
  create-scheduled-task  Create a time trigger for a new task
  update-scheduled-task  Update a standalone time trigger
  trigger-scheduled-task Trigger a standalone time trigger now
  set-todo-status        Park a clue, or hand it back for execution
  yield-until            Pause the current task until a future time
  delete-scheduled-task  Delete a standalone time trigger

Run "jarvis-tools <subcommand> --help" for command-specific flags.
EOF
}

usage_error() {
  print_usage >&2
  exit 1
}

print_subcommand_help() {
  case "$1" in
    list-projects) cat <<'EOF'
usage: jarvis-tools list-projects [--keyword TEXT] [--limit N] [--config PATH]
List compact project summaries. Use get-project for full project background.
EOF
      ;;
    get-project) cat <<'EOF'
usage: jarvis-tools get-project (--id ID | --code CODE) [--config PATH]
Get one project's full background. Use list-facts and list-relations to drill
into history and relationships only when needed.
EOF
      ;;
    create-project) payload_help "create-project" "Create one project." ;;
    update-project) payload_id_help "update-project" "Replace one project's complete editable payload." ;;
    archive-project) delete_id_help "archive-project" "Archive one project; this does not hard-delete it." ;;
    list-key-matters) cat <<'EOF'
usage: jarvis-tools list-key-matters [--keyword TEXT] [--limit N] [--config PATH]
List compact open key matters. Use get-key-matter for full background.
EOF
      ;;
    get-key-matter) cat <<'EOF'
usage: jarvis-tools get-key-matter --id ID [--config PATH]
Get one key matter's full background. Use list-facts and list-relations to drill
into history and relationships only when needed.
EOF
      ;;
    create-key-matter) payload_help "create-key-matter" "Create one key matter." ;;
    update-key-matter) payload_id_help "update-key-matter" "Replace one key matter's complete editable payload." ;;
    touch-key-matter) delete_id_help "touch-key-matter" "Mark one open key matter as freshly active without changing its content." ;;
    close-key-matter) delete_id_help "close-key-matter" "Close one key matter; this does not hard-delete it." ;;
    list-groups) cat <<'EOF'
usage: jarvis-tools list-groups [--keyword TEXT] [--limit N] [--config PATH]
Search compact Feishu group summaries. Use get-group for full background.
EOF
      ;;
    get-group) cat <<'EOF'
usage: jarvis-tools get-group --chat-id CHAT_ID [--config PATH]
Get the Jarvis group binding and background for an exact Feishu chat_id.
EOF
      ;;
    get-context) cat <<'EOF'
usage: jarvis-tools get-context [--chat-id CHAT_ID] [--project-id ID] [--config PATH]
Assemble the canonical current context. An explicit project wins; otherwise a
chat resolves through its Jarvis group binding. With neither flag, returns the
principal-level global context.
EOF
      ;;
    update-group) payload_id_help "update-group" "Replace one group's curated background fields only." ;;
    get-principal) cat <<'EOF'
usage: jarvis-tools get-principal [--config PATH]
Get the profile of the person Jarvis assists.
EOF
      ;;
    update-principal) payload_help "update-principal" "Replace the principal profile." ;;
    list-persons) cat <<'EOF'
usage: jarvis-tools list-persons [--role leader|key|colleague|other]
                                 [--keyword TEXT] [--limit N] [--config PATH]
List compact person summaries. Use get-person for full details.
EOF
      ;;
    get-person) cat <<'EOF'
usage: jarvis-tools get-person --open-id OPEN_ID [--config PATH]
Get one person by exact Feishu open_id. Use list-relations for relationships.
EOF
      ;;
    create-person) payload_help "create-person" "Create one person." ;;
    update-person) payload_id_help "update-person" "Replace one person's complete editable payload." ;;
    delete-person) delete_id_help "delete-person" "Delete one person." ;;
    query-resources) cat <<'EOF'
usage: jarvis-tools query-resources [--project-id ID] [--person-open-id OPEN_ID] [--principal-only] [--keyword TEXT] [--limit N] [--config PATH]
Query active managed resources such as project repos, documents, links and notes.
EOF
      ;;
    get-resource) cat <<'EOF'
usage: jarvis-tools get-resource --id ID [--config PATH]
Get one managed resource in full.
EOF
      ;;
    create-resource) payload_help "create-resource" "Create one managed resource." ;;
    update-resource) payload_id_help "update-resource" "Replace one managed resource's editable payload." ;;
    touch-resource) delete_id_help "touch-resource" "Mark one enabled managed resource as freshly active without changing its content." ;;
    delete-resource) delete_id_help "delete-resource" "Delete one managed resource." ;;
    query-messages) cat <<'EOF'
usage: jarvis-tools query-messages [--chat-id CHAT_ID] [--sender-open-id OPEN_ID]
                                   [--keyword TEXT] [--date YYYY-MM-DD]
                                   [--limit N] [--config PATH]
Query locally captured messages, newest first. At least one narrowing filter is
recommended. Content is returned because it is the evidence being queried;
--limit defaults to 20 and must not exceed 100.
EOF
      ;;
    query-captured-resources) cat <<'EOF'
usage: jarvis-tools query-captured-resources [--chat-id CHAT_ID]
                                             [--message-id MESSAGE_ID]
                                             [--resource-type TYPE]
                                             [--keyword TEXT] [--limit N]
                                             [--config PATH]
List captured attachment/document summaries without local_path or extracted_text.
Use get-captured-resource after selecting one item.
EOF
      ;;
    get-captured-resource) cat <<'EOF'
usage: jarvis-tools get-captured-resource --id ID [--config PATH]
Load one captured resource in full, including local_path and extracted_text.
EOF
      ;;
    get-shared-memory) cat <<'EOF'
usage: jarvis-tools get-shared-memory [--config PATH]
Read the complete shared memory Markdown.
EOF
      ;;
    list-skills) cat <<'EOF'
usage: jarvis-tools list-skills [--keyword TEXT] [--config PATH]
List enabled and disabled Skill summaries. Use get-skill for full content.
EOF
      ;;
    get-skill) cat <<'EOF'
usage: jarvis-tools get-skill --name NAME [--config PATH]
Read the complete content of one locally managed Skill.
EOF
      ;;
    append-shared-memory) cat <<'EOF'
usage: jarvis-tools append-shared-memory [--note TEXT|-] [--config PATH]
Atomically append one non-empty entry. Use --note - or omit it to read stdin.
EOF
      ;;
    append-fact) cat <<'EOF'
usage: jarvis-tools append-fact --subject-type TYPE --subject-id ID
                              [--description TEXT|-] [--occurred-at RFC3339]
                              [--source KIND] [--source-id ID] [--config PATH]

Record one thing that happened, bound to whatever it is about. Facts are read
back as a subject's recent history and as the evidence behind the daily digests,
so write one when you learn something worth remembering tomorrow — a decision,
a delivery, a blocker, a change of direction. Do not write one for every command
you run.

  --subject-type  what the fact is about: project, group, person or task are the
                  types read back today. If the fact genuinely belongs to
                  something else, write that instead of forcing a fit — the type
                  is not a fixed list.
  --subject-id    the numeric id of that subject.
  --description   the fact itself, in prose, complete enough to make sense weeks
                  later. Use --description - or omit it to read stdin.
  --occurred-at   when it happened (defaults to now). Pass it explicitly when
                  recording something you learned after the event.
  --source        what produced this fact; defaults to the running Task.
  --source-id     optional numeric id for an explicit --source. An explicit
                  source never inherits JARVIS_TASK_ID.

example:
  jarvis-tools append-fact --subject-type project --subject-id 3 --description - <<'TXT'
  事实表方案定稿：复用并泛化 project_event，不新建表。按天总结沿用 daily_digest。
  TXT
EOF
      ;;
    list-facts) cat <<'EOF'
usage: jarvis-tools list-facts --subject-type TYPE --subject-id ID
                             [--date YYYY-MM-DD] [--limit N] [--config PATH]

Read a subject's facts, newest first. Use it before deciding something to see
what already happened, instead of assuming. --date narrows to one natural day in
local time; --limit defaults to 20 and must not exceed 100.

example:
  jarvis-tools list-facts --subject-type group --subject-id 12 --date 2026-08-02
EOF
      ;;
    list-relations) cat <<'EOF'
usage: jarvis-tools list-relations --entity-type TYPE --entity-id ID
                                   [--limit N] [--config PATH]
List relation facts involving one entity. --limit defaults to 20.
EOF
      ;;
    create-relation) payload_help "create-relation" "Create one natural-language relation fact." ;;
    update-relation) payload_id_help "update-relation" "Replace one relation fact's description and validity bounds." ;;
    delete-relation) delete_id_help "delete-relation" "Delete one relation fact." ;;
    list-todos) cat <<'EOF'
usage: jarvis-tools list-todos [--date YYYY-MM-DD] [--status S] [--limit N] [--config PATH]

List compact action-clue summaries newest-evidence first. --date narrows by
last_evidence_at to one local natural day. --limit defaults to 20. Use get-todo
for description, context, source evidence, resolution and the frozen snapshot.

example:
  jarvis-tools list-todos --date 2026-08-02 --status extracted
EOF
      ;;
    get-todo) cat <<'EOF'
usage: jarvis-tools get-todo --id ID [--config PATH]

Get one clue including description, context, open_questions and resolution —
the fields omitted from the summary list in prompts.
EOF
      ;;
    list-tasks) cat <<'EOF'
usage: jarvis-tools list-tasks [--date YYYY-MM-DD] [--status S] [--limit N] [--config PATH]

List compact task summaries. --date narrows by COALESCE(last_progress_at,
created_at) to one local natural day. --limit defaults to 20. Without --status,
all task statuses are queried. Use get-task for details and recent history.

example:
  jarvis-tools list-tasks --date 2026-08-02 --status done,executing
EOF
      ;;
    get-task) cat <<'EOF'
usage: jarvis-tools get-task --id ID [--run-limit N] [--event-limit N]
                             [--include-run-output] [--include-prompt]
                             [--config PATH]

Get one task with bounded recent run summaries, effects, events and task facts.
Defaults: 3 runs and 20 events. Full run output and prompts are excluded unless
explicitly requested.
EOF
      ;;
    create-task) cat <<'EOF'
usage: jarvis-tools create-task [--payload JSON|-] [--config PATH]

Create one ordinary Task and hand it to the strong M5 executor. This command is
only available when JARVIS_AGENT_STAGE=proactive. The payload uses the existing
POST /api/tasks contract: title, action_type, target, background, source_payload
and optional project_id. source_type=proactive is enforced.
EOF
      ;;
    start-task) cat <<'EOF'
usage: jarvis-tools start-task --id ID [--config PATH]

Start one existing pending Task with the strong M5 executor. This command is
only available when JARVIS_AGENT_STAGE=proactive. It returns after M5 claims the
Task; use get-task in a later heartbeat to inspect and verify the result.
EOF
      ;;
    update-task) cat <<'EOF'
usage: jarvis-tools update-task --id ID [--payload JSON|-] [--config PATH]

Update the mutable current surface of one non-terminal Task. This command is
only available when JARVIS_AGENT_STAGE=proactive. The payload requires
expected_version, reason, and at least one of title, target, summary or
instruction. source_payload/background remain frozen. instruction is appended
for M5 rather than rewriting source evidence. An awaiting_approval Task only
accepts summary updates so an Agent cannot silently alter a proposal awaiting
human approval.

example:
  jarvis-tools update-task --id 42 --payload '{"expected_version":2,"summary":"权限申请仍有效，等待 owner 审批","instruction":"恢复后先重新核验权限，再继续转换文档","reason":"跨日后等待条件仍有效，补充最新状态而不是关闭"}'
EOF
      ;;
    close-task) cat <<'EOF'
usage: jarvis-tools close-task --id ID [--payload JSON|-] [--config PATH]

Close one existing non-terminal Task only after verified completion,
cancellation, objective invalidation, or replacement by a surviving Task. This
command is only available when JARVIS_AGENT_STAGE=proactive. Crossing a day,
silence, or missing new evidence is not a close reason. The payload must contain
expected_version and a non-empty result object. Put the concrete close reason in
result.summary and the checked facts in result.evidence; the server records
actor=proactive and stage=proactive_closed.

example:
  jarvis-tools close-task --id 42 --payload '{"expected_version":2,"result":{"summary":"昨日事项已失效，关闭","evidence":"目标会议已结束，且没有仍需交付的产物"}}'
EOF
      ;;
    append-clue) cat <<'EOF'
usage: jarvis-tools append-clue --source SOURCE --external-id ID --title TEXT
                               [--content TEXT|-] [--occurred-at RFC3339] [--config PATH]

Deliver one observed fact into the evidence stream so M3 can judge it. Report
only what you actually saw; do not classify it, rate it, or chase follow-up
material — working out what the fact means is M3's job.

  --source       lowercase snake_case producer id, e.g. feishu_meeting. Picks
                 the clue channel; a new source creates its channel on first use.
  --external-id  producer-side id used for idempotency. Redelivering the same
                 (source, external-id) returns inserted=false and changes nothing.
  --title        one line stating the fact, e.g. "会议结束：公会基建Agent 日会".
  --content      the raw detail. Use --content - or omit it to read stdin.
  --occurred-at  when the fact happened (defaults to now).

example:
  jarvis-tools append-clue --source feishu_meeting --external-id 7667030332496007223 \
    --title '会议结束：公会基建Agent 日会' --occurred-at 2026-07-27T14:01:00+08:00 --content - <<'TXT'
  会议 ID：7667030332496007223
  时间：2026-07-27 11:45 ~ 14:01
  参会人：...
  TXT
EOF
      ;;
    list-scheduled-tasks) cat <<'EOF'
usage: jarvis-tools list-scheduled-tasks [--status binding|active|running|completed] [--limit N] [--config PATH]
List compact time-trigger summaries. binding entries are owned by waiting Tasks.
Use get-scheduled-task for the instruction, context and latest result.
EOF
      ;;
    get-scheduled-task) cat <<'EOF'
usage: jarvis-tools get-scheduled-task --id ID [--config PATH]
Get one time trigger in full.
EOF
      ;;
    create-scheduled-task) cat <<'EOF'
usage: jarvis-tools create-scheduled-task [--payload JSON|-] [--config PATH]
Create a trigger for an independent new task. The payload must contain title,
instruction, context_snapshot, schedule_type and its matching schedule field.

once example:
  {"title":"明早检查进展","instruction":"查询项目最新进展","context_snapshot":{},"schedule_type":"once","run_at":"2026-07-25T09:00:00+08:00"}
daily example:
  {"title":"每日汇总","instruction":"汇总今日进展","context_snapshot":{},"schedule_type":"daily","daily_time":"18:00"}
interval example:
  {"title":"轮询状态","instruction":"检查任务是否完成","context_snapshot":{},"schedule_type":"interval","interval_minutes":60}
EOF
      ;;
    update-scheduled-task) cat <<'EOF'
usage: jarvis-tools update-scheduled-task --id ID [--payload JSON|-] [--config PATH]
Replace one standalone trigger using the same payload contract as create.
Continuation triggers owned by waiting Tasks cannot be edited.
EOF
      ;;
    trigger-scheduled-task) cat <<'EOF'
usage: jarvis-tools trigger-scheduled-task --id ID [--config PATH]
Run one standalone trigger immediately.
EOF
      ;;
    set-todo-status) cat <<'EOF'
usage: jarvis-tools set-todo-status --id TODO_ID --status observing|extracted
                                    --reason TEXT|- [--actor NAME] [--config PATH]

Move one clue between the two states that mean nobody is acting on it.

  observing  Nothing to do right now, but keep the clue in view. No Task is
             created; later evidence can bring it back for execution.
  extracted  Hand the clue back for direct Task materialization and execution.

Only observing and extracted are accepted target statuses; every other target
status is rejected by the server.
Pass "-" to --reason to read the reason from stdin.
Actor defaults to JARVIS_AGENT_STAGE. Outside a Jarvis Agent process, pass
--actor explicitly so the event provenance stays truthful.

  jarvis-tools set-todo-status --id 412 --status observing \
    --reason "对方已经自己处理完了，这里不需要我动手，先留着看"
EOF
      ;;
    yield-until) cat <<'EOF'
usage: jarvis-tools yield-until --at RFC3339 [--reason TEXT|-] [--config PATH]
Pause the current executing Task and arrange its continuation. JARVIS_TASK_ID
must be provided by the Task runner.
EOF
      ;;
    delete-scheduled-task) cat <<'EOF'
usage: jarvis-tools delete-scheduled-task --id ID [--config PATH]
Delete a standalone trigger. A continuation owned by a waiting Task cannot be deleted.
EOF
      ;;
    *) return 1 ;;
  esac
}

payload_help() {
  local command_name="$1" description="$2"
  printf 'usage: jarvis-tools %s [--payload JSON|-] [--config PATH]\n%s The payload must be a JSON object; use - or omit it to read stdin.\n' \
    "$command_name" "$description"
}

payload_id_help() {
  local command_name="$1" description="$2"
  printf 'usage: jarvis-tools %s --id ID [--payload JSON|-] [--config PATH]\n%s The payload must be a JSON object; use - or omit it to read stdin.\n' \
    "$command_name" "$description"
}

delete_id_help() {
  local command_name="$1" description="$2"
  printf 'usage: jarvis-tools %s --id ID [--config PATH]\n%s\n' "$command_name" "$description"
}

# resolve_api_base CONFIG_PATH
# Prefer JARVIS_API_BASE; otherwise require and read server.addr from config.
resolve_api_base() {
  local config_path="$1"
  if [[ -n "${JARVIS_API_BASE:-}" ]]; then
    echo "${JARVIS_API_BASE%/}"
    return
  fi
  local resolved=""
  if [[ -f "$config_path" ]]; then
    resolved="$config_path"
  elif [[ "$config_path" != /* && -f "${REPO_ROOT}/${config_path}" ]]; then
    resolved="${REPO_ROOT}/${config_path}"
  fi
  if [[ -z "$resolved" ]]; then
    fail "config file not found: ${config_path}"
  fi
  local addr
  addr="$(grep -E '^\s*addr:\s*' "$resolved" | head -n1 | sed -E 's/^[[:space:]]*addr:[[:space:]]*"?([^"#]+)"?.*/\1/' | tr -d '[:space:]')"
  if [[ -z "$addr" ]]; then
    fail "could not parse server.addr from ${resolved}"
  fi
  echo "http://${addr}"
}

# api_get PATH_AND_QUERY → prints response body to stdout; fails on HTTP/API error.
api_get() {
  local path_and_query="$1"
  local url="${API_BASE}${path_and_query}"
  local body http_code
  body="$(curl -sS -w '\n%{http_code}' --max-time 30 "$url")" || fail "curl failed for ${url}"
  http_code="$(printf '%s\n' "$body" | tail -n1)"
  body="$(printf '%s\n' "$body" | sed '$d')"
  local code=""
  if printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    code="$(printf '%s' "$body" | jq -r '.code // empty')"
  fi
  # Align with Go jarvis-tools mapNotFound → "not found".
  if [[ "$http_code" == "404" || "$code" == "40420" ]]; then
    fail "not found"
  fi
  if [[ "$http_code" != "200" ]]; then
    fail "HTTP ${http_code} from ${url}: ${body}"
  fi
  if [[ -z "$code" ]]; then
    fail "invalid JSON from ${url}"
  fi
  if [[ "$code" != "0" ]]; then
    fail "API code=${code} from ${url}: ${body}"
  fi
  printf '%s' "$body"
}

# api_write METHOD PATH JSON_BODY → prints response body to stdout.
api_write() {
  local method="$1"
  local path="$2"
  local json_body="$3"
  local url="${API_BASE}${path}"
  local body http_code
  body="$(curl -sS -w '\n%{http_code}' --max-time 30 -X "$method" \
    -H 'Content-Type: application/json' --data "$json_body" "$url")" || fail "curl failed for ${url}"
  http_code="$(printf '%s\n' "$body" | tail -n1)"
  body="$(printf '%s\n' "$body" | sed '$d')"
  local code=""
  if printf '%s' "$body" | jq -e . >/dev/null 2>&1; then
    code="$(printf '%s' "$body" | jq -r '.code // empty')"
  fi
  if [[ "$http_code" == "404" ]]; then
    fail "not found"
  fi
  if [[ "$http_code" != "200" ]]; then
    fail "HTTP ${http_code} from ${url}: ${body}"
  fi
  if [[ -z "$code" || "$code" != "0" ]]; then
    fail "invalid API response from ${url}: ${body}"
  fi
  printf '%s' "$body"
}

# read_note_arg → resolves NOTE: "-" means read from stdin, else literal value.
# Trims a single trailing newline (mirrors Go readContentArg TrimRight "\n").
read_note_arg() {
  local text
  if [[ "$NOTE" == "-" ]]; then
    text="$(cat)"
  else
    text="$NOTE"
  fi
  # strip trailing newlines
  printf '%s' "${text%$'\n'}"
}

# read_payload_object resolves PAYLOAD and validates the one shared contract used
# by world-model writes. The server remains the owner of each payload's fields.
read_payload_object() {
  local command_name="$1" payload
  if [[ "$PAYLOAD" == "-" ]]; then
    payload="$(cat)"
  else
    payload="$PAYLOAD"
  fi
  printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 ||
    fail "${command_name} payload must be a JSON object"
  printf '%s' "$payload"
}

# emit compact JSON (+ newline) to stdout — the ONLY successful stdout write.
emit() {
  printf '%s\n' "$1" | jq -c .
}

# fetch_all_items PATH_PREFIX [QUERY] → prints all items across pages. QUERY is
# passed to every page, without the leading question mark.
fetch_all_items() {
  local path_prefix="$1"
  local query="${2:-}"
  local page=1
  local page_size=100
  local all='[]'
  while true; do
    local body items total n
    local page_query="page=${page}&page_size=${page_size}"
    if [[ -n "$query" ]]; then
      page_query="${query}&${page_query}"
    fi
    body="$(api_get "${path_prefix}?${page_query}")"
    items="$(printf '%s' "$body" | jq -c '.data.items')"
    total="$(printf '%s' "$body" | jq -er '.data.total')"
    n="$(printf '%s' "$items" | jq -er 'length')"
    all="$(jq -nc --argjson a "$all" --argjson b "$items" '$a + $b')"
    if (( page * page_size >= total )) || (( n == 0 )); then
      break
    fi
    page=$((page + 1))
  done
  printf '%s' "$all"
}

