#!/usr/bin/env bash
# Jarvis CLI: fixed, bundled modules; compatible with Bash 3.2.
set -euo pipefail
SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  [[ "$SOURCE_PATH" == /* ]] || SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib/jarvis-tools"
source "${SCRIPT_DIR}/lib/connection.sh"
source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/world.sh"
source "${LIB_DIR}/evidence.sh"
source "${LIB_DIR}/task.sh"
source "${LIB_DIR}/schedule.sh"
source "${LIB_DIR}/memory.sh"
source "${LIB_DIR}/skill.sh"
source "${LIB_DIR}/notify.sh"
source "${LIB_DIR}/commands.sh"
main "$@"
