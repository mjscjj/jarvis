#!/usr/bin/env bash
# Narrow CLI for deterministic Agency OKR product data. It never performs
# semantic matching itself; Skills compose it with generic OKR and external
# read tools.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_URL="${JARVIS_API_BASE:-}"

usage() {
  cat <<'EOF'
usage: agency-okr-tools [--base-url URL] COMMAND [ARGS]

commands:
  text-config --key KEY
  scope
  delete-week --quarter Q --week YYYY-Www
  core-board [--quarter Q]
  board [--quarter Q] [--week YYYY-Www]
  get-kr --id KR_ID
  get-weekly-kr --id KR_ID --week YYYY-Www
  replace-kr-tags --id KR_ID --payload JSON|-
  replace-point-tags --point-id POINT_ID --payload JSON|-
  people-search --query TEXT
  replace-score --target-kind kr|point --id TARGET_ID --payload JSON|-
  delete-score --target-kind kr|point --id TARGET_ID --payload JSON|-
  comments --quarter Q --week YYYY-Www
  create-comment --payload JSON|-
  update-comment --id COMMENT_ID --payload JSON|-
  delete-comment --id COMMENT_ID
  follow-ups --quarter Q --week YYYY-Www
  get-follow-up --id FOLLOW_UP_ID
  create-follow-up --payload JSON|-
  update-follow-up --id FOLLOW_UP_ID --payload JSON|-
  delete-follow-up --id FOLLOW_UP_ID --payload JSON|-
  reminder-preview [--quarter Q] [--week YYYY-Www]
  reminder-batches [--quarter Q] [--week YYYY-Www]
  create-reminder-batch --quarter Q --week YYYY-Www
  create-feishu-document --payload JSON|-
  meego-preview --quarter Q --week YYYY-Www
  point-meego-preview --point-id POINT_ID --week YYYY-Www
  record-meego-observation --payload JSON|-
  confirm-meego-progress --point-id POINT_ID --payload JSON|-

Formal weeks, Weekly KR Core and Progress writes belong to okr-module-tools.
Agency tags, review, scores, comments, reminders and Meego stay here.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--base-url" ]]; then
  [[ $# -ge 3 ]] || { usage >&2; exit 2; }
  BASE_URL="$2"
  shift 2
fi
COMMAND="${1:-}"
[[ -n "$COMMAND" ]] || { usage >&2; exit 2; }
shift

QUARTER=""
WEEK=""
PAYLOAD=""
KEY=""
ID=""
POINT_ID=""
QUERY=""
TEMPLATE="classic"
TARGET_KIND=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quarter) QUARTER="${2:-}"; shift 2 ;;
    --week) WEEK="${2:-}"; shift 2 ;;
    --payload) PAYLOAD="${2:-}"; shift 2 ;;
    --key) KEY="${2:-}"; shift 2 ;;
    --id) ID="${2:-}"; shift 2 ;;
    --point-id) POINT_ID="${2:-}"; shift 2 ;;
    --query) QUERY="${2:-}"; shift 2 ;;
    --template) TEMPLATE="${2:-}"; shift 2 ;;
    --target-kind) TARGET_KIND="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$BASE_URL" ]] || BASE_URL="$("${SCRIPT_DIR}/jarvis-api-base")"
BASE_URL="${BASE_URL%/}"

request_get() {
  local path="$1"
  shift
  curl -fsS -G "${BASE_URL}${path}" "$@"
}

# curl 7.64 (the Linux server baseline) predates --fail-with-body. Preserve
# the same contract ourselves: print the response body, but return curl's
# conventional HTTP failure status when the server answers 4xx/5xx.
request_with_error_body() {
  local response curl_status=0 http_status body
  response="$(curl -sS -w $'\n%{http_code}' "$@")" || curl_status=$?
  if (( curl_status != 0 )); then
    return "$curl_status"
  fi
  http_status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  printf '%s' "$body"
  [[ "$http_status" =~ ^[0-9]{3}$ ]] || return 22
  if (( 10#$http_status >= 400 )); then
    return 22
  fi
}

request_post() {
  local path="$1" payload="$2"
  request_with_error_body -X POST "${BASE_URL}${path}" -H 'content-type: application/json' --data-binary "$payload"
}

request_write() {
  local method="$1" path="$2" payload="$3"
  request_with_error_body -X "$method" "${BASE_URL}${path}" -H 'content-type: application/json' --data-binary "$payload"
}

read_payload() {
  [[ -n "$PAYLOAD" ]] || { echo "$COMMAND requires --payload JSON|-" >&2; exit 2; }
  [[ "$PAYLOAD" != "-" ]] || PAYLOAD="$(cat)"
  printf '%s' "$PAYLOAD" | jq -e 'type == "object"' >/dev/null || { echo "$COMMAND payload must be a JSON object" >&2; exit 2; }
  printf '%s' "$PAYLOAD"
}

encoded() {
  printf '%s' "$1" | jq -sRr @uri
}

case "$COMMAND" in
  text-config)
    [[ "$KEY" =~ ^weekly_report_[a-z_]+$ ]] || { echo "text-config requires a weekly_report_* --key" >&2; exit 2; }
    request_get "/api/text-files/${KEY}"
    ;;
  scope)
    request_get /api/agency-okr/scope
    ;;
  delete-week)
    [[ "$QUARTER" =~ ^[0-9]{4}-Q[1-4]$ && "$WEEK" =~ ^[0-9]{4}-W[0-9]{2}$ ]] || { echo "delete-week requires --quarter YYYY-Qn and --week YYYY-Www" >&2; exit 2; }
    request_with_error_body -X DELETE -G "${BASE_URL}/api/agency-okr/weeks/$(encoded "$WEEK")" --data-urlencode "quarter=$QUARTER"
    ;;
  core-board|board|comments|follow-ups|reminder-preview|reminder-batches|meego-preview)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    [[ -z "$WEEK" ]] || args+=(--data-urlencode "week=$WEEK")
    if [[ ${#args[@]} -eq 0 ]]; then
      request_get "/api/agency-okr/${COMMAND}"
    else
      request_get "/api/agency-okr/${COMMAND}" "${args[@]}"
    fi
    ;;
  get-weekly-kr)
    [[ -n "$ID" && "$WEEK" =~ ^[0-9]{4}-W[0-9]{2}$ ]] || { echo "get-weekly-kr requires --id and --week YYYY-Www" >&2; exit 2; }
    request_get "/api/agency-okr/krs/$(encoded "$ID")/weekly" --data-urlencode "week=$WEEK"
    ;;
  get-kr)
    [[ -n "$ID" ]] || { echo "get-kr requires --id" >&2; exit 2; }
    request_get "/api/agency-okr/krs/$(encoded "$ID")"
    ;;
  replace-kr-tags)
    [[ -n "$ID" ]] || { echo "replace-kr-tags requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    request_write PUT "/api/agency-okr/krs/$(encoded "$ID")/tags" "$payload"
    ;;
  replace-point-tags)
    [[ -n "$POINT_ID" ]] || { echo "replace-point-tags requires --point-id" >&2; exit 2; }
    payload="$(read_payload)"
    request_write PUT "/api/agency-okr/points/$(encoded "$POINT_ID")/tags" "$payload"
    ;;
  people-search)
    [[ -n "$QUERY" ]] || { echo "people-search requires --query" >&2; exit 2; }
    request_get /api/agency-okr/people/search --data-urlencode "q=$QUERY"
    ;;
  replace-score|delete-score)
    [[ "$TARGET_KIND" == "kr" || "$TARGET_KIND" == "point" ]] || { echo "$COMMAND requires --target-kind kr|point" >&2; exit 2; }
    [[ -n "$ID" ]] || { echo "$COMMAND requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    score_check='true'
    [[ "$COMMAND" == "delete-score" ]] || score_check='(.score | type == "number" and . >= 0 and . <= 1 and ((. * 10) | floor) == (. * 10))'
    printf '%s' "$payload" | jq -e "
      (.quarter | type == \"string\" and test(\"^[0-9]{4}-Q[1-4]$\"))
      and (.week | type == \"string\" and test(\"^[0-9]{4}-W[0-9]{2}$\"))
      and (.expected_version | type == \"number\" and . >= 0)
      and ($score_check)
    " >/dev/null || { echo "$COMMAND payload is invalid" >&2; exit 2; }
    method=PUT
    [[ "$COMMAND" == "replace-score" ]] || method=DELETE
    request_write "$method" "/api/agency-okr/scores/${TARGET_KIND}/$(encoded "$ID")" "$payload"
    ;;
  create-comment)
    payload="$(read_payload)"
    request_post /api/agency-okr/comments "$payload"
    ;;
  update-comment)
    [[ -n "$ID" ]] || { echo "update-comment requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    request_write PUT "/api/agency-okr/comments/$(encoded "$ID")" "$payload"
    ;;
  delete-comment)
    [[ -n "$ID" ]] || { echo "delete-comment requires --id" >&2; exit 2; }
    request_with_error_body -X DELETE "${BASE_URL}/api/agency-okr/comments/$(encoded "$ID")"
    ;;
  get-follow-up)
    [[ -n "$ID" ]] || { echo "get-follow-up requires --id" >&2; exit 2; }
    request_get "/api/agency-okr/follow-ups/$(encoded "$ID")"
    ;;
  create-follow-up)
    payload="$(read_payload)"
    printf '%s' "$payload" | jq -e '
      (.id | type == "string" and length > 0)
      and (.expected_version == 0)
      and (.quarter | type == "string" and test("^[0-9]{4}-Q[1-4]$"))
      and (.week | type == "string" and test("^[0-9]{4}-W[0-9]{2}$"))
      and (.topic | type == "string" and length > 0)
      and (.owners | type == "array" and all(.[]; (.open_id | type == "string" and length > 0) and (.name | type == "string" and length > 0)))
      and (.status == "not_started" or .status == "in_progress" or .status == "done")
    ' >/dev/null || { echo "create-follow-up payload is invalid" >&2; exit 2; }
    request_post /api/agency-okr/follow-ups "$payload"
    ;;
  update-follow-up)
    [[ -n "$ID" ]] || { echo "update-follow-up requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    printf '%s' "$payload" | jq -e '
      (.expected_version | type == "number" and . >= 0)
      and (.quarter | type == "string" and test("^[0-9]{4}-Q[1-4]$"))
      and (.week | type == "string" and test("^[0-9]{4}-W[0-9]{2}$"))
      and (.topic | type == "string" and length > 0)
      and (.owners | type == "array" and all(.[]; (.open_id | type == "string" and length > 0) and (.name | type == "string" and length > 0)))
      and (.status == "not_started" or .status == "in_progress" or .status == "done")
    ' >/dev/null || { echo "update-follow-up payload is invalid" >&2; exit 2; }
    request_write PUT "/api/agency-okr/follow-ups/$(encoded "$ID")" "$payload"
    ;;
  delete-follow-up)
    [[ -n "$ID" ]] || { echo "delete-follow-up requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    printf '%s' "$payload" | jq -e '(.expected_version | type == "number" and . >= 0)' >/dev/null || { echo "delete-follow-up payload is invalid" >&2; exit 2; }
    request_write DELETE "/api/agency-okr/follow-ups/$(encoded "$ID")" "$payload"
    ;;
  create-reminder-batch)
    [[ -n "$QUARTER" && "$WEEK" =~ ^[0-9]{4}-W[0-9]{2}$ ]] || { echo "create-reminder-batch requires --quarter and --week YYYY-Www" >&2; exit 2; }
    payload=$(printf '{"quarter":"%s","week":"%s"}' "$QUARTER" "$WEEK")
    request_post /api/agency-okr/reminder-batches/generate "$payload"
    ;;
  create-feishu-document)
	PAYLOAD="$(read_payload)"
    printf '%s' "$PAYLOAD" | jq -e '
      type == "object"
      and (.title | type == "string" and length > 0)
      and (.content | type == "string" and length > 0)
    ' >/dev/null || { echo "create-feishu-document payload is invalid" >&2; exit 2; }
    request_post /api/agency-okr/feishu-documents "$PAYLOAD"
    ;;
  record-meego-observation)
	PAYLOAD="$(read_payload)"
    printf '%s' "$PAYLOAD" | jq -e '
      type == "object"
      and (.point_id | type == "string" and length > 0)
      and (.work_item_id | type == "string" and length > 0)
      and (.week | type == "string" and test("^[0-9]{4}-W[0-9]{2}$"))
      and (.observed_at | type == "string" and length > 0)
      and ((.remote // {}) | type == "object")
      and ((.fetch_error // "") | type == "string")
    ' >/dev/null || { echo "record-meego-observation payload is invalid" >&2; exit 2; }
	request_post /api/agency-okr/meego-observations "$PAYLOAD"
	;;
  point-meego-preview)
    [[ -n "$POINT_ID" && "$WEEK" =~ ^[0-9]{4}-W[0-9]{2}$ ]] || { echo "point-meego-preview requires --point-id and --week YYYY-Www" >&2; exit 2; }
    request_get "/api/agency-okr/points/$(encoded "$POINT_ID")/meego-preview" --data-urlencode "week=$WEEK"
    ;;
  confirm-meego-progress)
    [[ -n "$POINT_ID" ]] || { echo "confirm-meego-progress requires --point-id" >&2; exit 2; }
    payload="$(read_payload)"
    request_post "/api/agency-okr/points/$(encoded "$POINT_ID")/meego-confirm" "$payload"
    ;;
  *) echo "unknown command: $COMMAND" >&2; usage >&2; exit 2 ;;
esac
