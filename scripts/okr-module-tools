#!/usr/bin/env bash
# Narrow CLI for deterministic OKR core data. Weekly progress, reminders and
# observations are intentionally owned by scripts/weekly-report-tools.
set -euo pipefail

BASE_URL="${JARVIS_BASE_URL:-http://127.0.0.1:18800}"

usage() {
  cat <<'EOF'
usage: okr-module-tools [--base-url URL] COMMAND [ARGS]

commands:
  scope
  board [--quarter Q]
  get-kr --id KR_ID
  people-search --query TEXT
  upload-image --file PATH

Set JARVIS_BASE_URL when Jarvis does not listen on 127.0.0.1:18800.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--base-url" ]]; then
  [[ $# -ge 3 ]] || { usage >&2; exit 2; }
  BASE_URL="$2"
  shift 2
fi
BASE_URL="${BASE_URL%/}"
COMMAND="${1:-}"
[[ -n "$COMMAND" ]] || { usage >&2; exit 2; }
shift

QUARTER=""
ID=""
QUERY=""
FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quarter) QUARTER="${2:-}"; shift 2 ;;
    --id) ID="${2:-}"; shift 2 ;;
    --query) QUERY="${2:-}"; shift 2 ;;
    --file) FILE="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

request_get() {
  local path="$1"
  shift
  curl -fsS -G "${BASE_URL}${path}" "$@"
}

case "$COMMAND" in
  scope)
    request_get /api/okr/scope
    ;;
  board)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    request_get /api/okr/board "${args[@]}"
    ;;
  get-kr)
    [[ -n "$ID" ]] || { echo "get-kr requires --id" >&2; exit 2; }
    curl -fsS "${BASE_URL}/api/okr/krs/$(printf '%s' "$ID" | jq -sRr @uri)"
    ;;
  people-search)
    [[ -n "$QUERY" ]] || { echo "people-search requires --query" >&2; exit 2; }
    request_get /api/okr/people/search --data-urlencode "q=$QUERY"
    ;;
  upload-image)
    [[ -f "$FILE" ]] || { echo "upload-image requires an existing --file" >&2; exit 2; }
    curl -fsS -X POST "${BASE_URL}/api/okr/images" -F "image=@${FILE}"
    ;;
  *)
    echo "unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
