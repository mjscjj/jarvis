#!/usr/bin/env bash
# Narrow CLI for deterministic OKR core data. Weekly progress, reminders and
# observations are intentionally owned by scripts/weekly-report-tools.
set -euo pipefail

BASE_URL="${JARVIS_BASE_URL:-http://127.0.0.1:18800}"

usage() {
  cat <<'EOF'
usage: okr-module-tools [--base-url URL] COMMAND [ARGS]

commands:
  scope
  board [--quarter Q] [--week YYYY-Www]

Set JARVIS_BASE_URL when Jarvis does not listen on 127.0.0.1:18800.
EOF
}

if [[ "${1:-}" == "--base-url" ]]; then
  [[ $# -ge 3 ]] || { usage >&2; exit 2; }
  BASE_URL="$2"
  shift 2
fi
BASE_URL="${BASE_URL%/}"
COMMAND="${1:-}"
[[ -n "$COMMAND" ]] || { usage >&2; exit 2; }
shift

QUARTER=""
WEEK=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quarter) QUARTER="${2:-}"; shift 2 ;;
    --week) WEEK="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

request_get() {
  local path="$1"
  shift
  curl -fsS -G "${BASE_URL}${path}" "$@"
}

case "$COMMAND" in
  scope)
    request_get /api/okr/scope
    ;;
  board)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    [[ -z "$WEEK" ]] || args+=(--data-urlencode "week=$WEEK")
    request_get /api/okr/board "${args[@]}"
    ;;
  *)
    echo "unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
