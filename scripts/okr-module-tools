#!/usr/bin/env bash
# Atomic CLI for reusable OKR definitions and formal progress. Biz-specific
# labels, review, reminders and integrations live in scripts/biz-okr-tools.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_URL="${JARVIS_API_BASE:-}"

usage() {
  cat <<'EOF'
usage: okr-module-tools [--base-url URL] COMMAND [ARGS]

commands:
  scope
  board [--quarter Q]
  list-objectives [--quarter Q]
  get-objective --id OBJECTIVE_ID
  projection-audit [--quarter Q]
  find-krs --query TEXT [--quarter Q]
  get-kr --id KR_ID
  replace-kr --id KR_ID --payload JSON|-
  progress-scope
  weeks [--quarter Q]
  open-week --quarter Q --week YYYY-Www [--template classic|okr_weekly_preview_v1]
  progress-board [--quarter Q] [--week YYYY-Www]
  get-weekly-kr --id KR_ID --week YYYY-Www
  replace-weekly-core --id KR_ID --payload JSON|-
  create-progress --point-id POINT_ID --payload JSON|-
  update-progress --id PROGRESS_ID --payload JSON|-
  delete-progress --id PROGRESS_ID --payload JSON|-
  upload-image --file PATH

Formal progress writes use optimistic versions and never write Biz labels,
scores, comments, reminders or Meego projections. Deleting a whole week is
biz-okr-tools delete-week, which also clears the Biz records of that week.

Uses server.addr from conf/config.yaml plus conf/config.runtime.yaml.
JARVIS_API_BASE or --base-url explicitly selects another instance.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--base-url" ]]; then
  [[ $# -ge 3 ]] || { usage >&2; exit 2; }
  BASE_URL="$2"
  shift 2
fi
COMMAND="${1:-}"
[[ -n "$COMMAND" ]] || { usage >&2; exit 2; }
shift

QUARTER=""
WEEK=""
ID=""
POINT_ID=""
QUERY=""
FILE=""
PAYLOAD=""
TEMPLATE="classic"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quarter) QUARTER="${2:-}"; shift 2 ;;
    --week) WEEK="${2:-}"; shift 2 ;;
    --id) ID="${2:-}"; shift 2 ;;
    --point-id) POINT_ID="${2:-}"; shift 2 ;;
    --query) QUERY="${2:-}"; shift 2 ;;
    --file) FILE="${2:-}"; shift 2 ;;
    --payload) PAYLOAD="${2:-}"; shift 2 ;;
    --template) TEMPLATE="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$BASE_URL" ]] || BASE_URL="$("${SCRIPT_DIR}/jarvis-api-base")"
BASE_URL="${BASE_URL%/}"

request_get() {
  local path="$1"
  shift
  curl -fsS -G "${BASE_URL}${path}" "$@"
}

# curl 7.64 (the Linux server baseline) predates --fail-with-body. Preserve
# the same contract ourselves: print the response body, but return curl's
# conventional HTTP failure status when the server answers 4xx/5xx.
request_with_error_body() {
  local response curl_status=0 http_status body
  response="$(curl -sS -w $'\n%{http_code}' "$@")" || curl_status=$?
  if (( curl_status != 0 )); then
    return "$curl_status"
  fi
  http_status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  printf '%s' "$body"
  [[ "$http_status" =~ ^[0-9]{3}$ ]] || return 22
  if (( 10#$http_status >= 400 )); then
    return 22
  fi
}

request_post() {
  local path="$1" payload="$2"
  request_with_error_body -X POST "${BASE_URL}${path}" -H 'content-type: application/json' --data-binary "$payload"
}

request_write() {
  local method="$1" path="$2" payload="$3"
  request_with_error_body -X "$method" "${BASE_URL}${path}" -H 'content-type: application/json' --data-binary "$payload"
}

read_payload() {
  [[ -n "$PAYLOAD" ]] || { echo "$COMMAND requires --payload JSON|-" >&2; exit 2; }
  [[ "$PAYLOAD" != "-" ]] || PAYLOAD="$(cat)"
  printf '%s' "$PAYLOAD" | jq -e 'type == "object"' >/dev/null || { echo "$COMMAND payload must be a JSON object" >&2; exit 2; }
  printf '%s' "$PAYLOAD"
}

encoded() {
  printf '%s' "$1" | jq -sRr @uri
}

relation_pages() {
  local query_name="$1" relation_type="$2" cursor="" response next relations_file
  relations_file="$(mktemp "${TMPDIR:-/tmp}/okr-projection-relations.XXXXXX")"
  while true; do
    args=(--data-urlencode "${query_name}=${relation_type}" --data-urlencode 'limit=200')
    [[ -z "$cursor" ]] || args+=(--data-urlencode "cursor=$cursor")
    response="$(request_get /api/relations "${args[@]}")"
    printf '%s' "$response" | jq -e '.code == 0 and (.data.items | type == "array")' >/dev/null || {
      echo "projection-audit received an invalid relation response for ${query_name}=${relation_type}" >&2
      return 1
    }
    printf '%s\n' "$response" | jq -c '.data.items[]' >>"$relations_file"
    next="$(printf '%s' "$response" | jq -r '.data.next_cursor // empty')"
    [[ -n "$next" ]] || break
    [[ "$next" != "$cursor" ]] || { echo "projection-audit relation cursor did not advance" >&2; return 1; }
    cursor="$next"
  done
  jq -cs 'unique_by(.id)' "$relations_file"
  rm -f "$relations_file"
}

case "$COMMAND" in
  scope)
    request_get /api/okr/scope
    ;;
  board)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    if [[ ${#args[@]} -eq 0 ]]; then
      request_get /api/okr/board
    else
      request_get /api/okr/board "${args[@]}"
    fi
    ;;
  list-objectives)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    request_get /api/okr/objectives "${args[@]}"
    ;;
  get-objective)
    [[ -n "$ID" ]] || { echo "get-objective requires --id" >&2; exit 2; }
    request_get "/api/okr/objectives/$(encoded "$ID")"
    ;;
  projection-audit)
    audit_dir="$(mktemp -d "${TMPDIR:-/tmp}/okr-projection-audit.XXXXXX")"
    trap 'rm -rf "$audit_dir"' EXIT
    manifest_file="$audit_dir/manifest.json"
    slices_file="$audit_dir/slices.ndjson"
    relations_file="$audit_dir/relations.ndjson"
    : >"$slices_file"
    : >"$relations_file"
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    manifest="$(request_get /api/okr/objectives "${args[@]}")"
    printf '%s' "$manifest" | jq -e '.code == 0 and (.data.objectives | type == "array")' >/dev/null || {
      echo "projection-audit received an invalid objective manifest" >&2
      exit 1
    }
    printf '%s' "$manifest" >"$manifest_file"

    while IFS= read -r objective; do
      objective_id="$(printf '%s' "$objective" | jq -er '.id | select(type == "string" and length > 0)')" || {
        echo "projection-audit found an invalid objective id" >&2
        exit 1
      }
      slice="$(request_get "/api/okr/objectives/$(encoded "$objective_id")")"
      printf '%s' "$slice" | jq -e '.code == 0 and (.data.objective | type == "object")' >/dev/null || {
        echo "projection-audit received an invalid objective slice for $objective_id" >&2
        exit 1
      }
      printf '%s\n' "$slice" | jq -c '.data' >>"$slices_file"
    done < <(printf '%s' "$manifest" | jq -c '.data.objectives[]')

    for relation_type in okr_objective okr_kr okr_point; do
      for direction in source target; do
        query_name="${direction}_type"
        page_items="$(relation_pages "$query_name" "$relation_type")"
        printf '%s\n' "$page_items" | jq -c '.[]' >>"$relations_file"
      done
    done

    jq -n --slurpfile manifest "$manifest_file" --slurpfile slices "$slices_file" --slurpfile relation_rows "$relations_file" '
      ($manifest[0]) as $manifest
      | ($relation_rows | unique_by(.id)) as $relations
      |
      def ref($type; $id): "\($type):\($id)";
      def okr_type: . == "okr_objective" or . == "okr_kr" or . == "okr_point";
      def current_nodes:
        [$slices[] | .objective as $objective |
          {type:"okr_objective", id:$objective.id, objective_id:$objective.id},
          ($objective.krs[] |
            {type:"okr_kr", id:.id, objective_id:$objective.id},
            (.points[] | {type:"okr_point", id:.id, objective_id:$objective.id})
          )
        ];
      def has_relation($relations; $node_type; $node_id; $relation_types; $target_type):
        any($relations[]; . as $relation |
          $relation.source_type == $node_type and $relation.source_id == $node_id and
          ($relation_types | index($relation.relation_type)) != null and $relation.target_type == $target_type and
          $relation.confirmed_at != null);
      def has_owner_relation($relations; $owner):
        any($relations[];
          .source_type == $owner.node_type and .source_id == $owner.node_id and
          .relation_type == "owned_by" and (.target_type == "person" or .target_type == "principal") and
          .evidence.owner_open_id == $owner.open_id and .confirmed_at != null);
      (current_nodes) as $nodes
      | ($nodes | map(ref(.type; .id))) as $current_refs
      | ($relations | map(. as $relation | select(
          ($current_refs | index(ref($relation.source_type; $relation.source_id))) != null or
          ($current_refs | index(ref($relation.target_type; $relation.target_id))) != null
        ))) as $current_relations
      | ([
          $slices[] | .objective.krs[] as $kr |
          ($kr.owners[]? | {node_type:"okr_kr", node_id:$kr.id, open_id:.open_id, name:.name}),
          ($kr.points[] as $point | $point.owners[]? | {node_type:"okr_point", node_id:$point.id, open_id:.open_id, name:.name})
        ]) as $owner_occurrences
      | ([ $nodes[] | select(
            if .type == "okr_objective" then has_relation($current_relations; .type; .id; ["maps_to"]; "project")
            elif .type == "okr_kr" then has_relation($current_relations; .type; .id; ["maps_to"]; "key_matter")
            else has_relation($current_relations; .type; .id; ["maps_to", "advances"]; "key_matter") end
          ) | ref(.type; .id) ]) as $related_refs
      | ([ $owner_occurrences[] | select(has_owner_relation($current_relations; .)) ]) as $related_owner_occurrences
      | {
          code: 0,
          data: {
            quarter: $manifest.data.quarter,
            totals: $manifest.data.totals,
            relations: {
              count: ($current_relations | length),
              confirmed_count: ($current_relations | map(select(.confirmed_at != null)) | length),
              by_world_type: (
                $current_relations
                | map(
                    if (.source_type | okr_type) then .target_type
                    elif (.target_type | okr_type) then .source_type
                    else empty end
                  )
                | group_by(.)
                | map({key: .[0], value: length})
                | from_entries
              )
            },
            coverage: (
              ["okr_objective", "okr_kr", "okr_point"]
              | map(. as $type | {
                  key: (if $type == "okr_objective" then "objectives" elif $type == "okr_kr" then "krs" else "points" end),
                  value: (
                    [$nodes[] | select(.type == $type)] as $typed
                    | {
                        total: ($typed | length),
                        related: ($typed | map(. as $node | select(($related_refs | index(ref($node.type; $node.id))) != null)) | length),
                        unrelated_ids: [$typed[] | . as $node | select(($related_refs | index(ref($node.type; $node.id))) == null) | $node.id]
                      }
                  )
                })
              | from_entries
            ),
            owner_coverage: {
              total_occurrences: ($owner_occurrences | length),
              related_occurrences: ($related_owner_occurrences | length),
              unresolved: [
                $owner_occurrences[] | select(has_owner_relation($current_relations; .) | not)
              ]
            },
            by_objective: [
              $slices[]
              | .objective as $objective
              | ([{type:"okr_objective", id:$objective.id}] +
                  [$objective.krs[] | {type:"okr_kr", id:.id}] +
                  [$objective.krs[].points[] | {type:"okr_point", id:.id}]) as $objective_nodes
              | {
                  id: $objective.id,
                  title: $objective.title,
                  krs: ($objective.krs | length),
                  points: ([$objective.krs[].points[]] | length),
                  related_nodes: ($objective_nodes | map(. as $node | select(($related_refs | index(ref($node.type; $node.id))) != null)) | length),
                  unrelated_nodes: ($objective_nodes | map(. as $node | select(($related_refs | index(ref($node.type; $node.id))) == null)) | length)
                }
            ],
            orphan_relations: [
              $relations[]
              | . as $relation
              | select(
                  (($relation.source_type | okr_type) and (($current_refs | index(ref($relation.source_type; $relation.source_id))) == null)) or
                  (($relation.target_type | okr_type) and (($current_refs | index(ref($relation.target_type; $relation.target_id))) == null))
                )
            ]
          }
        }
    '
    ;;
  find-krs)
    [[ -n "$QUERY" ]] || { echo "find-krs requires --query" >&2; exit 2; }
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    if [[ ${#args[@]} -eq 0 ]]; then
      board="$(request_get /api/okr/board)"
    else
      board="$(request_get /api/okr/board "${args[@]}")"
    fi
    printf '%s' "$board" | jq --arg query "$QUERY" '
      ($query | ascii_downcase) as $needle
      | {code, data: {quarter: .data.quarter, matches: [
          .data.objectives[] as $objective
          | $objective.krs[]
          | select(([
              .id, .title, (.owner_name // ""),
              ($objective.title // ""),
              ([.points[]?.title] | join(" "))
            ] | join(" ") | ascii_downcase | contains($needle)))
          | . + {objective_id: $objective.id, objective_title: $objective.title}
        ]}}
    '
    ;;
  get-kr)
    [[ -n "$ID" ]] || { echo "get-kr requires --id" >&2; exit 2; }
    curl -fsS "${BASE_URL}/api/okr/krs/$(printf '%s' "$ID" | jq -sRr @uri)"
    ;;
  replace-kr)
    [[ -n "$ID" ]] || { echo "replace-kr requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    request_write PUT "/api/okr/krs/$(encoded "$ID")" "$payload"
    ;;
  progress-scope)
    request_get /api/okr/progress/scope
    ;;
  weeks)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    request_get /api/okr/weeks "${args[@]}"
    ;;
  open-week)
    [[ "$QUARTER" =~ ^[0-9]{4}-Q[1-4]$ && "$WEEK" =~ ^[0-9]{4}-W[0-9]{2}$ ]] || { echo "open-week requires --quarter YYYY-Qn and --week YYYY-Www" >&2; exit 2; }
    request_post /api/okr/weeks "$(jq -cn --arg quarter "$QUARTER" --arg week "$WEEK" --arg template "$TEMPLATE" '{quarter:$quarter,week:$week,template_key:$template}')"
    ;;
  progress-board)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    [[ -z "$WEEK" ]] || args+=(--data-urlencode "week=$WEEK")
    request_get /api/okr/progress/board "${args[@]}"
    ;;
  get-weekly-kr)
    [[ -n "$ID" && "$WEEK" =~ ^[0-9]{4}-W[0-9]{2}$ ]] || { echo "get-weekly-kr requires --id and --week YYYY-Www" >&2; exit 2; }
    request_get "/api/okr/krs/$(encoded "$ID")/weekly" --data-urlencode "week=$WEEK"
    ;;
  replace-weekly-core)
    [[ -n "$ID" ]] || { echo "replace-weekly-core requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    request_write PUT "/api/okr/krs/$(encoded "$ID")/weekly-core" "$payload"
    ;;
  create-progress)
    [[ -n "$POINT_ID" ]] || { echo "create-progress requires --point-id" >&2; exit 2; }
    payload="$(read_payload)"
    request_post "/api/okr/points/$(encoded "$POINT_ID")/progress" "$payload"
    ;;
  update-progress|delete-progress)
    [[ -n "$ID" ]] || { echo "$COMMAND requires --id" >&2; exit 2; }
    payload="$(read_payload)"
    method=PUT
    [[ "$COMMAND" == "update-progress" ]] || method=DELETE
    request_write "$method" "/api/okr/progress/$(encoded "$ID")" "$payload"
    ;;
  upload-image)
    [[ -f "$FILE" ]] || { echo "upload-image requires an existing --file" >&2; exit 2; }
    curl -fsS -X POST "${BASE_URL}/api/okr/images" -F "image=@${FILE}"
    ;;
  *)
    echo "unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
