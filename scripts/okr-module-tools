#!/usr/bin/env bash
# Narrow CLI for deterministic OKR core data. Weekly progress, reminders and
# observations are intentionally owned by scripts/weekly-report-tools.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_URL="${JARVIS_API_BASE:-}"

usage() {
  cat <<'EOF'
usage: okr-module-tools [--base-url URL] COMMAND [ARGS]

commands:
  scope
  board [--quarter Q]
  find-krs --query TEXT [--quarter Q]
  get-kr --id KR_ID
  replace-kr-tags --id KR_ID --payload JSON|-
  replace-point-tags --id POINT_ID --payload JSON|-
  people-search --query TEXT
  upload-image --file PATH

replace-kr-tags accepts {"expected_version":N,"tags":[{"type":"custom","value":"双周报-官网SEO"}]}.
replace-point-tags uses the same payload and the parent KR's latest version.
Read get-kr first and preserve unrelated tags on the selected KR or point; tags
is the complete replacement list ([] clears all tags). A stale KR version returns
HTTP 409 with current data. Point tags cannot use business_category or priority.
Only selected tags are written; definitions and weekly data stay unchanged.

Uses server.addr from conf/config.yaml plus conf/config.runtime.yaml.
JARVIS_API_BASE or --base-url explicitly selects another instance.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--base-url" ]]; then
  [[ $# -ge 3 ]] || { usage >&2; exit 2; }
  BASE_URL="$2"
  shift 2
fi
COMMAND="${1:-}"
[[ -n "$COMMAND" ]] || { usage >&2; exit 2; }
shift

QUARTER=""
ID=""
QUERY=""
FILE=""
PAYLOAD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quarter) QUARTER="${2:-}"; shift 2 ;;
    --id) ID="${2:-}"; shift 2 ;;
    --query) QUERY="${2:-}"; shift 2 ;;
    --file) FILE="${2:-}"; shift 2 ;;
    --payload) PAYLOAD="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$BASE_URL" ]] || BASE_URL="$("${SCRIPT_DIR}/jarvis-api-base")"
BASE_URL="${BASE_URL%/}"

request_get() {
  local path="$1"
  shift
  curl -fsS -G "${BASE_URL}${path}" "$@"
}

# curl 7.64 (the Linux server baseline) predates --fail-with-body. Preserve
# the same contract ourselves: print the response body, but return curl's
# conventional HTTP failure status when the server answers 4xx/5xx.
request_with_error_body() {
  local response curl_status=0 http_status body
  response="$(curl -sS -w $'\n%{http_code}' "$@")" || curl_status=$?
  if (( curl_status != 0 )); then
    return "$curl_status"
  fi
  http_status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  printf '%s' "$body"
  [[ "$http_status" =~ ^[0-9]{3}$ ]] || return 22
  if (( 10#$http_status >= 400 )); then
    return 22
  fi
}

case "$COMMAND" in
  scope)
    request_get /api/okr/scope
    ;;
  board)
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    if [[ ${#args[@]} -eq 0 ]]; then
      request_get /api/okr/board
    else
      request_get /api/okr/board "${args[@]}"
    fi
    ;;
  find-krs)
    [[ -n "$QUERY" ]] || { echo "find-krs requires --query" >&2; exit 2; }
    args=()
    [[ -z "$QUARTER" ]] || args+=(--data-urlencode "quarter=$QUARTER")
    if [[ ${#args[@]} -eq 0 ]]; then
      board="$(request_get /api/okr/board)"
    else
      board="$(request_get /api/okr/board "${args[@]}")"
    fi
    printf '%s' "$board" | jq --arg query "$QUERY" '
      ($query | ascii_downcase) as $needle
      | {code, data: {quarter: .data.quarter, matches: [
          .data.objectives[] as $objective
          | $objective.krs[]
          | select(([
              .id, .title, (.owner_name // ""),
              ($objective.title // ""),
              ([.points[]?.title] | join(" "))
            ] | join(" ") | ascii_downcase | contains($needle)))
          | . + {objective_id: $objective.id, objective_title: $objective.title}
        ]}}
    '
    ;;
  get-kr)
    [[ -n "$ID" ]] || { echo "get-kr requires --id" >&2; exit 2; }
    curl -fsS "${BASE_URL}/api/okr/krs/$(printf '%s' "$ID" | jq -sRr @uri)"
    ;;
  replace-kr-tags)
    [[ -n "$ID" && -n "$PAYLOAD" ]] || { echo "replace-kr-tags requires --id and --payload JSON|-" >&2; exit 2; }
    [[ "$PAYLOAD" != "-" ]] || PAYLOAD="$(cat)"
    printf '%s' "$PAYLOAD" | jq -e 'type == "object"' >/dev/null || { echo "replace-kr-tags payload must be a JSON object" >&2; exit 2; }
    request_with_error_body -X PUT "${BASE_URL}/api/okr/krs/$(printf '%s' "$ID" | jq -sRr @uri)/tags" \
      -H 'content-type: application/json' --data-binary "$PAYLOAD"
    ;;
  replace-point-tags)
    [[ -n "$ID" && -n "$PAYLOAD" ]] || { echo "replace-point-tags requires --id and --payload JSON|-" >&2; exit 2; }
    [[ "$PAYLOAD" != "-" ]] || PAYLOAD="$(cat)"
    printf '%s' "$PAYLOAD" | jq -e 'type == "object"' >/dev/null || { echo "replace-point-tags payload must be a JSON object" >&2; exit 2; }
    request_with_error_body -X PUT "${BASE_URL}/api/okr/points/$(printf '%s' "$ID" | jq -sRr @uri)/tags" \
      -H 'content-type: application/json' --data-binary "$PAYLOAD"
    ;;
  people-search)
    [[ -n "$QUERY" ]] || { echo "people-search requires --query" >&2; exit 2; }
    request_get /api/okr/people/search --data-urlencode "q=$QUERY"
    ;;
  upload-image)
    [[ -f "$FILE" ]] || { echo "upload-image requires an existing --file" >&2; exit 2; }
    curl -fsS -X POST "${BASE_URL}/api/okr/images" -F "image=@${FILE}"
    ;;
  *)
    echo "unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
