#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONFIG_PATH="${REPO_ROOT}/conf/config.yaml"
SERVER_LABEL=""
QDRANT_LABEL="com.bytedance.jarvis.qdrant"
HOST_OS="$(uname -s)"
if [[ "$HOST_OS" == "Linux" ]]; then
  CC_CONNECT_LABEL="com.bytedance.jarvis.cc-connect"
else
  CC_CONNECT_LABEL="com.cc-connect.service"
fi
SERVER_URL=""
QDRANT_URL="http://127.0.0.1:6333"
CC_CONFIG_PATH="${JARVIS_CC_CONFIG_PATH:-${HOME}/.cc-connect/config.toml}"
TRAEX_INSTALLER_URL="https://code.byted.org/api/tos-proxy/download/traex_install.sh"
source "${REPO_ROOT}/integrations/cc-connect/manifest.sh"
CC_CONNECT_PATCH_PATH="${REPO_ROOT}/${CC_CONNECT_PATCH_RELATIVE_PATH}"
CC_CONNECT_BIN="${REPO_ROOT}/bin/cc-connect-jarvis"
INSTALL_CHECKLIST_TEMPLATE="${REPO_ROOT}/docs/templates/jarvis-install-checklist.md"
LARK_CLI_MIN_VERSION="1.0.93"

usage() {
  cat >&2 <<'EOF'
Usage: jarvis-install <command> [flags]

start           Create the whole-project installation run and checklist; --resume-latest reuses the newest run.
doctor          Report machine, configuration, service, and data facts as JSON.
install-lark-cli Install the official Lark CLI and its Agent Skills.
install-bytedcli Install the ByteDance CLI used for SSO and engineering integrations.
install-codex    Install the official Codex CLI required by CC Connect.
install-traex    Install the stable ByteDance internal TRAE CLI.
install-cc-connect Build the pinned Jarvis-patched CC Connect binary. It does not configure or start the daemon.
install-qdrant  Install the pinned Qdrant service for this checkout.
validate-dependencies Verify every install-time dependency without starting Jarvis.
configure-identity Save the assistant name, principal open_id, and Git author for the current machine.
bind-cc          Bind CC Connect jarvis-codex to the current default lark-cli App and checkout.
validate-binding Validate the one-App Jarvis/lark-cli/CC Connect binding.
install-server  Build and register Jarvis only after dependencies and configuration are ready.
validate        Verify configuration permissions and end-to-end service readiness.
status          Summarize completed and pending items in an installation checklist.

The tool performs machine-owned checks and atomic actions only. The calling
Agent decides how to install missing dependencies and whether an existing
Jarvis installation may be changed. Feishu commands use lark-cli's current
default identity.
EOF
}

fail() {
  printf 'jarvis-install: %s\n' "$*" >&2
  exit 1
}

resolve_install_run_dir() {
  local resolved="$1"
  if [[ "$resolved" != /* ]]; then
    resolved="${REPO_ROOT}/${resolved}"
  fi
  case "$resolved" in
    "${REPO_ROOT}/var/install/"*) printf '%s\n' "$resolved" ;;
    *) fail "installation run directory must be inside ${REPO_ROOT}/var/install" ;;
  esac
}

sha256_file() {
  local path="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$path" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$path" | awk '{print $1}'
  else
    fail "shasum or sha256sum is required to fingerprint the installation checklist"
  fi
}

start_installation() {
  require_command jq
  require_command git
  local run_dir="" run_id started_at checklist_path resume_latest=false latest_checklist=""
  local source_commit template_sha256
  [[ -f "$INSTALL_CHECKLIST_TEMPLATE" ]] || fail "installation checklist template is missing: ${INSTALL_CHECKLIST_TEMPLATE}"
  source_commit="$(git -C "$REPO_ROOT" rev-parse HEAD)"
  template_sha256="$(sha256_file "$INSTALL_CHECKLIST_TEMPLATE")"
  while (( $# > 0 )); do
    case "$1" in
      --run-dir) (( $# >= 2 )) || fail "--run-dir requires a value"; run_dir="$2"; shift 2 ;;
      --resume-latest) resume_latest=true; shift ;;
      --help|-h) usage; exit 0 ;;
      *) fail "start unknown argument: $1" ;;
    esac
  done
  if [[ "$resume_latest" == "true" ]]; then
    [[ -z "$run_dir" ]] || fail "--resume-latest cannot be combined with --run-dir"
    local candidate
    shopt -s nullglob
    for candidate in "${REPO_ROOT}"/var/install/*/INSTALL_CHECKLIST.md; do
      if [[ -z "$latest_checklist" || "$candidate" -nt "$latest_checklist" ]]; then
        latest_checklist="$candidate"
      fi
    done
    shopt -u nullglob
    if [[ -n "$latest_checklist" ]]; then
      local created_commit created_template_sha256
      created_commit="$(awk -F'：' '/^- 创建 commit：/ {print $2; exit}' "$latest_checklist" | tr -d '[:space:]')"
      created_template_sha256="$(awk -F'：' '/^- 清单模板 SHA-256：/ {print $2; exit}' "$latest_checklist" | tr -d '[:space:]')"
      [[ -n "$created_commit" && -n "$created_template_sha256" ]] || \
        fail "latest installation checklist predates compatibility metadata; start a new installation run"
      [[ "$created_commit" == "$source_commit" ]] || \
        fail "latest installation checklist was created from commit ${created_commit}, current commit is ${source_commit}; start a new installation run"
      [[ "$created_template_sha256" == "$template_sha256" ]] || \
        fail "latest installation checklist template no longer matches the current installer; start a new installation run"
      grep -q '^- \[ \]' "$latest_checklist" || \
        fail "latest installation checklist is already complete; start a new installation run"
      run_dir="$(dirname "$latest_checklist")"
      jq -nc --arg run_dir "$run_dir" --arg checklist "$latest_checklist" --arg evidence_dir "${run_dir}/evidence" \
        '{ok:true,resumed:true,run_dir:$run_dir,checklist:$checklist,evidence_dir:$evidence_dir}'
      return
    fi
  fi
  run_id="$(date '+%Y%m%d-%H%M%S')"
  started_at="$(date '+%Y-%m-%dT%H:%M:%S%z')"
  if [[ -z "$run_dir" ]]; then
    run_dir="${REPO_ROOT}/var/install/${run_id}"
  else
    run_dir="$(resolve_install_run_dir "$run_dir")"
    run_id="$(basename "$run_dir")"
  fi
  [[ ! -e "$run_dir" ]] || fail "installation run directory already exists: ${run_dir}"
  mkdir -p "${run_dir}/evidence"
  checklist_path="${run_dir}/INSTALL_CHECKLIST.md"
  awk -v run_id="$run_id" -v started_at="$started_at" -v repo_root="$REPO_ROOT" \
    -v source_commit="$source_commit" -v template_sha256="$template_sha256" '
    {
      gsub(/\{\{RUN_ID\}\}/, run_id)
      gsub(/\{\{STARTED_AT\}\}/, started_at)
      gsub(/\{\{REPO_ROOT\}\}/, repo_root)
      gsub(/\{\{SOURCE_COMMIT\}\}/, source_commit)
      gsub(/\{\{TEMPLATE_SHA256\}\}/, template_sha256)
      print
    }
  ' "$INSTALL_CHECKLIST_TEMPLATE" >"$checklist_path"
  jq -nc --arg run_dir "$run_dir" --arg checklist "$checklist_path" --arg evidence_dir "${run_dir}/evidence" \
    '{ok:true,resumed:false,run_dir:$run_dir,checklist:$checklist,evidence_dir:$evidence_dir}'
}

installation_status() {
  require_command jq
  local run_dir="" checklist_path completed pending explained
  while (( $# > 0 )); do
    case "$1" in
      --run-dir) (( $# >= 2 )) || fail "--run-dir requires a value"; run_dir="$2"; shift 2 ;;
      --help|-h) usage; exit 0 ;;
      *) fail "status unknown argument: $1" ;;
    esac
  done
  [[ -n "$run_dir" ]] || fail "status requires --run-dir"
  run_dir="$(resolve_install_run_dir "$run_dir")"
  checklist_path="${run_dir}/INSTALL_CHECKLIST.md"
  [[ -f "$checklist_path" ]] || fail "installation checklist not found: ${checklist_path}"
  completed="$(awk '/^- \[x\]/{n++} END{print n+0}' "$checklist_path")"
  pending="$(awk '/^- \[ \]/{n++} END{print n+0}' "$checklist_path")"
  explained="$(awk '/^- \[ \].*原因：(未做|阻塞|不适用)/{n++} END{print n+0}' "$checklist_path")"
  jq -nc --arg checklist "$checklist_path" --argjson completed "$completed" --argjson pending "$pending" --argjson pending_with_reason "$explained" \
    '{checklist:$checklist,completed:$completed,pending:$pending,pending_with_reason:$pending_with_reason,
      complete:($pending == 0),deliverable:($pending == $pending_with_reason)}'
}

parse_common_flags() {
  while (( $# > 0 )); do
    case "$1" in
      --config)
        (( $# >= 2 )) || fail "--config requires a path"
        CONFIG_PATH="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        fail "unknown argument: $1"
        ;;
    esac
  done
  if [[ "$CONFIG_PATH" != /* ]]; then
    CONFIG_PATH="${REPO_ROOT}/${CONFIG_PATH}"
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

bool_json() {
  if "$@"; then
    printf 'true'
  else
    printf 'false'
  fi
}

semver_at_least() {
  local actual="$1"
  local required="$2"
  awk -v actual="$actual" -v required="$required" 'BEGIN {
    sub(/^[^0-9]*/, "", actual)
    sub(/^[^0-9]*/, "", required)
    split(actual, a, ".")
    split(required, r, ".")
    for (i = 1; i <= 3; i++) {
      av = (a[i] == "" ? 0 : a[i] + 0)
      rv = (r[i] == "" ? 0 : r[i] + 0)
      if (av > rv) exit 0
      if (av < rv) exit 1
    }
    exit 0
  }'
}

node_version_supported() {
  local actual="$1"
  local major minor
  actual="${actual#v}"
  major="${actual%%.*}"
  minor="${actual#*.}"
  minor="${minor%%.*}"
  case "$major" in
    20) (( minor >= 19 )) ;;
    21) return 1 ;;
    22) (( minor >= 12 )) ;;
    *) (( major >= 23 )) ;;
  esac
}

service_loaded() {
  local label="$1"
  case "$HOST_OS" in
    Darwin) launchctl print "gui/${UID}/${label}" >/dev/null 2>&1 ;;
    Linux) [[ "$(systemctl --user show --property=LoadState --value "${label}.service" 2>/dev/null || true)" == "loaded" ]] ;;
    *) return 1 ;;
  esac
}

service_program() {
  local label="$1"
  case "$HOST_OS" in
    Darwin)
      local agent_plist="${HOME}/Library/LaunchAgents/${label}.plist"
      [[ -f "$agent_plist" ]] || return 1
      plutil -extract ProgramArguments.0 raw -o - "$agent_plist" 2>/dev/null
      ;;
    Linux)
      local unit_path exec_start
      unit_path="$(systemctl --user show --property=FragmentPath --value "${label}.service" 2>/dev/null || true)"
      [[ -f "$unit_path" ]] || return 1
      exec_start="$(sed -n 's/^ExecStart=//p' "$unit_path" | head -n1)"
      [[ -n "$exec_start" ]] || return 1
      printf '%s\n' "${exec_start%% *}"
      ;;
    *) return 1 ;;
  esac
}

service_running() {
  local label="$1"
  case "$HOST_OS" in
    Darwin) launchctl print "gui/${UID}/${label}" 2>/dev/null | grep -q 'state = running' ;;
    Linux) systemctl --user is-active --quiet "${label}.service" ;;
    *) return 1 ;;
  esac
}

lark_skill_path() {
  local skill_name="$1" candidate
  if [[ -n "${CODEX_HOME:-}" ]]; then
    candidate="${CODEX_HOME}/skills/${skill_name}/SKILL.md"
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  for candidate in \
    "${HOME}/.agents/skills/${skill_name}/SKILL.md" \
    "${HOME}/.codex/skills/${skill_name}/SKILL.md"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

lark_skill_pack_path() {
  if lark_skill_path lark-suite; then
    return 0
  fi
  lark_skill_path lark-shared
}

lark_required_skills_ready() {
  local skill_name
  if lark_skill_path lark-suite >/dev/null; then
    return 0
  fi
  for skill_name in lark-shared lark-contact lark-drive lark-doc lark-im; do
    lark_skill_path "$skill_name" >/dev/null || return 1
  done
}

lark_cli_protocol_ready() {
  local binary="$1"
  "$binary" event consume card.action.trigger --help 2>&1 | grep -q -- '--dry-run'
}

lark_cli_version_ready() {
  local binary="$1" version
  version="$("$binary" --version 2>/dev/null | head -n1)" || return 1
  semver_at_least "$version" "$LARK_CLI_MIN_VERSION"
}

codex_login_ready() {
  local binary="$1"
  "$binary" login status >/dev/null 2>&1
}

traex_login_ready() {
  local binary="$1"
  local status
  if ! status="$("$binary" login status 2>&1)"; then
    return 1
  fi
  [[ "$status" == "Logged in"* ]]
}

initialization_status() {
  (
    cd "$REPO_ROOT"
    go run ./cmd/jarvis-config initialization-status --config "$CONFIG_PATH"
  )
}

load_server_instance() {
  local instance
  instance="$("${REPO_ROOT}/scripts/jarvis-instance" "$CONFIG_PATH")"
  SERVER_LABEL="$(jq -er '.launchd_label' <<<"$instance")"
  SERVER_URL="$(jq -er '.api_base' <<<"$instance")"
}

integrated_binding_validation() {
  "${REPO_ROOT}/integrations/cc-connect/manage.sh" \
    validate --config "$CONFIG_PATH" --cc-config "$CC_CONFIG_PATH"
}

configure_identity() {
  local agent_name="" open_id="" git_author="" config_path="$CONFIG_PATH"
  while (( $# > 0 )); do
    case "$1" in
      --agent-name) (( $# >= 2 )) || fail "--agent-name requires a value"; agent_name="$2"; shift 2 ;;
      --open-id) (( $# >= 2 )) || fail "--open-id requires a value"; open_id="$2"; shift 2 ;;
      --git-author) (( $# >= 2 )) || fail "--git-author requires a value"; git_author="$2"; shift 2 ;;
      --config) (( $# >= 2 )) || fail "--config requires a value"; config_path="$2"; shift 2 ;;
      *) fail "configure-identity unknown argument: $1" ;;
    esac
  done
  [[ -n "$agent_name" ]] || fail "configure-identity requires --agent-name"
  [[ "$open_id" == ou_* && "$open_id" != "ou_" ]] || fail "configure-identity requires a non-empty ou_ --open-id"
  [[ -n "$git_author" ]] || fail "configure-identity requires --git-author"
  [[ "$config_path" == /* ]] || config_path="${REPO_ROOT}/${config_path}"
  (
    cd "$REPO_ROOT"
    go run ./cmd/jarvis-config configure-principal \
      --config "$config_path" --agent-name "$agent_name" --open-id "$open_id" --git-author "$git_author"
  ) | jq -c .
}

doctor() {
  require_command jq

  local missing=()
  local required_command
  local required_commands=(bash zsh curl git go node npm npx jq openssl tar install)
  if [[ "$HOST_OS" == "Darwin" ]]; then
    required_commands+=(codesign security plutil launchctl shasum xcode-select)
  elif [[ "$HOST_OS" == "Linux" ]]; then
    required_commands+=(systemctl sha256sum)
  fi
  for required_command in "${required_commands[@]}"; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
      missing+=("$required_command")
    fi
  done

  local required_path
  for required_path in \
    go.mod \
    web/package-lock.json \
    conf/config.yaml \
    scripts/install-qdrant.sh \
    scripts/install-launchd.sh \
    scripts/install-systemd.sh \
    scripts/install-cc-systemd.sh \
    scripts/rebuild-server.sh \
    scripts/jarvis-install \
    scripts/jarvis-world-model \
    scripts/install-cc-connect.sh \
    integrations/cc-connect/manifest.sh \
    integrations/cc-connect/manage.sh \
    .agents/skills/install-jarvis/SKILL.md \
    .agents/skills/install-jarvis/references/operator-guide.md \
    .agents/skills/bootstrap-jarvis-world-model/SKILL.md \
    "${CC_CONNECT_PATCH_RELATIVE_PATH}"; do
    if [[ ! -e "${REPO_ROOT}/${required_path}" ]]; then
      missing+=("$required_path")
    fi
  done

  local platform arch platform_supported
  platform="$(uname -s)"
  arch="$(uname -m)"
  platform_supported=false
  if [[ ( "$platform" == "Darwin" && "$arch" == "arm64" ) || \
        ( "$platform" == "Linux" && ( "$arch" == "x86_64" || "$arch" == "amd64" ) ) ]]; then
    platform_supported=true
  fi

  local required_go actual_go go_supported
  required_go="$(awk '$1 == "go" { print $2; exit }' "${REPO_ROOT}/go.mod")"
  actual_go=""
  go_supported=false
  if command -v go >/dev/null 2>&1; then
    actual_go="$(go env GOVERSION 2>/dev/null || true)"
    if [[ -n "$actual_go" ]] && semver_at_least "$actual_go" "$required_go"; then
      go_supported=true
    fi
  fi

  local actual_node node_supported
  actual_node=""
  node_supported=false
  if command -v node >/dev/null 2>&1; then
    actual_node="$(node --version 2>/dev/null || true)"
    if [[ -n "$actual_node" ]] && node_version_supported "$actual_node"; then
      node_supported=true
    fi
  fi

  local cgo_ready xcode_tools_ready c_compiler c_compiler_ready
  cgo_ready=false
  xcode_tools_ready=false
  c_compiler=""
  c_compiler_ready=false
  if command -v go >/dev/null 2>&1 && [[ "$(go env CGO_ENABLED 2>/dev/null || true)" == "1" ]]; then
    cgo_ready=true
  fi
  if command -v go >/dev/null 2>&1; then
    c_compiler="$(go env CC 2>/dev/null || true)"
    if [[ -n "$c_compiler" ]] && command -v "$c_compiler" >/dev/null 2>&1; then
      c_compiler_ready=true
    fi
  fi
  if [[ "$platform" == "Linux" ]]; then
    xcode_tools_ready=true
  elif command -v xcode-select >/dev/null 2>&1 && xcode-select -p >/dev/null 2>&1; then
    xcode_tools_ready=true
  fi

  local lark_skill_path lark_skill_pack_ready
  lark_skill_path=""
  lark_skill_pack_ready=false
  if lark_skill_path="$(lark_skill_pack_path)" && lark_required_skills_ready; then
    lark_skill_pack_ready=true
  fi

  local config_status config_inspection_ok config_error config_error_file
  config_status='null'
  config_inspection_ok=false
  config_error=""
  config_error_file="$(mktemp "${TMPDIR:-/tmp}/jarvis-install-config.XXXXXX")"
  if command -v go >/dev/null 2>&1 && [[ -f "$CONFIG_PATH" ]]; then
    if config_status="$(initialization_status 2>"$config_error_file")"; then
      config_inspection_ok=true
    else
      config_error="$(<"$config_error_file")"
      if [[ -n "$config_status" ]]; then
        config_error="${config_error}${config_error:+$'\n'}${config_status}"
      fi
      config_status='null'
    fi
  else
    config_error="go or config file is missing"
  fi
  rm -f "$config_error_file"
  local traex_required traex_binary
  traex_required=false
  traex_binary=""
  if [[ "$config_inspection_ok" == "true" ]]; then
    local runtime_binary
    while IFS= read -r runtime_binary; do
      if [[ -n "$runtime_binary" ]] && ! command -v "$runtime_binary" >/dev/null 2>&1; then
        missing+=("configured runtime binary: ${runtime_binary}")
      fi
      if [[ "${runtime_binary##*/}" == "traex" ]]; then
        traex_required=true
        traex_binary="$runtime_binary"
      fi
    done < <(jq -r '.runtime_binaries[]?' <<<"$config_status")
  fi

  local lark_cli_path lark_cli_version lark_cli_version_is_ready lark_cli_protocol_is_ready bytedcli_path bytedcli_version bytedcli_login_ready traex_path traex_version traex_login_is_ready codex_path codex_version codex_login_is_ready
  lark_cli_path="$(command -v lark-cli 2>/dev/null || true)"
  lark_cli_version=""
  lark_cli_version_is_ready=false
  lark_cli_protocol_is_ready=false
  if [[ -n "$lark_cli_path" ]]; then
    lark_cli_version="$("$lark_cli_path" --version 2>/dev/null | head -n1 || true)"
    if lark_cli_version_ready "$lark_cli_path"; then
      lark_cli_version_is_ready=true
    fi
    if lark_cli_protocol_ready "$lark_cli_path"; then
      lark_cli_protocol_is_ready=true
    fi
  fi
  bytedcli_path="$(command -v bytedcli 2>/dev/null || true)"
  bytedcli_version=""
  bytedcli_login_ready=false
  if [[ -n "$bytedcli_path" ]]; then
    bytedcli_version="$("$bytedcli_path" --version 2>/dev/null | head -n1 || true)"
    if "$bytedcli_path" --json auth status 2>/dev/null | jq -e '.data.authenticated == true' >/dev/null 2>&1; then
      bytedcli_login_ready=true
    fi
  fi
  codex_path="$(command -v codex 2>/dev/null || true)"
  codex_version=""
  codex_login_is_ready=false
  if [[ -n "$codex_path" ]]; then
    codex_version="$("$codex_path" --version 2>/dev/null | head -n1 || true)"
    if codex_login_ready "$codex_path"; then
      codex_login_is_ready=true
    fi
  fi

  local cc_connect_version cc_connect_ready
  cc_connect_version=""
  cc_connect_ready=false
  if [[ -x "$CC_CONNECT_BIN" ]]; then
    cc_connect_version="$("$CC_CONNECT_BIN" --version 2>/dev/null || true)"
    if [[ "$cc_connect_version" == *"cc-connect ${CC_CONNECT_VERSION}"* && "$cc_connect_version" == *"${CC_CONNECT_PATCH_COMMIT}"* ]]; then
      cc_connect_ready=true
    fi
  fi
  traex_path=""
  traex_version=""
  traex_login_is_ready=true
  if [[ "$traex_required" == "true" ]]; then
    traex_login_is_ready=false
    traex_path="$(command -v "$traex_binary" 2>/dev/null || true)"
    if [[ -n "$traex_path" ]]; then
      traex_version="$("$traex_path" --version 2>/dev/null | head -n1 || true)"
      if traex_login_ready "$traex_path"; then
        traex_login_is_ready=true
      fi
    fi
  fi

  local qdrant_healthy server_healthy readiness_json
  load_server_instance
  qdrant_healthy="$(bool_json curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null 2>/dev/null)"
  server_healthy="$(bool_json curl -fsS --max-time 2 "${SERVER_URL}/healthz" -o /dev/null 2>/dev/null)"
  readiness_json='null'
  if [[ "$server_healthy" == "true" ]]; then
    readiness_json="$(curl -fsS --max-time 4 "${SERVER_URL}/readyz" 2>/dev/null || printf 'null')"
    if ! jq -e . >/dev/null 2>&1 <<<"$readiness_json"; then
      readiness_json='null'
    fi
  fi

  local server_loaded qdrant_loaded cc_connect_loaded server_program_path qdrant_program_path cc_connect_program_path server_belongs_to_checkout qdrant_belongs_to_checkout cc_connect_belongs_to_checkout cc_connect_daemon_running
  server_loaded="$(bool_json service_loaded "$SERVER_LABEL")"
  qdrant_loaded="$(bool_json service_loaded "$QDRANT_LABEL")"
  cc_connect_loaded="$(bool_json service_loaded "$CC_CONNECT_LABEL")"
  server_program_path="$(service_program "$SERVER_LABEL" 2>/dev/null || true)"
  qdrant_program_path="$(service_program "$QDRANT_LABEL" 2>/dev/null || true)"
  cc_connect_program_path="$(service_program "$CC_CONNECT_LABEL" 2>/dev/null || true)"
  server_belongs_to_checkout=false
  qdrant_belongs_to_checkout=false
  cc_connect_belongs_to_checkout=false
  cc_connect_daemon_running=false
  case "$server_program_path" in
    "${REPO_ROOT}"/*) server_belongs_to_checkout=true ;;
  esac
  case "$qdrant_program_path" in
    "${REPO_ROOT}"/*) qdrant_belongs_to_checkout=true ;;
  esac
  if [[ "$cc_connect_program_path" == "$CC_CONNECT_BIN" ]]; then
    cc_connect_belongs_to_checkout=true
  fi
  if service_running "$CC_CONNECT_LABEL"; then
    cc_connect_daemon_running=true
  fi

  local runtime_ignored git_dirty_count database_exists
  runtime_ignored=false
  git_dirty_count=0
  if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$REPO_ROOT" check-ignore -q conf/config.runtime.yaml; then
      runtime_ignored=true
    fi
    git_dirty_count="$(git -C "$REPO_ROOT" status --porcelain | wc -l | tr -d ' ')"
  fi
  database_exists="$(bool_json test -f "${REPO_ROOT}/var/jarvis.db")"

  local missing_json warnings_json machine_ready dependencies_ready
  missing_json="$(printf '%s\n' "${missing[@]-}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
  warnings_json="$(jq -nc \
    --argjson tracked_key "$(jq -r '.tracked_model_api_key_present // false' <<<"$config_status")" \
    --arg base_mode "$(jq -r '.base_config_mode // ""' <<<"$config_status")" \
    '[if $tracked_key then "tracked source contains a shared plaintext model API key" else empty end,
      if ($base_mode != "" and $base_mode != "0600") then "base config permissions are broader than 0600; install-server will restrict them" else empty end]')"

  machine_ready=true
  if (( ${#missing[@]} > 0 )) || [[ "$platform_supported" != "true" ]] || \
    [[ "$go_supported" != "true" ]] || [[ "$node_supported" != "true" ]] || \
    [[ "$cgo_ready" != "true" ]] || [[ "$c_compiler_ready" != "true" ]] || [[ "$xcode_tools_ready" != "true" ]] || \
    [[ "$config_inspection_ok" != "true" ]] || [[ "$traex_login_is_ready" != "true" ]] || \
    [[ "$runtime_ignored" != "true" ]]; then
    machine_ready=false
  fi
  dependencies_ready=false
  if [[ "$machine_ready" == "true" && -n "$lark_cli_path" && -n "$lark_cli_version" && "$lark_cli_version_is_ready" == "true" && "$lark_cli_protocol_is_ready" == "true" && \
    -n "$bytedcli_path" && -n "$bytedcli_version" && \
    -n "$codex_path" && -n "$codex_version" && "$codex_login_is_ready" == "true" && \
    "$lark_skill_pack_ready" == "true" && "$cc_connect_ready" == "true" && "$qdrant_healthy" == "true" ]]; then
    dependencies_ready=true
  fi

  jq -nc \
    --arg repo_root "$REPO_ROOT" \
    --arg config_path "$CONFIG_PATH" \
    --arg platform "$platform" \
    --arg arch "$arch" \
    --arg required_go "$required_go" \
    --arg actual_go "$actual_go" \
    --arg actual_node "$actual_node" \
    --arg c_compiler "$c_compiler" \
    --arg lark_cli_min_version "$LARK_CLI_MIN_VERSION" \
    --arg lark_skill_path "$lark_skill_path" \
    --arg lark_cli_path "$lark_cli_path" \
    --arg lark_cli_version "$lark_cli_version" \
    --arg codex_path "$codex_path" \
    --arg codex_version "$codex_version" \
    --arg bytedcli_path "$bytedcli_path" \
    --arg bytedcli_version "$bytedcli_version" \
    --arg traex_path "$traex_path" \
    --arg traex_version "$traex_version" \
    --arg cc_connect_path "$CC_CONNECT_BIN" \
    --arg cc_connect_version "$cc_connect_version" \
    --arg config_error "$config_error" \
    --arg server_program "$server_program_path" \
    --arg qdrant_program "$qdrant_program_path" \
    --arg cc_connect_program "$cc_connect_program_path" \
    --argjson machine_ready "$machine_ready" \
    --argjson dependencies_ready "$dependencies_ready" \
    --argjson missing "$missing_json" \
    --argjson warnings "$warnings_json" \
    --argjson platform_supported "$platform_supported" \
    --argjson go_supported "$go_supported" \
    --argjson node_supported "$node_supported" \
    --argjson cgo_ready "$cgo_ready" \
    --argjson c_compiler_ready "$c_compiler_ready" \
    --argjson xcode_tools_ready "$xcode_tools_ready" \
    --argjson lark_skill_pack_ready "$lark_skill_pack_ready" \
    --argjson lark_cli_version_ready "$lark_cli_version_is_ready" \
    --argjson lark_cli_protocol_ready "$lark_cli_protocol_is_ready" \
    --argjson bytedcli_login_ready "$bytedcli_login_ready" \
    --argjson codex_login_ready "$codex_login_is_ready" \
    --argjson traex_required "$traex_required" \
    --argjson traex_login_ready "$traex_login_is_ready" \
    --argjson cc_connect_ready "$cc_connect_ready" \
    --argjson config_inspection_ok "$config_inspection_ok" \
    --argjson config "$config_status" \
    --argjson runtime_ignored "$runtime_ignored" \
    --argjson git_dirty_count "$git_dirty_count" \
    --argjson database_exists "$database_exists" \
    --argjson server_loaded "$server_loaded" \
    --argjson qdrant_loaded "$qdrant_loaded" \
    --argjson cc_connect_loaded "$cc_connect_loaded" \
    --argjson server_belongs_to_checkout "$server_belongs_to_checkout" \
    --argjson qdrant_belongs_to_checkout "$qdrant_belongs_to_checkout" \
    --argjson cc_connect_belongs_to_checkout "$cc_connect_belongs_to_checkout" \
    --argjson cc_connect_daemon_running "$cc_connect_daemon_running" \
    --argjson server_healthy "$server_healthy" \
    --argjson qdrant_healthy "$qdrant_healthy" \
    --argjson readiness "$readiness_json" \
    '{machine_ready:$machine_ready,dependencies_ready:$dependencies_ready,
      repo:{root:$repo_root,git_dirty_file_count:$git_dirty_count,database_exists:$database_exists},
      platform:{os:$platform,arch:$arch,supported:$platform_supported},
      toolchain:{missing:$missing,go:{required:$required_go,actual:$actual_go,supported:$go_supported},node:{required:"^20.19.0 or >=22.12.0",actual:$actual_node,supported:$node_supported},cgo_ready:$cgo_ready,c_compiler:{command:(if $c_compiler == "" then null else $c_compiler end),ready:$c_compiler_ready},xcode_tools_ready:$xcode_tools_ready},
      agent_capabilities:{lark_cli:{path:(if $lark_cli_path == "" then null else $lark_cli_path end),version:(if $lark_cli_version == "" then null else $lark_cli_version end),minimum_version:$lark_cli_min_version,version_ready:$lark_cli_version_ready,required_protocol_ready:$lark_cli_protocol_ready},lark_skill_pack_ready:$lark_skill_pack_ready,lark_skill_pack_path:(if $lark_skill_path == "" then null else $lark_skill_path end),bytedcli:{path:(if $bytedcli_path == "" then null else $bytedcli_path end),version:(if $bytedcli_version == "" then null else $bytedcli_version end),login_ready:$bytedcli_login_ready},codex:{path:(if $codex_path == "" then null else $codex_path end),version:(if $codex_version == "" then null else $codex_version end),login_ready:$codex_login_ready},traex:{required:$traex_required,path:(if $traex_path == "" then null else $traex_path end),version:(if $traex_version == "" then null else $traex_version end),login_ready:$traex_login_ready},cc_connect:{path:$cc_connect_path,version:(if $cc_connect_version == "" then null else $cc_connect_version end),patched_binary_ready:$cc_connect_ready}},
      configuration:{path:$config_path,inspection_ok:$config_inspection_ok,error:(if $config_error == "" then null else $config_error end),status:$config,runtime_override_ignored:$runtime_ignored},
      services:{manager:(if $platform == "Linux" then "systemd" else "launchd" end),server:{loaded:$server_loaded,launchd_loaded:$server_loaded,program:(if $server_program == "" then null else $server_program end),belongs_to_checkout:$server_belongs_to_checkout,healthy:$server_healthy,readiness:$readiness},qdrant:{loaded:$qdrant_loaded,launchd_loaded:$qdrant_loaded,program:(if $qdrant_program == "" then null else $qdrant_program end),belongs_to_checkout:$qdrant_belongs_to_checkout,healthy:$qdrant_healthy},cc_connect:{loaded:$cc_connect_loaded,launchd_loaded:$cc_connect_loaded,program:(if $cc_connect_program == "" then null else $cc_connect_program end),belongs_to_checkout:$cc_connect_belongs_to_checkout,running:$cc_connect_daemon_running}},
      warnings:$warnings}'

  [[ "$machine_ready" == "true" ]]
}

validate_dependencies() {
  require_command jq

  local report
  if ! report="$(doctor)"; then
    :
  fi
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$report" || \
    fail "doctor did not return a JSON dependency report"

  jq -c '{
    ok:.dependencies_ready,
    checks:{
      machine_ready:.machine_ready,
      lark_cli_ready:((.agent_capabilities.lark_cli.path // "") != "" and (.agent_capabilities.lark_cli.version // "") != "" and .agent_capabilities.lark_cli.version_ready and .agent_capabilities.lark_cli.required_protocol_ready),
      bytedcli_ready:((.agent_capabilities.bytedcli.path // "") != "" and (.agent_capabilities.bytedcli.version // "") != ""),
      codex_ready:((.agent_capabilities.codex.path // "") != "" and (.agent_capabilities.codex.version // "") != "" and .agent_capabilities.codex.login_ready),
      lark_skill_pack_ready:.agent_capabilities.lark_skill_pack_ready,
      agent_cli_login_ready:((.agent_capabilities.traex.required | not) or .agent_capabilities.traex.login_ready),
      cc_connect_patched_binary_ready:.agent_capabilities.cc_connect.patched_binary_ready,
      qdrant_ready:.services.qdrant.healthy
    },
    details:{
      toolchain:.toolchain,
      agent_capabilities:.agent_capabilities,
      qdrant:.services.qdrant,
      warnings:.warnings
    }
  }' <<<"$report"
  jq -e '.dependencies_ready == true' >/dev/null <<<"$report"
}

install_cc_connect() {
  "${REPO_ROOT}/scripts/install-cc-connect.sh"
}

install_lark_cli() {
  require_command jq

  local changed lark_cli_path lark_cli_version lark_skill_path lark_skill_ready protocol_ready version_ready
  changed=false
  lark_skill_path=""
  lark_skill_ready=false
  if lark_skill_path="$(lark_skill_pack_path)" && lark_required_skills_ready; then
    lark_skill_ready=true
  fi
  protocol_ready=false
  version_ready=false
  if command -v lark-cli >/dev/null 2>&1 && lark_cli_protocol_ready "$(command -v lark-cli)"; then
    protocol_ready=true
  fi
  if command -v lark-cli >/dev/null 2>&1 && lark_cli_version_ready "$(command -v lark-cli)"; then
    version_ready=true
  fi
  if ! command -v lark-cli >/dev/null 2>&1; then
    require_command npx
    npx --yes @larksuite/cli@latest install >&2
    changed=true
  elif [[ "$lark_skill_ready" != "true" || "$protocol_ready" != "true" || "$version_ready" != "true" ]]; then
    lark-cli update --json >&2
    changed=true
  fi

  lark_cli_path="$(command -v lark-cli 2>/dev/null || true)"
  [[ -n "$lark_cli_path" ]] || fail "the official installer completed but lark-cli is not available in PATH"
  lark_cli_version="$("$lark_cli_path" --version 2>/dev/null | head -n1 || true)"
  [[ -n "$lark_cli_version" ]] || fail "lark-cli did not return a version after installation"
  lark_skill_path=""
  lark_skill_ready=false
  if lark_skill_path="$(lark_skill_pack_path)" && lark_required_skills_ready; then
    lark_skill_ready=true
  fi
  lark_cli_version_ready "$lark_cli_path" || fail "lark-cli ${lark_cli_version} is older than required ${LARK_CLI_MIN_VERSION}; run lark-cli update"
  lark_cli_protocol_ready "$lark_cli_path" || fail "lark-cli is installed but lacks the required card.action.trigger --dry-run protocol; run lark-cli update"
  [[ "$lark_skill_ready" == "true" ]] || fail "the official installer completed but required Lark Agent Skills are missing"

  jq -nc \
    --argjson changed "$changed" \
    --arg path "$lark_cli_path" \
    --arg version "$lark_cli_version" \
    --arg minimum_version "$LARK_CLI_MIN_VERSION" \
    --argjson skill_pack_ready "$lark_skill_ready" \
    --arg skill_pack_path "$lark_skill_path" \
    '{ok:true,changed:$changed,path:$path,version:$version,minimum_version:$minimum_version,version_ready:true,required_protocol_ready:true,agent_skill_pack_detected:$skill_pack_ready,agent_skill_pack_path:(if $skill_pack_path == "" then null else $skill_pack_path end)}'
}

install_bytedcli() {
  require_command jq
  require_command npm

  local changed bytedcli_path bytedcli_version auth_status login_ready stable_path
  changed=false
  bytedcli_path="$(command -v bytedcli 2>/dev/null || true)"
  if [[ -z "$bytedcli_path" ]]; then
    NPM_CONFIG_REGISTRY=http://bnpm.byted.org \
      npm install --global @bytedance-dev/bytedcli@latest >&2
    changed=true
    bytedcli_path="$(command -v bytedcli 2>/dev/null || true)"
  fi

  [[ -n "$bytedcli_path" && -x "$bytedcli_path" ]] || fail "bytedcli is not executable after installation"
  local physical_home
  physical_home="$(cd "$HOME" && pwd -P)"
  stable_path="${physical_home}/.local/bin/bytedcli"
  if [[ "$bytedcli_path" != "$stable_path" && "$bytedcli_path" != "/usr/local/bin/bytedcli" && "$bytedcli_path" != "/opt/homebrew/bin/bytedcli" ]]; then
    mkdir -p "${HOME}/.local/bin"
    if [[ -e "$stable_path" && ! -L "$stable_path" ]]; then
      fail "cannot expose bytedcli to the service manager because ${stable_path} already exists and is not a symlink"
    fi
    ln -sfn "$bytedcli_path" "$stable_path"
    bytedcli_path="$stable_path"
    changed=true
  fi
  bytedcli_version="$("$bytedcli_path" --version 2>/dev/null | head -n1 || true)"
  [[ -n "$bytedcli_version" ]] || fail "bytedcli did not return a version after installation"
  login_ready=false
  auth_status="$("$bytedcli_path" --json auth status 2>/dev/null || true)"
  if jq -e '.data.authenticated == true' >/dev/null 2>&1 <<<"$auth_status"; then
    login_ready=true
  fi

  jq -nc \
    --argjson changed "$changed" \
    --arg path "$bytedcli_path" \
    --arg version "$bytedcli_version" \
    --argjson login_ready "$login_ready" \
    '{ok:true,changed:$changed,path:$path,version:$version,login_ready:$login_ready}'
}

install_codex() {
  require_command jq
  require_command npm

  local changed codex_path codex_version login_ready
  changed=false
  codex_path="$(command -v codex 2>/dev/null || true)"
  if [[ -z "$codex_path" ]]; then
    npm install --global @openai/codex@latest >&2
    changed=true
    codex_path="$(command -v codex 2>/dev/null || true)"
  fi
  [[ -n "$codex_path" && -x "$codex_path" ]] || fail "codex is not executable after installation"
  codex_version="$("$codex_path" --version 2>/dev/null | head -n1 || true)"
  [[ -n "$codex_version" ]] || fail "codex did not return a version after installation"
  login_ready=false
  if codex_login_ready "$codex_path"; then
    login_ready=true
  fi

  jq -nc \
    --argjson changed "$changed" \
    --arg path "$codex_path" \
    --arg version "$codex_version" \
    --argjson login_ready "$login_ready" \
    '{ok:true,changed:$changed,path:$path,version:$version,login_ready:$login_ready}'
}

install_traex() {
  require_command curl
  require_command jq
  local platform arch
  platform="$(uname -s)"
  arch="$(uname -m)"
  if [[ ! ( "$platform" == "Darwin" && "$arch" == "arm64" ) && \
        ! ( "$platform" == "Linux" && ( "$arch" == "x86_64" || "$arch" == "amd64" ) ) ]]; then
    fail "the Jarvis traex installer supports macOS arm64 and Linux x86_64 only (got ${platform}/${arch})"
  fi

  local changed traex_path traex_version login_ready shell_refresh_required installer_path
  changed=false
  shell_refresh_required=false
  traex_path="$(command -v traex 2>/dev/null || true)"
  if [[ -z "$traex_path" ]]; then
    installer_path="$(mktemp "${TMPDIR:-/tmp}/traex-install.XXXXXX")"
    if ! curl -fsSL "$TRAEX_INSTALLER_URL" -o "$installer_path"; then
      rm -f "$installer_path"
      fail "download the official traex installer failed: $TRAEX_INSTALLER_URL"
    fi
    if ! TRAEX_INSTALL_ASSUME_YES=1 \
      TRAEX_INSTALL_MIGRATE_BREW=1 \
      TRAEX_INSTALL_REMOVE_BREW=0 \
      TRAEX_INSTALL_CHANNEL=stable \
      sh "$installer_path" >&2; then
      rm -f "$installer_path"
      fail "the official traex installer failed"
    fi
    rm -f "$installer_path"
    changed=true
    traex_path="$(command -v traex 2>/dev/null || true)"
    if [[ -z "$traex_path" && -x "${HOME}/.local/bin/traex" ]]; then
      traex_path="${HOME}/.local/bin/traex"
      shell_refresh_required=true
    fi
  fi

  [[ -n "$traex_path" && -x "$traex_path" ]] || fail "traex is not executable after installation"
  traex_version="$("$traex_path" --version 2>/dev/null | head -n1 || true)"
  [[ -n "$traex_version" ]] || fail "traex did not return a version after installation"
  login_ready=false
  if traex_login_ready "$traex_path"; then
    login_ready=true
  fi

  jq -nc \
    --argjson changed "$changed" \
    --arg path "$traex_path" \
    --arg version "$traex_version" \
    --arg installer_url "$TRAEX_INSTALLER_URL" \
    --argjson login_ready "$login_ready" \
    --argjson shell_refresh_required "$shell_refresh_required" \
    '{ok:true,changed:$changed,path:$path,version:$version,installer_url:$installer_url,login_ready:$login_ready,shell_refresh_required:$shell_refresh_required}'
}

install_qdrant() {
  require_command jq
  require_command curl
  case "$HOST_OS" in
    Darwin) require_command launchctl; require_command plutil ;;
    Linux) require_command systemctl ;;
    *) fail "the bundled Qdrant installer does not support ${HOST_OS}" ;;
  esac

  if curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null; then
    jq -nc --arg url "${QDRANT_URL}/healthz" '{ok:true,changed:false,detail:"an existing Qdrant endpoint is already healthy",health_url:$url}'
    return 0
  fi

  if service_loaded "$QDRANT_LABEL"; then
    local current_program
    current_program="$(service_program "$QDRANT_LABEL" 2>/dev/null || true)"
    if [[ "$current_program" != "${REPO_ROOT}/bin/qdrant" ]]; then
      fail "service ${QDRANT_LABEL} belongs to another installation (${current_program:-unknown}); the Agent must obtain user approval before replacing it"
    fi
  fi

  "${REPO_ROOT}/scripts/install-qdrant.sh" >&2
  curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null || fail "Qdrant did not pass its health check"
  jq -nc --arg url "${QDRANT_URL}/healthz" '{ok:true,changed:true,health_url:$url}'
}

install_server() {
  require_command jq
  require_command curl
  require_command go
  require_command npm
  case "$HOST_OS" in
    Darwin) require_command launchctl; require_command plutil ;;
    Linux) require_command systemctl ;;
    *) fail "Jarvis service installation does not support ${HOST_OS}" ;;
  esac
  load_server_instance

  local existing_program
  existing_program="$(service_program "$SERVER_LABEL" 2>/dev/null || true)"
  if service_loaded "$SERVER_LABEL"; then
    local current_program
    current_program="$existing_program"
    fail "Jarvis service is already loaded (${current_program:-unknown}); use scripts/rebuild-server.sh for this checkout or ask before replacing another installation"
  fi
  if [[ -n "$existing_program" && "$existing_program" != "${REPO_ROOT}/scripts/run-signed-server.sh" && "$existing_program" != "${REPO_ROOT}/bin/jarvis-server" ]]; then
    fail "Jarvis service definition belongs to another installation (${existing_program}); obtain user approval before replacing it"
  fi

  local status
  status="$(initialization_status)"
  jq -e '.machine_configuration_ready == true' >/dev/null <<<"$status" || \
    fail "machine configuration is incomplete; finish install-jarvis identity configuration before installing the service"
  local runtime_binary
  while IFS= read -r runtime_binary; do
    [[ -n "$runtime_binary" ]] || continue
    require_command "$runtime_binary"
    if [[ "${runtime_binary##*/}" == "traex" ]] && ! traex_login_ready "$runtime_binary"; then
      fail "traex is configured but not logged in; let the user complete traex login before installing the service"
    fi
  done < <(jq -r '.runtime_binaries[]?' <<<"$status")
  local binding_validation
  if ! binding_validation="$(integrated_binding_validation)"; then
    printf '%s\n' "$binding_validation" >&2
    fail "the default lark-cli identity and CC Connect Bot binding are not ready"
  fi
  curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null || \
    fail "Qdrant is not healthy; install or select the vector service first"

  local dependency_validation
  if ! dependency_validation="$(validate_dependencies)"; then
    printf '%s\n' "$dependency_validation" >&2
    fail "dependencies are not ready; finish dependency installation before starting Jarvis"
  fi

  chmod 0600 "$CONFIG_PATH"
  local runtime_path
  runtime_path="$(jq -r '.runtime_config_path' <<<"$status")"
  [[ -f "$runtime_path" ]] || fail "runtime configuration was reported ready but is missing: $runtime_path"
  chmod 0600 "$runtime_path"

  if [[ "$HOST_OS" == "Darwin" ]]; then
    "${REPO_ROOT}/scripts/install-launchd.sh" --config "$CONFIG_PATH" >&2
  else
    "${REPO_ROOT}/scripts/jarvis-deploy" --skip-pull --config "$CONFIG_PATH" >&2
  fi
  local validation
  if ! validation="$(validate_installation)"; then
    printf '%s\n' "$validation" >&2
    fail "Jarvis was installed but did not pass end-to-end validation; inspect the reported dependency before continuing"
  fi
  jq -c '. + {changed:true}' <<<"$validation"
}

validate_installation() {
  require_command jq
  require_command curl
  require_command go
  load_server_instance

  local status binding binding_error binding_ok qdrant_healthy server_healthy cc_connect_running cc_connect_program cc_connect_program_ok cc_connect_binary_ready cc_management_port_ready cc_bridge_port_ready readiness readiness_ok permissions_ok agent_cli_auth_ready ok
  status="$(initialization_status)"
  binding='null'
  binding_error=""
  binding_ok=false
  if binding="$(integrated_binding_validation 2>&1)"; then
    if jq -e '.ready == true' >/dev/null 2>&1 <<<"$binding"; then
      binding_ok=true
    fi
  else
    binding_error="$binding"
    binding='null'
  fi
  qdrant_healthy="$(bool_json curl -fsS --max-time 2 "${QDRANT_URL}/healthz" -o /dev/null 2>/dev/null)"
  server_healthy="$(bool_json curl -fsS --max-time 2 "${SERVER_URL}/healthz" -o /dev/null 2>/dev/null)"
  cc_connect_running=false
  if service_running "$CC_CONNECT_LABEL"; then
    cc_connect_running=true
  fi
  cc_connect_program="$(service_program "$CC_CONNECT_LABEL" 2>/dev/null || true)"
  cc_connect_program_ok=false
  if [[ "$cc_connect_program" == "$CC_CONNECT_BIN" ]]; then
    cc_connect_program_ok=true
  fi
  cc_connect_binary_ready=false
  if [[ -x "$CC_CONNECT_BIN" ]]; then
    local cc_version
    cc_version="$("$CC_CONNECT_BIN" --version 2>/dev/null || true)"
    if [[ "$cc_version" == *"cc-connect ${CC_CONNECT_VERSION}"* && "$cc_version" == *"${CC_CONNECT_PATCH_COMMIT}"* ]]; then
      cc_connect_binary_ready=true
    fi
  fi
  cc_management_port_ready="$(bool_json bash -c 'exec 3<>"/dev/tcp/127.0.0.1/9810"' 2>/dev/null)"
  cc_bridge_port_ready="$(bool_json bash -c 'exec 3<>"/dev/tcp/127.0.0.1/9820"' 2>/dev/null)"
  readiness='null'
  readiness_ok=false
  if [[ "$server_healthy" == "true" ]]; then
    readiness="$(curl -fsS --max-time 4 "${SERVER_URL}/readyz" 2>/dev/null || printf 'null')"
    if jq -e '.status == "ok" and ([.dependencies[].status] | all(. == "ok" or . == "disabled"))' >/dev/null 2>&1 <<<"$readiness"; then
      readiness_ok=true
    fi
  fi

  permissions_ok=false
  if jq -e '.base_config_mode == "0600" and .runtime_config_mode == "0600"' >/dev/null <<<"$status"; then
    permissions_ok=true
  fi
  agent_cli_auth_ready=true
  local runtime_binary
  while IFS= read -r runtime_binary; do
    if [[ "${runtime_binary##*/}" == "traex" ]] && ! traex_login_ready "$runtime_binary"; then
      agent_cli_auth_ready=false
    fi
  done < <(jq -r '.runtime_binaries[]?' <<<"$status")
  ok=false
  if jq -e '.machine_configuration_ready == true' >/dev/null <<<"$status" && \
    [[ "$binding_ok" == "true" && "$cc_connect_running" == "true" && "$cc_connect_program_ok" == "true" && "$cc_connect_binary_ready" == "true" && "$cc_management_port_ready" == "true" && "$cc_bridge_port_ready" == "true" && "$qdrant_healthy" == "true" && "$server_healthy" == "true" && "$readiness_ok" == "true" && "$permissions_ok" == "true" && "$agent_cli_auth_ready" == "true" ]]; then
    ok=true
  fi

  jq -nc \
    --argjson ok "$ok" \
    --argjson configuration "$status" \
    --argjson binding "$binding" \
    --arg binding_error "$binding_error" \
    --argjson binding_ok "$binding_ok" \
    --argjson permissions_ok "$permissions_ok" \
    --argjson agent_cli_auth_ready "$agent_cli_auth_ready" \
    --argjson qdrant_healthy "$qdrant_healthy" \
    --argjson server_healthy "$server_healthy" \
    --argjson cc_connect_running "$cc_connect_running" \
    --argjson cc_connect_program_ok "$cc_connect_program_ok" \
    --argjson cc_connect_binary_ready "$cc_connect_binary_ready" \
    --argjson cc_management_port_ready "$cc_management_port_ready" \
    --argjson cc_bridge_port_ready "$cc_bridge_port_ready" \
    --arg cc_connect_program "$cc_connect_program" \
    --argjson readiness_ok "$readiness_ok" \
    --argjson readiness "$readiness" \
    '{ok:$ok,configuration:$configuration,integrated_bot_binding:{ok:$binding_ok,details:$binding,error:(if $binding_error == "" then null else $binding_error end)},permissions_ok:$permissions_ok,agent_cli_auth_ready:$agent_cli_auth_ready,services:{cc_connect:{running:$cc_connect_running,program_matches_patched_binary:$cc_connect_program_ok,binary_version_ready:$cc_connect_binary_ready,management_port_9810_ready:$cc_management_port_ready,bridge_port_9820_ready:$cc_bridge_port_ready,program:(if $cc_connect_program == "" then null else $cc_connect_program end)},qdrant_healthy:$qdrant_healthy,server_healthy:$server_healthy,readiness_ok:$readiness_ok,readiness:$readiness}}'
  [[ "$ok" == "true" ]]
}

if (( $# == 0 )); then
  usage
  exit 2
fi

subcommand="$1"
shift
case "$subcommand" in
  start)
    start_installation "$@"
    exit
    ;;
  configure-identity)
    configure_identity "$@"
    exit
    ;;
  bind-cc)
    exec "${REPO_ROOT}/integrations/cc-connect/manage.sh" bind --cc-config "$CC_CONFIG_PATH" "$@"
    ;;
  validate-binding)
    exec "${REPO_ROOT}/integrations/cc-connect/manage.sh" validate --cc-config "$CC_CONFIG_PATH" "$@"
    ;;
  status)
    installation_status "$@"
    exit
    ;;
esac
parse_common_flags "$@"

case "$subcommand" in
  doctor) doctor ;;
  install-lark-cli) install_lark_cli ;;
  install-bytedcli) install_bytedcli ;;
  install-codex) install_codex ;;
  install-traex) install_traex ;;
  install-cc-connect) install_cc_connect ;;
  install-qdrant) install_qdrant ;;
  validate-dependencies) validate_dependencies ;;
  install-server) install_server ;;
  validate) validate_installation ;;
  help|--help|-h) usage ;;
  *)
    usage
    fail "unknown subcommand: $subcommand"
    ;;
esac
