#!/usr/bin/env bash
# Resolve only the configured API destination; never probe or guess a port.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[[ $# -le 1 ]] || { echo 'usage: jarvis-api-base [CONFIG_PATH]' >&2; exit 2; }
if [[ -n "${JARVIS_API_BASE:-}" ]]; then
  printf '%s\n' "${JARVIS_API_BASE%/}"
  exit 0
fi
"${SCRIPT_DIR}/jarvis-instance" "$@" | jq -er '.api_base'
