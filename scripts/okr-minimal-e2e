#!/usr/bin/env bash
# Deterministic, isolated OKR/Biz OKR acceptance harness. This is a human
# test tool, not an Agent capability: it may create O/KR fixtures through the
# product API. Agent-facing writes remain controlled by the active stage, Skill
# and prompt; the generic OKR script now also exposes intentional KR breakdown.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_DIR="$REPO_ROOT/.okr-e2e-conf"
RUNTIME_DIR="$REPO_ROOT/var/okr-e2e"
CONFIG_PATH="$CONFIG_DIR/config.yaml"
SERVER_BIN="$REPO_ROOT/bin/jarvis-server-okr-e2e"
BASE_URL="${JARVIS_OKR_E2E_BASE_URL:-http://127.0.0.1:18803}"
OWNER_OPEN_ID="${JARVIS_OKR_E2E_OWNER_OPEN_ID:-}"
OWNER_EMAIL="${JARVIS_OKR_E2E_OWNER_EMAIL:-}"
OWNER_NAME="${JARVIS_OKR_E2E_OWNER_NAME:-本机测试用户}"
FIXTURE_PATH="$RUNTIME_DIR/fixture.json"

usage() {
  cat <<'EOF'
usage: scripts/okr-minimal-e2e COMMAND

commands:
  prepare        Create isolated 18803 config (requires OWNER_OPEN_ID)
  build          Build and stable-sign the isolated server binary
  serve          Run 18803 in the foreground
  seed           Create 1 O / 1 KR / 2 points, W35 baseline and empty W36
  verify-empty   Verify W36 is open, empty and reminds exactly one owner
  run-reminder   Run one weekly reminder Agent Task against the empty W36
  fill           Fill both W36 points, including a document, image and comment
  verify-filled  Verify W36 persists and no reminder remains
  verify-world   Persist O/KR/point world progress and one relation, then prove formal progress is unchanged
  cas            Verify progress optimistic locking without changing KR version
  run-report-c   Create one internal Report C Agent Task and print its Task ID
  verify-agents  Verify reminder delivery and two-week Report C Task results
  status         Print health, scope, fixture and latest Task summary

environment:
  JARVIS_OKR_E2E_OWNER_OPEN_ID   Required by prepare/seed; must start with ou_
  JARVIS_OKR_E2E_OWNER_EMAIL     Required verified full email for business owners
  JARVIS_OKR_E2E_OWNER_NAME      Optional display name (default: 本机测试用户)
  JARVIS_OKR_E2E_BASE_URL        Optional URL (default: http://127.0.0.1:18803)

The harness never deletes an existing fixture or database. Remove
var/okr-e2e and .okr-e2e-conf explicitly when you intentionally want a fresh run.
EOF
}

fail() {
  echo "okr-minimal-e2e: $*" >&2
  exit 1
}

require_owner() {
  [[ "$OWNER_OPEN_ID" =~ ^ou_[A-Za-z0-9]+$ ]] || fail "JARVIS_OKR_E2E_OWNER_OPEN_ID must be a real ou_ open_id"
  [[ "$OWNER_EMAIL" == *@*.* ]] || fail "JARVIS_OKR_E2E_OWNER_EMAIL must be a verified full email"
  [[ -n "$OWNER_NAME" ]] || fail "JARVIS_OKR_E2E_OWNER_NAME is empty"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command is missing: $1"
}

require_server() {
  curl --fail --silent --show-error --max-time 3 "$BASE_URL/healthz" >/dev/null || fail "18803 is not healthy; run prepare, build and serve first"
}

require_fixture() {
  [[ -s "$FIXTURE_PATH" ]] || fail "fixture is missing; run seed first"
  jq -e 'type == "object" and (.objective_id|length>0) and (.kr_id|length>0) and (.strategy_point_id|length>0) and (.product_point_id|length>0)' "$FIXTURE_PATH" >/dev/null || fail "fixture file is invalid: $FIXTURE_PATH"
}

api_get() {
  curl --fail --silent --show-error --get "$BASE_URL$1" "${@:2}"
}

api_write() {
  local method="$1" path="$2" payload="$3"
  curl --fail --silent --show-error -X "$method" "$BASE_URL$path" -H 'content-type: application/json' --data "$payload"
}

require_code_zero() {
  jq -e 'if .code == 0 then . else error(.msg // "API response code is not zero") end'
}

prepare() {
  require_owner
  require_command jq
  mkdir -p "$CONFIG_DIR" "$RUNTIME_DIR/assets" "$RUNTIME_DIR/runs" "$RUNTIME_DIR/log"
  # sqlite is base-only: the loader refuses it in the runtime overlay, so the
  # isolated runtime database has to be redirected in a real base config rather
  # than a symlink to the shared one.
  rm -f "$CONFIG_PATH"
  awk '
    /^[^[:space:]#]/ { in_sqlite = ($0 == "sqlite:") }
    in_sqlite && /^[[:space:]]+path:/ && !done { print "  path: \"var/okr-e2e/runtime.db\""; done = 1; next }
    { print }
    END { if (!done) exit 1 }
  ' "$REPO_ROOT/conf/config.yaml" >"$CONFIG_PATH" || fail "conf/config.yaml has no sqlite.path to redirect; update prepare"
  ln -sfn "$REPO_ROOT/conf/prompts" "$CONFIG_DIR/prompts"
  ln -sfn "$REPO_ROOT/conf/rules" "$CONFIG_DIR/rules"
  # These files have write APIs. Copy them so an E2E enablement change cannot
  # mutate the developer's live configuration through a symlink.
  rm -f "$CONFIG_DIR/modules.yaml" "$CONFIG_DIR/skills.yaml"
  cp "$REPO_ROOT/conf/modules.yaml" "$CONFIG_DIR/modules.yaml"
  cp "$REPO_ROOT/conf/skills.yaml" "$CONFIG_DIR/skills.yaml"

  cat >"$CONFIG_DIR/okr-module.yaml" <<'YAML'
database_path: "var/okr-e2e/okr.db"
upload_dir: "var/okr-e2e/assets"
max_image_bytes: 10485760

# Required by the biz-okr module even though no harness step runs a review.
# Kept read-only so an accidental invocation cannot touch the isolated data.
preview_review:
  bin: "traex"
  model: "DeepSeek-V4-Pro"
  reasoning_effort: "high"
  sandbox: "read-only"
  timeout_seconds: 300

identity:
  enabled: false
  app_id: ""
  app_secret_env: "JARVIS_OKR_FEISHU_APP_SECRET"
  session_ttl_hours: 168
  cookie_secure: false
  feishu_base_url: "https://open.feishu.cn"
  feishu_account_url: "https://accounts.feishu.cn"
YAML

  # The harness receives an explicit binding; it must not use the CLI default.
  : "${JARVIS_OKR_E2E_FEISHU_APP_ID:?set the notification app ID}"
  : "${JARVIS_OKR_E2E_FEISHU_PROFILE:?set the notification CLI profile}"
  jq -n --arg app "$JARVIS_OKR_E2E_FEISHU_APP_ID" --arg profile "$JARVIS_OKR_E2E_FEISHU_PROFILE" \
    --arg identity "${JARVIS_OKR_E2E_DIRECTORY_IDENTITY:-bot}" \
    --arg directory_app "${JARVIS_OKR_E2E_DIRECTORY_APP_ID:-}" \
    --arg directory_profile "${JARVIS_OKR_E2E_DIRECTORY_PROFILE:-}" \
    '{feishu:{app_id:$app,cli_profile:$profile,directory_identity:$identity,directory_app_id:$directory_app,directory_profile:$directory_profile}}' >"$CONFIG_DIR/okr-module.runtime.yaml"

  cat >"$CONFIG_DIR/config.runtime.yaml" <<YAML
server:
  addr: "0.0.0.0:18803"
  web_root: "web/dist"
  log_files:
    - "var/okr-e2e/log/server.log"
    - "var/okr-e2e/log/server.error.log"

auth:
  enabled: false

factengine:
  enabled: false

extract:
  enabled: false
  principal_open_id: "$OWNER_OPEN_ID"

capture:
  discover_schedule: "0 0 1 1 *"
  scan_schedule: "0 0 1 1 *"

proactive:
  enabled: false

meeting_sweep:
  enabled: false

morning_brief:
  enabled: false

execute:
  enabled: true
  schedule: "@every 1h"
  concurrency: 1
  runs_dir: "var/okr-e2e/runs"

chat:
  enabled: false

scheduled_task:
  enabled: false

dailydigest:
  enabled: false
  git_author: "okr-e2e"

card_approval:
  enabled: false
  principal_open_id: "$OWNER_OPEN_ID"
  relay_secret: ""
YAML
  echo "prepared isolated config: $CONFIG_PATH"
}

build_server() {
  mkdir -p "$REPO_ROOT/bin"
  local next_bin="$SERVER_BIN.next"
  "$SCRIPT_DIR/check-build-toolchain.sh"
  (cd "$REPO_ROOT" && go build -o "$next_bin" ./cmd/jarvis-server)
  if [[ "$(uname -s)" == Darwin ]]; then
    "$SCRIPT_DIR/sign-jarvis-server.sh" "$next_bin"
    "$SCRIPT_DIR/verify-server-signature.sh" "$next_bin"
  fi
  mv "$next_bin" "$SERVER_BIN"
  echo "built isolated server: $SERVER_BIN"
}

serve() {
  [[ -f "$CONFIG_PATH" && -f "$CONFIG_DIR/config.runtime.yaml" && -f "$CONFIG_DIR/okr-module.yaml" ]] || fail "isolated config is missing; run prepare first"
  [[ -x "$SERVER_BIN" ]] || fail "isolated server binary is missing; run build first"
  if [[ "$(uname -s)" == Darwin ]]; then
    "$SCRIPT_DIR/verify-server-signature.sh" "$SERVER_BIN"
  fi
  exec "$SERVER_BIN" -config "$CONFIG_PATH"
}

seed() {
  require_owner
  require_server
  [[ ! -e "$FIXTURE_PATH" ]] || fail "fixture already exists: $FIXTURE_PATH"

  local board objective_count objective_response objective_id kr_response kr_id
  api_write PUT /api/profile "$(jq -cn --arg name "$OWNER_NAME" '{name:$name,department:"Platform",title:"OKR E2E Principal",leader_open_id:null,leader_name:null}')" | require_code_zero >/dev/null
  board="$(api_get /api/okr/board --data-urlencode 'quarter=2026-Q3' | require_code_zero)"
  objective_count="$(jq -r '.data.objectives | length' <<<"$board")"
  [[ "$objective_count" == 0 ]] || fail "isolated product database is not empty (objectives=$objective_count)"

  objective_response="$(api_write POST /api/okr/objectives '{"quarter":"2026-Q3","title":"E2E：跑通单人季度 OKR"}' | require_code_zero)"
  objective_id="$(jq -er '.data.id' <<<"$objective_response")"
	kr_response="$(api_write POST "/api/biz-okr/objectives/$objective_id/krs" "$(jq -cn --arg email "$OWNER_EMAIL" --arg name "$OWNER_NAME" '{title:"E2E：验证一周填写到双周汇总",owners:[{email:$email,name:$name}],tags:[{type:"business_category",value:"E2E 测试"},{type:"priority",value:"p1"}]}')" | require_code_zero)"
  kr_id="$(jq -er '.data.id' <<<"$kr_response")"

  api_write PUT "/api/biz-okr/krs/$kr_id" "$(jq -cn --arg email "$OWNER_EMAIL" --arg name "$OWNER_NAME" --arg kr_id "$kr_id" '{
    expected_version:0,
    title:"E2E：验证一周填写到双周汇总",
		metric_note:"测试口径：两个拆解点均有周进展即视为当周填写完成。",
    metrics:[{id:($kr_id+"-metric-1"),text:"W36 完成最小周报闭环",light:"green",images:[]}],
    points:[
      {id:($kr_id+"-strategy"),kind:"strategy",title:"策略：确认本周重点与风险",meego_work_item_id:"",meego_url:"",tags:[]},
      {id:($kr_id+"-product"),kind:"product",title:"产品：交付一个可回读结果",meego_work_item_id:"",meego_url:"",tags:[]}
    ],
		tags:[{type:"business_category",value:"E2E 测试"},{type:"priority",value:"p1"},{type:"scenario",value:"minimal-e2e"}],
    owners:[{email:$email,name:$name}]
  }')" | require_code_zero >/dev/null

  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" open-week --quarter 2026-Q3 --week 2026-W35 | require_code_zero >/dev/null
  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" open-week --quarter 2026-Q3 --week 2026-W36 | require_code_zero >/dev/null

  local strategy_point_id="$kr_id-strategy"
  local product_point_id="$kr_id-product"
  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" create-progress --point-id "$strategy_point_id" --payload "$(jq -cn '{id:"e2e-w35-strategy",expected_version:0,week:"2026-W35",status:"done",text:"W35 已确认测试目标和验收口径。",docs:[],images:[],source:"manual",needs_review:false}')" | require_code_zero >/dev/null
  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" create-progress --point-id "$product_point_id" --payload "$(jq -cn '{id:"e2e-w35-product",expected_version:0,week:"2026-W35",status:"in_progress",text:"W35 已完成隔离环境准备，待 W36 验证完整写入。",docs:[],images:[],source:"manual",needs_review:false}')" | require_code_zero >/dev/null

  jq -n \
    --arg objective_id "$objective_id" \
    --arg kr_id "$kr_id" \
    --arg strategy_point_id "$strategy_point_id" \
    --arg product_point_id "$product_point_id" \
    --arg owner_email "$OWNER_EMAIL" \
    --arg owner_name "$OWNER_NAME" \
    '{quarter:"2026-Q3",baseline_week:"2026-W35",current_week:"2026-W36",objective_id:$objective_id,kr_id:$kr_id,strategy_point_id:$strategy_point_id,product_point_id:$product_point_id,owner_email:$owner_email,owner_name:$owner_name}' >"$FIXTURE_PATH"
  echo "seeded fixture: $FIXTURE_PATH"
}

verify_empty() {
  require_server
  require_fixture
  local board reminder weeks
  board="$($SCRIPT_DIR/biz-okr-tools --base-url "$BASE_URL" board --quarter 2026-Q3 --week 2026-W36 | require_code_zero)"
  reminder="$($SCRIPT_DIR/biz-okr-tools --base-url "$BASE_URL" reminder-preview --quarter 2026-Q3 --week 2026-W36 | require_code_zero)"
  weeks="$($SCRIPT_DIR/okr-module-tools --base-url "$BASE_URL" weeks --quarter 2026-Q3 | require_code_zero)"
  jq -e '
    (.data.objectives|length)==1
    and ([.data.objectives[].krs[]]|length)==1
    and ([.data.objectives[].krs[].points[]]|length)==2
    and ([.data.objectives[].krs[].points[].entries[]]|length)==0
    and .data.week=="2026-W36"
    and .data.previous_week=="2026-W35"
  ' <<<"$board" >/dev/null || fail "empty W36 board assertion failed"
  jq -e '([.data.weeks[].week]|sort)==["2026-W35","2026-W36"]' <<<"$weeks" >/dev/null || fail "week list assertion failed"
  jq -e '
    .data.summary.owner_count==1
    and .data.summary.due_count==1
    and .data.summary.filled_count==0
    and .data.summary.missing_count==1
    and .data.summary.needs_reminder_owner_count==1
    and (.data.recipients|length)==1
    and .data.recipients[0].needs_reminder==true
    and .data.recipients[0].can_remind==true
  ' <<<"$reminder" >/dev/null || fail "single-owner reminder assertion failed"
  echo "verified: W36 is open and empty; exactly one real owner needs one reminder"
}

run_reminder() {
  require_server
  require_fixture
  if jq -e '.reminder_task_id != null' "$FIXTURE_PATH" >/dev/null; then
    fail "reminder Task already exists in fixture"
  fi
  local response task_id
  response="$(api_write POST /api/tasks "$(jq -cn '{
    title:"OKR E2E：提醒本人填写 W36 周报",
    action_type:"agent_task",
    target:"读取 okr-agent-orchestrator、weekly-report-reminder 和 feishu-send-message Skill，并执行 okr_agent_weekly_reminder Prompt。范围固定为隔离数据 2026-Q3 / 2026-W36；只允许提醒预览返回的唯一负责人本人。",
    background:{module:"biz-okr",skill:"okr-agent-orchestrator",prompt_key:"okr_agent_weekly_reminder",quarter:"2026-Q3",week:"2026-W36",test_recipient:"principal"},
    source_payload:{module:"biz-okr",skill:"okr-agent-orchestrator",prompt_key:"okr_agent_weekly_reminder",quarter:"2026-Q3",week:"2026-W36",acceptance:"创建可回读催填批次；仅给唯一真实负责人本人发送一次；保留飞书成功回执"},
    source_type:"manual"
  }')" | require_code_zero)"
  task_id="$(jq -er '.data.id' <<<"$response")"
  jq --argjson task_id "$task_id" '. + {reminder_task_id:$task_id}' "$FIXTURE_PATH" >"$FIXTURE_PATH.next"
  mv "$FIXTURE_PATH.next" "$FIXTURE_PATH"
  echo "$task_id"
}

fill_current() {
  require_server
  require_fixture
  require_command openssl
  local strategy_point_id product_point_id png_path image
  strategy_point_id="$(jq -er '.strategy_point_id' "$FIXTURE_PATH")"
  product_point_id="$(jq -er '.product_point_id' "$FIXTURE_PATH")"
  png_path="$RUNTIME_DIR/e2e-pixel.png"
  printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Wl7lS8AAAAASUVORK5CYII=' | openssl base64 -d -A >"$png_path"
  image="$($SCRIPT_DIR/okr-module-tools --base-url "$BASE_URL" upload-image --file "$png_path" | jq -ec 'if .code==0 then .data else error(.msg // "image upload failed") end')"

  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" create-progress --point-id "$strategy_point_id" --payload "$(jq -cn --argjson image "$image" '{id:"e2e-w36-strategy",expected_version:0,week:"2026-W36",status:"done",text:"W36 已确认最小闭环范围、风险和验收结果。",docs:[{id:"e2e-doc-1",title:"E2E 验收说明",url:"https://example.com/okr-e2e"}],images:[$image],source:"manual",needs_review:false}')" | require_code_zero >/dev/null
  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" create-progress --point-id "$product_point_id" --payload "$(jq -cn '{id:"e2e-w36-product",expected_version:0,week:"2026-W36",status:"done",text:"W36 已完成周次、进展、评论、附件和回读验证。",docs:[],images:[],source:"manual",needs_review:false}')" | require_code_zero >/dev/null
  "$SCRIPT_DIR/biz-okr-tools" --base-url "$BASE_URL" create-comment --payload "$(jq -cn --arg target_id "$product_point_id" '{quarter:"2026-Q3",week:"2026-W36",parent_id:"",target_type:"point",target_id:$target_id,target_title:"产品：交付一个可回读结果",selected_text:"",selection_start:0,selection_end:0,selection_prefix:"",selection_suffix:"",content:"E2E 评论：已回读确认。"}')" | require_code_zero >/dev/null
  echo "filled W36 with two progress entries, one document, one image and one comment"
}

verify_filled() {
  require_server
  require_fixture
  local board reminder comments asset_url
  board="$($SCRIPT_DIR/biz-okr-tools --base-url "$BASE_URL" board --quarter 2026-Q3 --week 2026-W36 | require_code_zero)"
  reminder="$($SCRIPT_DIR/biz-okr-tools --base-url "$BASE_URL" reminder-preview --quarter 2026-Q3 --week 2026-W36 | require_code_zero)"
  comments="$($SCRIPT_DIR/biz-okr-tools --base-url "$BASE_URL" comments --quarter 2026-Q3 --week 2026-W36 | require_code_zero)"
  jq -e '
    ([.data.objectives[].krs[].points[].entries[]]|length)==2
    and ([.data.objectives[].krs[].points[].entries[].docs[]]|length)==1
    and ([.data.objectives[].krs[].points[].entries[].images[]]|length)==1
    and ([.data.objectives[].krs[].points[].entries[]|select(.status=="done")]|length)==2
  ' <<<"$board" >/dev/null || fail "filled W36 board assertion failed"
  jq -e '.data.summary.filled_count==1 and .data.summary.missing_count==0 and .data.summary.needs_reminder_owner_count==0' <<<"$reminder" >/dev/null || fail "filled reminder assertion failed"
  jq -e '.data.count==1 and .data.comments[0].content=="E2E 评论：已回读确认。"' <<<"$comments" >/dev/null || fail "comment assertion failed"
  asset_url="$(jq -er '[.data.objectives[].krs[].points[].entries[].images[]][0].url' <<<"$board")"
  curl --fail --silent --show-error "$BASE_URL$asset_url" >/dev/null || fail "uploaded image cannot be read back"
  echo "verified: W36 persisted; attachment/comment read back; no reminder remains"
}

ensure_world_progress() {
  local subject_type="$1" subject_id="$2" summary="$3" current
  current="$(curl --silent --show-error --get "$BASE_URL/api/world-progress" \
    --data-urlencode "subject_type=$subject_type" \
    --data-urlencode "subject_id=$subject_id" \
    --data-urlencode 'period_key=2026-W36')"
  if jq -e '.code == 0' <<<"$current" >/dev/null; then
    jq -e --arg summary "$summary" '.data.summary == $summary' <<<"$current" >/dev/null || fail "existing $subject_type world progress has unexpected content"
    return
  fi
  api_write POST /api/world-progress "$(jq -cn \
    --arg subject_type "$subject_type" --arg subject_id "$subject_id" --arg summary "$summary" \
    '{expected_version:0,subject_type:$subject_type,subject_id:$subject_id,period_key:"2026-W36",signal:"yellow",summary:$summary,evidence:{refs:["fact:e2e-world"]},evidence_until:"2026-09-06T12:00:00Z"}')" | require_code_zero >/dev/null
}

verify_world() {
  require_server
  require_fixture
  local objective_id kr_id point_id relation progress formal
  objective_id="$(jq -er '.objective_id' "$FIXTURE_PATH")"
  kr_id="$(jq -er '.kr_id' "$FIXTURE_PATH")"
  point_id="$(jq -er '.strategy_point_id' "$FIXTURE_PATH")"

  ensure_world_progress okr_objective "$objective_id" "E2E：O 世界进展独立存在"
  ensure_world_progress okr_kr "$kr_id" "E2E：KR 世界进展独立存在"
  ensure_world_progress okr_point "$point_id" "E2E：子 KR 世界进展独立存在"
  relation="$(api_write POST /api/relations "$(jq -cn --arg kr_id "$kr_id" '{source_type:"okr_kr",source_id:$kr_id,relation_type:"drives",target_type:"project",target_id:"e2e-project",evidence:{source:"isolated-e2e"},confidence:1}')" | require_code_zero)"
  jq -e '.data.source_type == "okr_kr" and .data.relation_type == "drives" and .data.target_type == "project"' <<<"$relation" >/dev/null || fail "relation JSON contract assertion failed"

  progress="$(api_get /api/world-progress/period/2026-W36 | require_code_zero)"
  jq -e --arg objective_id "$objective_id" --arg kr_id "$kr_id" --arg point_id "$point_id" '
    ([.data.items[] | select(.subject_type=="okr_objective" and .subject_id==$objective_id)] | length)==1
    and ([.data.items[] | select(.subject_type=="okr_kr" and .subject_id==$kr_id)] | length)==1
    and ([.data.items[] | select(.subject_type=="okr_point" and .subject_id==$point_id)] | length)==1
  ' <<<"$progress" >/dev/null || fail "three-level world progress assertion failed"

  formal="$(api_get /api/okr/progress/board --data-urlencode 'quarter=2026-Q3' --data-urlencode 'week=2026-W36' | require_code_zero)"
  jq -e '([.data.objectives[].krs[].points[].entries[] | select(.source=="manual")]|length)==2' <<<"$formal" >/dev/null || fail "world writes changed formal progress"
  echo "verified: O/KR/point world progress and KR→project relation persist without changing two manual progress entries"
}

cas_test() {
  require_server
  require_fixture
  local kr_id point_id before_version after_version stale_status
  kr_id="$(jq -er '.kr_id' "$FIXTURE_PATH")"
  point_id="$(jq -er '.strategy_point_id' "$FIXTURE_PATH")"
  before_version="$($SCRIPT_DIR/okr-module-tools --base-url "$BASE_URL" get-kr --id "$kr_id" | jq -er '.data.version')"
  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" create-progress --point-id "$point_id" --payload "$(jq -cn '{id:"e2e-cas-progress",expected_version:0,week:"2026-W36",status:"in_progress",text:"CAS 初始值",docs:[],images:[],source:"agent",needs_review:true}')" | require_code_zero >/dev/null
  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" update-progress --id e2e-cas-progress --payload "$(jq -cn '{expected_version:0,week:"2026-W36",status:"done",text:"CAS 更新值",docs:[],images:[],source:"agent",needs_review:false}')" | require_code_zero >/dev/null
  stale_status="$(curl --silent --output "$RUNTIME_DIR/cas-stale.json" --write-out '%{http_code}' -X PUT "$BASE_URL/api/okr/progress/e2e-cas-progress" -H 'content-type: application/json' --data "$(jq -cn '{expected_version:0,week:"2026-W36",status:"blocked",text:"不应覆盖",docs:[],images:[],source:"agent",needs_review:false}')")"
  [[ "$stale_status" == 409 ]] || fail "stale progress update returned HTTP $stale_status, want 409"
  jq -e '.code==40938' "$RUNTIME_DIR/cas-stale.json" >/dev/null || fail "stale progress update returned unexpected body"
  "$SCRIPT_DIR/okr-module-tools" --base-url "$BASE_URL" delete-progress --id e2e-cas-progress --payload '{"expected_version":1}' | require_code_zero >/dev/null
  after_version="$($SCRIPT_DIR/okr-module-tools --base-url "$BASE_URL" get-kr --id "$kr_id" | jq -er '.data.version')"
  [[ "$before_version" == "$after_version" ]] || fail "progress CRUD changed stable KR version: $before_version -> $after_version"
  echo "verified: progress CAS returns 409 for stale writes; stable KR version remains $after_version"
}

run_report_c() {
  require_server
  require_fixture
  if jq -e '.report_c_task_id != null' "$FIXTURE_PATH" >/dev/null; then
    fail "Report C Task already exists in fixture"
  fi
  local response task_id
  response="$(api_write POST /api/tasks "$(jq -cn '{
    title:"OKR E2E：生成双周会 Report C",
    action_type:"agent_task",
    target:"读取 okr-agent-orchestrator Skill 与 okr_agent_report_c Prompt，基于隔离数据中的 2026-W35 和 2026-W36 生成内部双周会草稿；不得创建外部文档或发送消息。",
    background:{module:"biz-okr",skill:"okr-agent-orchestrator",prompt_key:"okr_agent_report_c",quarter:"2026-Q3",weeks:["2026-W35","2026-W36"]},
    source_payload:{module:"biz-okr",skill:"okr-agent-orchestrator",prompt_key:"okr_agent_report_c",quarter:"2026-Q3",weeks:["2026-W35","2026-W36"],acceptance:"必须引用两个不同周次，effects 为空"},
    source_type:"manual"
  }')" | require_code_zero)"
  task_id="$(jq -er '.data.id' <<<"$response")"
  jq --argjson task_id "$task_id" '. + {report_c_task_id:$task_id}' "$FIXTURE_PATH" >"$FIXTURE_PATH.next"
  mv "$FIXTURE_PATH.next" "$FIXTURE_PATH"
  echo "$task_id"
}

verify_agents() {
  require_server
  require_fixture
  local reminder_task_id report_c_task_id reminder report_c
  reminder_task_id="$(jq -er '.reminder_task_id' "$FIXTURE_PATH")"
  report_c_task_id="$(jq -er '.report_c_task_id' "$FIXTURE_PATH")"
  reminder="$(curl --fail --silent --show-error "$BASE_URL/api/tasks/$reminder_task_id")"
  report_c="$(curl --fail --silent --show-error "$BASE_URL/api/tasks/$report_c_task_id")"
  jq -e '
    .data.status=="done"
    and .data.execution_result.outcome=="completed"
    and ([.data.execution_result.effects[] | select(.kind=="feishu_message")]|length)==1
    and (.data.execution_result.summary | contains("2026-W36"))
  ' <<<"$reminder" >/dev/null || fail "reminder Agent Task assertion failed"
  jq -e '
    .data.status=="done"
    and .data.execution_result.outcome=="completed"
    and (.data.execution_result.summary | contains("2026-W35"))
    and (.data.execution_result.summary | contains("2026-W36"))
    and ((.data.execution_result.effects // [])|length)==0
  ' <<<"$report_c" >/dev/null || fail "Report C Agent Task assertion failed"
  echo "verified: reminder has one Feishu effect; Report C uses W35/W36 and has no effects"
}

status() {
  require_server
  echo "health: $(curl --fail --silent --show-error "$BASE_URL/healthz" | jq -c .)"
  echo "okr scope: $(curl --fail --silent --show-error "$BASE_URL/api/okr/scope" | jq -c .)"
  echo "Biz OKR scope: $(curl --fail --silent --show-error "$BASE_URL/api/biz-okr/scope" | jq -c .)"
  if [[ -s "$FIXTURE_PATH" ]]; then
    echo "fixture: $(jq -c . "$FIXTURE_PATH")"
    if jq -e '.reminder_task_id != null' "$FIXTURE_PATH" >/dev/null; then
      local reminder_task_id
      reminder_task_id="$(jq -er '.reminder_task_id' "$FIXTURE_PATH")"
      echo "reminder task: $(curl --fail --silent --show-error "$BASE_URL/api/tasks/$reminder_task_id" | jq -c '.data | {id,status,version,title,summary:.execution_result.summary,effects:(.execution_result.effects // [])}')"
    fi
    if jq -e '.report_c_task_id != null' "$FIXTURE_PATH" >/dev/null; then
      local task_id
      task_id="$(jq -er '.report_c_task_id' "$FIXTURE_PATH")"
      echo "report C task: $(curl --fail --silent --show-error "$BASE_URL/api/tasks/$task_id" | jq -c '.data | {id,status,version,title,summary:.execution_result.summary,effects:(.execution_result.effects // [])}')"
    fi
  fi
}

COMMAND="${1:-}"
case "$COMMAND" in
  prepare) prepare ;;
  build) build_server ;;
  serve) serve ;;
  seed) seed ;;
  verify-empty) verify_empty ;;
  run-reminder) run_reminder ;;
  fill) fill_current ;;
  verify-filled) verify_filled ;;
  verify-world) verify_world ;;
  cas) cas_test ;;
  run-report-c) run_report_c ;;
  verify-agents) verify_agents ;;
  status) status ;;
  --help|-h|help|"") usage ;;
  *) usage >&2; fail "unknown command: $COMMAND" ;;
esac
