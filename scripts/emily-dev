#!/usr/bin/python3
"""Run this checkout independently while mounting one complete OKR directory."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
from urllib.parse import urlsplit

import yaml

ROOT = Path(__file__).resolve().parent.parent
def run(args, **kwargs):
    return subprocess.run([str(x) for x in args], check=True, **kwargs)


def output(args):
    return subprocess.check_output([str(x) for x in args], text=True).strip()


def resolve_git_common_dir(root):
    common = Path(output(['git', '-C', root, 'rev-parse', '--git-common-dir']))
    if not common.is_absolute():
        common = (root/common).resolve()
    if not common.is_dir():
        raise ValueError(f'git common directory does not exist: {common}')
    return common


def initialize(root, public_url, principal):
    """Fresh local config only. Never import another instance's overrides."""
    paths = [root/'conf'/name for name in (
        'config.runtime.yaml', 'okr-module.runtime.yaml')]
    if any(p.exists() for p in paths):
        raise ValueError('local config already exists; back it up before initialization')
    if not principal:
        raise ValueError('--principal is required to initialize the browser login gate')
    base = yaml.safe_load((root/'conf/config.yaml').read_text())
    config = {
        'identity': {'display_name': 'Emily 开发'},
        'auth': {
            'enabled': True,
            'principals': [principal],
            'login_api_base_url': 'https://cloud.byteintl.net',
        },
        'server': {'addr': '127.0.0.1:18812', 'public_base_url': public_url},
    }
    for key in ('capture', 'factengine', 'extract', 'execute', 'proactive',
                'meeting_sweep', 'morning_brief', 'dailydigest', 'scheduled_task', 'card_approval'):
        config[key] = {'enabled': False}
    for key in ('codex', 'execute', 'factengine', 'proactive', 'meeting_sweep', 'morning_brief'):
        config.setdefault(key, {}).update(bin='codex', model=base['chat']['model'])
    config['execute'].update(repo_root='/opt/jarvis', runs_dir='var/runs')
    config['dailydigest']['git_author'] = 'Emily development'
    module = {
        'chat': {'enabled': True, 'runtime': 'local'},
        'identity': {'token_dir': '/dev-state/tokens'},
        'preview_review': {'bin': 'codex', 'model': base['chat']['model']},
    }
    for path, value in zip(paths, (config, module)):
        with path.open('x') as file:
            os.chmod(path, 0o600)
            yaml.safe_dump(value, file, allow_unicode=True, sort_keys=False)


def validate_okr_dir(directory):
    if not directory.is_dir() or not (directory/'okr.db').is_file():
        raise ValueError('shared OKR directory must contain okr.db')


def container_args(root, shared, state, ingress, lark, byted, goroot,
                   env_file=None, git_common=None):
    args = ['docker', 'run', '-d', '--init', '--restart', 'unless-stopped',
            '--name', 'emily-development', '--network', 'bridge',
            '--cap-drop', 'ALL', '--security-opt', 'no-new-privileges',
            '--pids-limit', '1024', '--memory', '6g', '--cpus', '4',
            '--user', f'{os.getuid()}:{os.getgid()}']
    if env_file:
        args += ['--env-file', str(env_file)]

    def mount(source, target, readonly=False):
        args.extend(['--mount', f'type=bind,src={source},dst={target}'
                     + (',readonly' if readonly else '')])

    mount(root, '/opt/jarvis')
    if git_common is not None:
        git_common = Path(git_common).resolve()
        try:
            git_common.relative_to(Path(root).resolve())
        except ValueError:
            # Linked worktrees keep their authoritative metadata in the common
            # repository. Mount it at the original absolute path so the
            # existing .git pointer and Git locking semantics remain valid.
            mount(git_common, git_common)
    mount(shared, '/opt/jarvis/data/okr')
    mount(state, '/dev-state')
    mount(ingress, '/run/emily-web')
    mount(goroot, '/opt/go', True)
    mount(lark, '/usr/local/bin/lark-cli', True)
    mount(byted, '/opt/bytedcli', True)
    args.append('emily-development:local')
    return args


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--initialize', action='store_true', help='create fresh instance config, then exit')
    parser.add_argument('--public-url', help='public URL for initialization, e.g. https://example.com/dev/')
    parser.add_argument('--principal', help='development owner email/SSO username for initialization')
    parser.add_argument('--okr-data', type=Path, help='existing shared OKR directory, left intact')
    parser.add_argument('--env-file', type=Path, help='development secrets only; never the main instance environment')
    parser.add_argument('--deploy', action='store_true', help='build/restart this instance after starting the container')
    parser.add_argument('--dry-run', action='store_true', help='validate inputs and print mounts without changing state')
    opts = parser.parse_args()
    if opts.initialize:
        url = urlsplit(opts.public_url or '')
        if url.scheme not in ('http', 'https') or not url.netloc or url.query or url.fragment:
            parser.error('--public-url must be an absolute HTTP(S) URL without query or fragment')
        if opts.dry_run or opts.deploy:
            parser.error('--initialize is separate from --dry-run/--deploy')
        initialize(ROOT, opts.public_url, opts.principal)
        print('Local config created. Configure this instance’s Lark app and authorize its CLIs before deployment.')
        return
    if not opts.okr_data:
        parser.error('--okr-data is required')
    shared = opts.okr_data.resolve()
    validate_okr_dir(shared)
    if not (ROOT/'conf/config.runtime.yaml').is_file():
        raise ValueError('initialize local config first')
    if opts.env_file and not opts.env_file.is_file():
        raise ValueError('development env file does not exist')
    lark = Path(shutil.which('lark-cli') or '').resolve()
    byted_bin = Path(shutil.which('bytedcli') or '').resolve()
    if not lark.is_file() or not byted_bin.is_file():
        raise ValueError('install native lark-cli and bytedcli programs first')
    byted = byted_bin.parent.parent
    if not (byted/'dist/bytedcli.js').is_file():
        raise ValueError('bytedcli must resolve to its installed dist/bytedcli.js')
    state = ROOT/'var/container'
    ingress = Path('/tmp')/f'emily-development-{os.getuid()}'/'ingress'
    git_common = resolve_git_common_dir(ROOT)
    args = container_args(ROOT, shared, state, ingress, lark, byted,
                          Path(output(['go', 'env', 'GOROOT'])),
                          env_file=opts.env_file.resolve() if opts.env_file else None,
                          git_common=git_common)
    if opts.dry_run:
        print('\n'.join(str(arg) for arg in args))
        return
    for directory in (state/'home', state/'go-mod', ingress, ROOT/'var/log'):
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    run(['docker', 'build', '-t', 'emily-development:local', ROOT/'deploy/emily-dev'])
    existing = output(['docker', 'ps', '-aq', '--filter', 'name=^emily-development$'])
    if existing:
        run(['docker', 'stop', '--time', '35', 'emily-development'])
        run(['docker', 'rm', 'emily-development'])
    run(args)
    if opts.deploy:
        run(['docker', 'exec', 'emily-development', './scripts/jarvis-deploy', '--skip-pull'])
    print('Instance ingress socket:', ingress/'web.sock')
    print('Authorize CLIs inside the container. Main instance config and credentials were not read or changed.')


if __name__ == '__main__':
    main()
