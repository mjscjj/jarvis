#!/usr/bin/env python3
"""Issue one short OKR browser session from an existing, live-verified Feishu grant.

This bridges a saved user grant into an isolated test browser. It does not test
the product's device-login flow and never prints access tokens or cookies.
"""
import base64
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import secrets
import sqlite3
import sys
import tempfile
import urllib.request
from urllib.parse import urlsplit


OPEN_ID = os.environ.get("OKR_REAL_EXPECTED_OPEN_ID", "")
NAME = os.environ.get("OKR_REAL_EXPECTED_NAME", "")
TOKEN_PATH = Path(os.environ.get("OKR_REAL_TOKEN_FILE", ""))
DB_PATH = Path(os.environ.get("OKR_REAL_IDENTITY_DB", ""))
COOKIE_NAME = os.environ.get("OKR_REAL_COOKIE_NAME", "jarvis_okr_session")


def validate_target():
    if not OPEN_ID or not NAME or not TOKEN_PATH.is_file() or not DB_PATH.is_file():
        raise RuntimeError("Set OKR_REAL_EXPECTED_OPEN_ID, OKR_REAL_EXPECTED_NAME, OKR_REAL_TOKEN_FILE and OKR_REAL_IDENTITY_DB for the tested instance")
    target = urlsplit(os.environ.get("OKR_REAL_BASE_URL", ""))
    if target.scheme not in ("http", "https") or not target.netloc:
        raise RuntimeError("Set OKR_REAL_BASE_URL to the tested instance")
    if target.path.strip("/") and not os.environ.get("OKR_REAL_COOKIE_NAME"):
        raise RuntimeError("Set OKR_REAL_COOKIE_NAME to the prefixed instance's actual cookie name")


def main():
    validate_target()
    grant = json.loads(TOKEN_PATH.read_text())
    if grant.get("open_id") != OPEN_ID or grant.get("name") != NAME:
        raise RuntimeError("Saved grant is not the expected tester")
    expiry = dt.datetime.fromisoformat(grant["expires_at"].replace("Z", "+00:00"))
    if expiry <= dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=3):
        raise RuntimeError("Existing Feishu access token has expired; refresh via the product before testing")
    request = urllib.request.Request(
        "https://open.feishu.cn/open-apis/authen/v1/user_info",
        headers={"Authorization": "Bearer " + grant["access_token"]},
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        user_response = json.load(response)
    user = user_response.get("data") or {}
    if user_response.get("code") != 0 or user.get("open_id") != OPEN_ID or user.get("union_id") != grant.get("union_id") or user.get("name") != NAME:
        raise RuntimeError("Live Feishu identity does not match the saved tester grant")

    now = dt.datetime.now(dt.timezone.utc)
    expires = now + dt.timedelta(minutes=45)
    cookie = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode()
    token_hash = hashlib.sha256(cookie.encode()).hexdigest()
    conn = sqlite3.connect(DB_PATH, timeout=15)
    try:
        conn.execute(
            """INSERT INTO okr_workspace_auth_session
            (token_hash,open_id,union_id,name,avatar_url,email,expires_at,created_at,last_seen_at)
            VALUES (?,?,?,?,?,?,?,?,?)""",
            (token_hash, OPEN_ID, user["union_id"], NAME, user.get("avatar_url") or "", user.get("email") or "", expires.isoformat(), now.isoformat(), now.isoformat()),
        )
        conn.commit()
    finally:
        conn.close()
    fd, output = tempfile.mkstemp(prefix="okr-real-session-", suffix=".json")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as handle:
            json.dump({"cookie": cookie, "cookie_name": COOKIE_NAME, "token_hash": token_hash, "open_id": OPEN_ID, "expires_at": expires.isoformat()}, handle)
        base_url = os.environ.get("OKR_REAL_BASE_URL", "").rstrip("/")
        if base_url:
            request = urllib.request.Request(
                base_url + "/api/biz-okr/me",
                headers={"Cookie": COOKIE_NAME + "=" + cookie},
            )
            with urllib.request.urlopen(request, timeout=10) as response:
                current = json.load(response)
            if current.get("data", {}).get("user", {}).get("open_id") != OPEN_ID or not current.get("data", {}).get("authenticated"):
                raise RuntimeError("Target OKR service did not recognize the verified short session")
    except Exception:
        Path(output).unlink(missing_ok=True)
        with sqlite3.connect(DB_PATH, timeout=15) as cleanup:
            cleanup.execute("DELETE FROM okr_workspace_auth_session WHERE token_hash = ?", (token_hash,))
        raise
    print(output)


def revoke(path):
    validate_target()
    session_path = Path(path)
    if not session_path.exists():
        return
    session = json.loads(session_path.read_text())
    if session.get("open_id") != OPEN_ID or not session.get("token_hash"):
        raise RuntimeError("Refusing to revoke a session file for another identity")
    with sqlite3.connect(DB_PATH, timeout=15) as conn:
        conn.execute("DELETE FROM okr_workspace_auth_session WHERE token_hash = ?", (session["token_hash"],))
    session_path.unlink()


if __name__ == "__main__":
    try:
        if len(sys.argv) == 3 and sys.argv[1] == "--revoke":
            revoke(sys.argv[2])
        elif len(sys.argv) == 1:
            main()
        else:
            raise RuntimeError("usage: okr-real-test-session [--revoke <session-file>]")
    except Exception as error:
        print(f"Cannot issue verified tester session: {error}", file=sys.stderr)
        sys.exit(1)
